  {
   "type": "text",
   "id": "e82",
   "x": 40,
   "y": 814,
   "width": 1300,
   "height": 37.5,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 618979931,
   "version": 1,
   "versionNonce": 438892468,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "128 free-running pairs, no host sync; one all-reduce at chain start; op-edge events only (4/pair). Cross-rank MIN per op = chain_floor_us.\nThe last rank into a collective waited least, so its window is the op's floor. Chained per-op medians are never published.",
   "originalText": "128 free-running pairs, no host sync; one all-reduce at chain start; op-edge events only (4/pair). Cross-rank MIN per op = chain_floor_us.\nThe last rank into a collective waited least, so its window is the op's floor. Chained per-op medians are never published.",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
