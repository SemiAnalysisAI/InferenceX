   "versionNonce": 665,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "2. stage: eager FP8 rows only",
   "originalText": "2. stage: eager FP8 rows only",
