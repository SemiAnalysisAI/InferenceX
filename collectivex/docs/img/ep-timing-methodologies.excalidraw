   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Replaces both old panels 1 and 2: there is no drained, re-staggered entry and no separate 'aligned entry' family any more; every fresh-entry sample is aligned.",
   "originalText": "Replaces both old panels 1 and 2: there is no drained, re-staggered entry and no separate 'aligned entry' family any more; every fresh-entry sample is aligned.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
