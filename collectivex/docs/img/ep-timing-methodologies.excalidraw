   "versionNonce": 672,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The harness dequantizes the received FP8 to BF16 for combine, standing in for the expert GEMM. Hoisted out of roundtrip and both chains; never add it to a total.",
   "originalText": "The harness dequantizes the received FP8 to BF16 for combine, standing in for the expert GEMM. Hoisted out of roundtrip and both chains; never add it to a total.",
