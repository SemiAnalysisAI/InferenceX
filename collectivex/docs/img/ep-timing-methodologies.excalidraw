  {
   "id": "e94",
   "type": "text",
   "x": 40,
   "y": 453.25,
   "width": 1080.1648933410643,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 4478,
   "version": 1,
   "versionNonce": 658,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "combine includes vLLM's copy into the layer output. 256 trials \u00d7 8 samples per point; a sample is a miss when a host enqueues slower than the spin.",
   "originalText": "combine includes vLLM's copy into the layer output. 256 trials \u00d7 8 samples per point; a sample is a miss when a host enqueues slower than the spin.",
   "fontSize": 15,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 13.5,
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "e95",
   "type": "text",
   "x": 40,
   "y": 503.25,
   "width": 324.3459771728516,
   "height": 27.5,
