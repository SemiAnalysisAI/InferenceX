   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "CUDA-graph launched, one dispatch/combine pair per MoE layer. Expert GEMMs sit between dispatch and combine and attention between layers,\nso the engine can overlap communication with compute. CollectiveX runs no compute: pair_period is the communication-only steady state.",
   "originalText": "CUDA-graph launched, one dispatch/combine pair per MoE layer. Expert GEMMs sit between dispatch and combine and attention between layers,\nso the engine can overlap communication with compute. CollectiveX runs no compute: pair_period is the communication-only steady state.",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
