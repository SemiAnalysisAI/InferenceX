   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "5. Chain PERIOD \u2014 second sibling chain \u2192 pair_period (the headline)",
   "originalText": "5. Chain PERIOD \u2014 second sibling chain \u2192 pair_period (the headline)",
   "fontSize": 24,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "type": "text",
   "id": "e111",
   "x": 40,
   "y": 994,
   "width": 1300,
   "height": 37.5,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1700113407,
   "version": 1,
   "versionNonce": 1989259376,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Outer events only (2/pair); the host's record() cost lands in the gap, outside the window. Cross-rank MEDIAN = pair_period (a rate: the\ncollectives phase-lock the ranks). interpair_gap_us = start-to-start \u2212 pair window. No stage inside the pair: it is hoisted.",
   "originalText": "Outer events only (2/pair); the host's record() cost lands in the gap, outside the window. Cross-rank MEDIAN = pair_period (a rate: the\ncollectives phase-lock the ranks). interpair_gap_us = start-to-start \u2212 pair window. No stage inside the pair: it is hoisted.",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
