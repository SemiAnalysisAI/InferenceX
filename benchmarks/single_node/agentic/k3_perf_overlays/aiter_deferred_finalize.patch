+template <typename T, int NGPUS, bool GEMMA_NORM = false>
+void route_reduce_allreduce_rmsnorm_kernel_1stage_launcher(RankData* _dp,
+                                                           RankSignals sg,
+                                                           Signal* self_sg,
+                                                           int rank,
+                                                           T* output,
+                                                           T* weight,
+                                                           int token_num,
+                                                           int topk,
+                                                           int hidden_dim,
+                                                           float eps,
+                                                           hipStream_t stream)
+{
+    constexpr int PACK_SIZE = 16 / sizeof(T);
+    constexpr int WARP_SIZE = 32;
+    int block_size          = hidden_dim / PACK_SIZE;
+    if(block_size > 1024)
+        throw std::runtime_error(
+            "route-reduce fused allreduce rmsnorm requires hidden_dim/pack_size <= 1024");
+    int launch_threads = ((block_size + WARP_SIZE - 1) / WARP_SIZE) * WARP_SIZE;
+    dim3 threads_per_block(launch_threads);
+    dim3 num_blocks(std::min(token_num, kMaxBlocks));
+    route_reduce_allreduce_rmsnorm_kernel_1stage<T, NGPUS, GEMMA_NORM>
+        <<<num_blocks, threads_per_block, 0, stream>>>(
+            _dp, sg, self_sg, rank, output, weight, token_num, topk, hidden_dim, eps);
+}
