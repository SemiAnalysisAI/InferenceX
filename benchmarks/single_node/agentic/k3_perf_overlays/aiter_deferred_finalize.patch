+template <typename T, int ngpus, bool GEMMA_NORM = false>
+__global__ void __launch_bounds__(1024, 1)
+    route_reduce_allreduce_rmsnorm_kernel_1stage(RankData* _dp,
+                                                 RankSignals sg,
+                                                 Signal* self_sg,
+                                                 int rank,
+                                                 T* __restrict__ output,
+                                                 T* __restrict__ weight,
+                                                 int token_num,
+                                                 int topk,
+                                                 int hidden_dim,
+                                                 float eps)
+{
+    constexpr int pack_size = 16 / sizeof(T);
+    using P                 = typename opus::vector_t<T, pack_size>;
+    using A                 = typename opus::vector_t<opus::fp32_t, pack_size>;
+
+    int block_size         = hidden_dim / pack_size;
+    bool active            = (int)threadIdx.x < block_size;
+    int access_id_in_token = threadIdx.x * pack_size;
+    const P* ptrs[ngpus];
+#pragma unroll
+    for(int i = 0; i < ngpus; ++i)
+        ptrs[i] = reinterpret_cast<const P*>(_dp->ptrs[i]);
+
+    start_sync<ngpus>(sg, self_sg, rank);
+    for(int tidx = blockIdx.x; tidx < token_num; tidx += gridDim.x)
+    {
+        A acc{};
+        P weight_p{};
+        if(active)
+        {
+#pragma unroll
+            for(int r = 0; r < ngpus; ++r)
+            {
+                A local_acc{};
+                for(int slot = 0; slot < topk; ++slot)
+                {
+                    int input_idx =
+                        ((tidx * topk + slot) * hidden_dim + access_id_in_token) / pack_size;
+                    P route = ptrs[r][input_idx];
+#pragma unroll
+                    for(int v = 0; v < pack_size; ++v)
+                        local_acc[v] += upcast_s(route[v]);
+                }
+
+                // The unfused path rounds each rank's top-k reduction to the
+                // activation dtype before the tensor-parallel all-reduce.
+#pragma unroll
+                for(int v = 0; v < pack_size; ++v)
+                    acc[v] += upcast_s(downcast_s<T>(local_acc[v]));
+            }
+
+            // Match the all-reduce output's activation-dtype rounding point
+            // before applying RMSNorm.
+#pragma unroll
+            for(int v = 0; v < pack_size; ++v)
+                acc[v] = upcast_s(downcast_s<T>(acc[v]));
+
+            weight_p = *reinterpret_cast<P*>(weight + access_id_in_token);
+        }
+
+        int out_idx = tidx * hidden_dim + access_id_in_token;
+        ar_fusion_epilogue<P, A, T, T, pack_size, GEMMA_NORM>(acc,
+                                                              weight_p,
+                                                              hidden_dim,
+                                                              eps,
+                                                              out_idx,
+                                                              tidx,
+                                                              (int)blockDim.x,
+                                                              output,
+                                                              nullptr,
+                                                              active,
+                                                              nullptr);
+    }
+}
