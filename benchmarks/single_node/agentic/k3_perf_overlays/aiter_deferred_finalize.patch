+template <typename T>
+void dispatchFusedRouteReduceAllReduceRMSNorm(hipStream_t stream,
+                                              T* input,
+                                              T* output,
+                                              T* weight,
+                                              float eps,
+                                              int token_num,
+                                              int topk,
+                                              int hidden_dim,
+                                              bool gemma_norm = false)
+{
+    constexpr int pack_size = 16 / sizeof(T);
+    if(hidden_dim % pack_size != 0)
+        throw std::runtime_error(
+            "route-reduce fused allreduce rmsnorm requires hidden_dim divisible by pack_size");
+    if(token_num <= 0 || topk <= 0)
+        throw std::runtime_error(
+            "route-reduce fused allreduce rmsnorm requires positive token_num and topk");
+
+    RankData* ptrs = get_buffer_RD(stream, input);
+
+#define DISPATCH_ROUTE_REDUCE_AR_RMS(NGPUS, GEMMA_NORM)                          \
+    route_reduce_allreduce_rmsnorm_kernel_1stage_launcher<T, NGPUS, GEMMA_NORM>( \
+        ptrs, sg_, self_sg_, rank_, output, weight, token_num, topk, hidden_dim, eps, stream)
+
+    switch(world_size_)
+    {
+    case 8:
+        if(gemma_norm)
+            DISPATCH_ROUTE_REDUCE_AR_RMS(8, true);
+        else
+            DISPATCH_ROUTE_REDUCE_AR_RMS(8, false);
+        break;
+    case 4:
+        if(gemma_norm)
+            DISPATCH_ROUTE_REDUCE_AR_RMS(4, true);
+        else
+            DISPATCH_ROUTE_REDUCE_AR_RMS(4, false);
+        break;
+    case 2:
+        if(gemma_norm)
+            DISPATCH_ROUTE_REDUCE_AR_RMS(2, true);
+        else
+            DISPATCH_ROUTE_REDUCE_AR_RMS(2, false);
+        break;
+    default:
+        throw std::runtime_error("route-reduce fused allreduce rmsnorm: unsupported world_size=" +
+                                 std::to_string(world_size_));
+    }
+
+#undef DISPATCH_ROUTE_REDUCE_AR_RMS
+}
