+
+        if not nvl_multicast_supported():
+            logger.info_once(
+                "moonep is installed but this device does not support CUDA "
+                "multicast (NVSwitch). The moonep backend will not be available."
+            )
+            return False
+    except Exception:
+        return False
+    return True
