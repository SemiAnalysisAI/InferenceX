+def _aiter_fused_allreduce_gemma_rms_norm(
+    hidden_states: torch.Tensor,
+    residual: torch.Tensor,
+    norm: MiniMAXGemmaRMSNorm,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Fuse TP all-reduce, residual add, and Gemma RMSNorm on ROCm.
+
+    The generic eager helper uses FlashInfer on NVIDIA and otherwise falls back
+    to separate all-reduce and norm launches. AITER's custom all-reduce exposes
+    the same Gemma ``weight + 1`` mode, so use it for the MiniMax-M3 ROCm path
+    when explicitly enabled. The fallback preserves the existing behavior for
+    unsupported shapes, transports, and deployments with an older AITER build.
+    """
+    tp_size = get_tensor_model_parallel_world_size()
+    if tp_size == 1:
+        return norm(hidden_states, residual)
+
+    if os.getenv("VLLM_MINIMAX_M3_AITER_FUSED_AR_GEMMA", "0") == "1":
+        aiter_ar = rocm_aiter_ops.get_aiter_allreduce()
+        if aiter_ar is not None:
+            hidden_dim = hidden_states.shape[-1]
+            supported_hidden_dim = bool(
+                aiter_ar.supports_dynamic_hidden_dim
+                or hidden_dim in (512, 1024, 2048, 4096)
+            )
+            supported_layout = bool(
+                hidden_states.dim() == 2
+                and hidden_states.is_contiguous()
+                and residual.shape == hidden_states.shape
+                and residual.is_contiguous()
+                and hidden_states.dtype in (torch.bfloat16, torch.float16)
+                and norm.weight.dtype == hidden_states.dtype
+            )
+            if supported_hidden_dim and supported_layout:
+                ca = aiter_ar.aiter_ca
+                total_bytes = hidden_states.numel() * hidden_states.element_size()
+                token_num = hidden_states.numel() // hidden_dim
+                pack_size = 16 // hidden_states.element_size()
+                hidden_ok = (
+                    hidden_dim % pack_size == 0 and hidden_dim // pack_size <= 1024
+                )
+                if ca.world_size == 2:
+                    size_ok = True
+                elif ca.fully_connected and ca.world_size <= 4:
+                    size_ok = total_bytes < 256 * 1024
+                elif ca.fully_connected and ca.world_size <= 8:
