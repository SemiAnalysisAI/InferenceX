@@ -0,0 +1,100 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Small-token BF16 activation x FP32 router-weight GEMM for ROCm.
+
+MiniMax-M3 keeps its router weights and logits in FP32. The generic ROCm
+fallback first materializes an FP32 copy of every hidden state and then calls a
+general GEMM. AgentX decode uses only a few tokens at a time, so a persistent
+expert-column program can convert BF16 activations in registers and avoid that
+extra launch and global-memory round trip.
+"""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _fp32_router_gemm_kernel(
+    x_ptr,
+    weight_ptr,
+    out_ptr,
+    stride_xm: tl.constexpr,
+    stride_xk: tl.constexpr,
+    stride_wn: tl.constexpr,
+    stride_wk: tl.constexpr,
+    stride_om: tl.constexpr,
+    stride_on: tl.constexpr,
+    M: tl.constexpr,
+    K: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_K: tl.constexpr,
+):
+    expert = tl.program_id(0)
+    offsets_m = tl.arange(0, BLOCK_M)
+    offsets_k = tl.arange(0, BLOCK_K)
+    accumulator = tl.zeros((BLOCK_M,), dtype=tl.float32)
+
+    for k_start in tl.static_range(0, K, BLOCK_K):
+        k = k_start + offsets_k
+        weight = tl.load(
+            weight_ptr + expert * stride_wn + k * stride_wk,
+            mask=k < K,
+            other=0.0,
+        )
+        x = tl.load(
+            x_ptr
+            + offsets_m[:, None] * stride_xm
+            + k[None, :] * stride_xk,
+            mask=(offsets_m[:, None] < M) & (k[None, :] < K),
+            other=0.0,
+        )
+        accumulator += tl.sum(x.to(tl.float32) * weight[None, :], axis=1)
+
+    tl.store(
+        out_ptr + offsets_m * stride_om + expert * stride_on,
+        accumulator,
+        mask=offsets_m < M,
+    )
+
+
+def fp32_router_gemm(hidden_states: torch.Tensor, weight: torch.Tensor) -> torch.Tensor:
+    """Compute ``hidden_states @ weight.T`` with FP32 output for M <= 32."""
+    if hidden_states.ndim != 2 or weight.ndim != 2:
+        raise ValueError("router GEMM expects two rank-2 tensors")
+    if hidden_states.dtype != torch.bfloat16 or weight.dtype != torch.float32:
+        raise ValueError("router GEMM expects BF16 activations and FP32 weights")
+    if not hidden_states.is_cuda or not weight.is_cuda:
+        raise ValueError("router GEMM expects accelerator tensors")
+    if not hidden_states.is_contiguous() or not weight.is_contiguous():
+        raise ValueError("router GEMM expects contiguous tensors")
+
+    num_tokens, hidden_size = hidden_states.shape
+    num_experts, weight_hidden_size = weight.shape
+    if hidden_size != weight_hidden_size:
+        raise ValueError("activation and weight hidden dimensions must match")
+    if not 0 < num_tokens <= 32:
+        raise ValueError("router GEMM supports between 1 and 32 tokens")
+
+    output = torch.empty(
+        (num_tokens, num_experts), dtype=torch.float32, device=hidden_states.device
+    )
+    block_m = triton.next_power_of_2(num_tokens)
+    block_k = 256
+    _fp32_router_gemm_kernel[(num_experts,)](
+        hidden_states,
+        weight,
+        output,
+        hidden_states.stride(0),
+        hidden_states.stride(1),
+        weight.stride(0),
+        weight.stride(1),
+        output.stride(0),
+        output.stride(1),
+        M=num_tokens,
+        K=hidden_size,
+        BLOCK_M=block_m,
+        BLOCK_K=block_k,
+        num_warps=8,
+    )
+    return output
