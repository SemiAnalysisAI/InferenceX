+def _warmup_aiter_sparse_paged_attention(worker: "Worker") -> None:
+    """Compile the late AgentX sparse-prefill Gluon specialization.
+
+    The MiniMax-M3 sparse attend bypasses unified attention and calls AITER's
+    ``pa_decode_gluon`` directly. AgentX C1 jobs 944 and 956 both reached a new
+    one-shot specialization about eleven minutes into profiling on resumed
+    branch prefills of 820 and 818 tokens, respectively. Use one loaded sparse
+    layer's production KV-cache view and scalar scales, while synthesizing only
+    the query and emitted sparse page-table rows.
+    """
+    from vllm.models.minimax_m3.amd.model import (
+        MiniMaxM3SparseAttention as MiniMaxM3SparseAttentionAmd,
+    )
+
+    sparse_module = next(
+        (
+            module
+            for module in worker.get_model().modules()
+            if isinstance(module, MiniMaxM3SparseAttentionAmd)
+            and getattr(module, "use_aiter_sparse_pa", False)
+            and not getattr(module, "use_aiter_asm_sparse_pa", False)
+        ),
+        None,
+    )
+    if sparse_module is None:
+        return
+
+    from vllm.models.minimax_m3.amd.ops.sparse_pa import (
+        PAGES_PER_SPARSE_BLOCK,
+        _run_gluon_decode,
+    )
+
+    key_cache, value_cache = sparse_module.get_aiter_sparse_pa_kv_cache()
+    num_query_heads = int(sparse_module.num_heads)
+    num_kv_heads = int(sparse_module.num_kv_heads)
+    head_size = int(sparse_module.head_dim)
+    topk_blocks = int(sparse_module.impl.topk_blocks)
+    sparse_table_width = topk_blocks * PAGES_PER_SPARSE_BLOCK
+    sparse_context = topk_blocks * int(sparse_module.impl.block_size)
+    k_scale = getattr(sparse_module, "_k_scale", None)
+    v_scale = getattr(sparse_module, "_v_scale", None)
+    device = worker.device
+    # ``32`` covers the multi-request sparse-decode configuration used at the
+    # start of C32 profiling (max_context_partition_num=8). The larger cases
+    # retain coverage for the resumed sparse-prefill shapes seen in C1.
+    cases = (32, 818, 820)
+    # Production reuses one persistent context-length buffer for decode and
+    # prefill.  In a mixed batch the prefill view starts at ``num_decode_tokens``
+    # int32 elements, so its pointer can be 4-, 8-, 12-, or 16-byte aligned.
+    # Triton specializes the Gluon kernel on that pointer alignment.  Warming
+    # only a fresh, naturally aligned tensor therefore misses the exact C1
+    # ``sparse_ctx_buffer[1:]`` specialization and causes a late compile.
+    context_offsets = (0, 1, 2, 3)
+
+    logger.info(
+        "Warming MiniMax M3 AITER sparse paged-attention prefills %s with "
+        "int32 context offsets %s twice.",
+        cases,
+        context_offsets,
+    )
+    for _ in range(2):
+        for num_tokens in cases:
+            query = torch.zeros(
+                (num_tokens, num_query_heads, head_size),
+                dtype=torch.bfloat16,
+                device=device,
+            )
+            output = torch.empty_like(query)
+            sparse_bt = torch.zeros(
+                (num_tokens, sparse_table_width),
+                dtype=torch.int32,
+                device=device,
+            )
+            for context_offset in context_offsets:
+                sparse_ctx_storage = torch.full(
+                    (num_tokens + context_offset,),
+                    sparse_context,
+                    dtype=torch.int32,
+                    device=device,
+                )
+                sparse_ctx = sparse_ctx_storage[
+                    context_offset : context_offset + num_tokens
+                ]
+                _run_gluon_decode(
+                    query,
+                    key_cache,
+                    value_cache,
+                    sparse_bt,
+                    sparse_ctx,
+                    num_kv_heads,
+                    head_size**-0.5,
+                    output,
+                    k_scale,
+                    v_scale,
+                )
+    torch.cuda.synchronize(device)
+
