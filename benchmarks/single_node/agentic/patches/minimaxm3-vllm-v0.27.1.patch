+def _draft_bf16_projection_weights(worker: "Worker") -> tuple[torch.Tensor, ...]:
+    """Return one real local-shard weight for each drafter GEMM shape."""
+    draft_model = worker.model_runner.get_draft_model()
+    if draft_model is None:
+        return ()
+
+    projection_suffixes = (
+        "fc.weight",
+        "qkv_proj.weight",
+        "o_proj.weight",
+        "gate_up_proj.weight",
+        "down_proj.weight",
+    )
+    weights_by_shape: dict[tuple[int, int], torch.Tensor] = {}
+    names_by_shape: dict[tuple[int, int], str] = {}
+    for name, parameter in draft_model.named_parameters():
+        if not name.endswith(projection_suffixes):
+            continue
+        if (
+            parameter.ndim != 2
+            or parameter.dtype != torch.bfloat16
+            or not parameter.is_cuda
+            or not parameter.is_contiguous()
+        ):
+            continue
+        shape = (int(parameter.shape[0]), int(parameter.shape[1]))
+        weights_by_shape.setdefault(shape, parameter)
+        names_by_shape.setdefault(shape, name)
+
+    logger.info(
+        "MiniMax M3 AgentX drafter BF16 GEMM warmup shapes: %s",
+        tuple((names_by_shape[shape], shape) for shape in sorted(weights_by_shape)),
+    )
+    return tuple(weights_by_shape[shape] for shape in sorted(weights_by_shape))
+
+
+def _warmup_rocm_agentx_dynamic_kernels(worker: "Worker") -> None:
+    """Warm runtime-only MiniMax-M3 AgentX specializations in each worker.
+
+    A standalone cache-population process avoids native compiler builds, but
+    Triton still initializes each specialization in the serving process. The
+    AgentX trajectory handoff and long resumed prefills expose four families
+    after the normal vLLM and AIPerf warmups: EAGLE metadata, AITER unified
+    attention, draft BF16 GEMM, and native top-k/top-p sampling. Keep this
+    opt-in while the reachable-shape set is validated against the production
+    trace.
+    """
+    if os.getenv("VLLM_MINIMAX_M3_AGENTX_JIT_WARMUP", "0") != "1":
+        return
+    if not current_platform.is_rocm():
+        return
+    if not {
+        "MiniMaxM3SparseForCausalLM",
+        "MiniMaxM3SparseForConditionalGeneration",
+    }.intersection(worker.model_config.architectures):
+        return
+
+    from aiter.ops.triton.gemm.basic.gemm_a16w16 import gemm_a16w16
+    from vllm.v1.sample.ops.topk_topp_triton import apply_top_k_top_p_triton
+    from vllm.v1.spec_decode.utils import (
+        eagle_prepare_inputs_padded_kernel,
+        eagle_prepare_next_token_padded_kernel,
+        eagle_step_slot_mapping_metadata_kernel,
+    )
+
+    logger.info("Warming MiniMax M3 ROCm AgentX dynamic kernels in-process.")
+    device = worker.device
+    max_model_len = worker.model_config.max_model_len
+    block_size = worker.cache_config.block_size
+    n_blocks_per_req = math.ceil(max_model_len / block_size)
+    speculative_config = worker.vllm_config.speculative_config
+    batch_sizes = (1, 2, 4, 8, 16, 32, 64, 128, 256)
+
+    _warmup_aiter_unified_attention(worker)
+    _warmup_aiter_sparse_paged_attention(worker)
+
+    # Target-only correctness controls deliberately omit speculative decoding.
+    # They still benefit from the target-attention warmup above, but there are
+    # no EAGLE metadata or drafter GEMMs to specialize in that configuration.
+    if speculative_config is None:
+        torch.cuda.synchronize(device)
+        logger.info(
+            "Skipping MiniMax M3 EAGLE and drafter warmup because "
+            "speculative decoding is disabled."
+        )
+        return
+
+    num_spec_sampled_tokens = int(speculative_config.num_speculative_tokens) + 1
+
+    for num_reqs in batch_sizes:
+        cu_draft = torch.arange(
+            num_spec_sampled_tokens,
+            (num_reqs + 1) * num_spec_sampled_tokens,
+            num_spec_sampled_tokens,
+            dtype=torch.int32,
+            device=device,
+        )
+        valid = torch.ones(num_reqs, dtype=torch.int32, device=device)
+        query_start = torch.arange(
+            0,
+            (num_reqs + 1) * num_spec_sampled_tokens,
+            num_spec_sampled_tokens,
+            dtype=torch.int32,
+            device=device,
+        )
+        out_indices = torch.empty(num_reqs, dtype=torch.int32, device=device)
+        out_rejected = torch.empty_like(out_indices)
+        eagle_prepare_inputs_padded_kernel[(num_reqs,)](
+            cu_draft,
+            valid,
+            query_start,
+            out_indices,
+            out_rejected,
+            num_reqs,
+        )
+
+        # The proposer passes target-plus-draft tokens when speculation is
+        # active, but falls back to a one-token row for requests that bypass the
+        # drafter (for example beyond its long-context cutoff). Triton
+        # specializes both the row stride and BLOCK_SIZE_TOKENS, so derive the
+        # active row width from the serving configuration and cover both
+        # production layouts at every reachable engine batch width.
+        for num_sampled_tokens in (1, num_spec_sampled_tokens):
+            sampled = torch.zeros(
+                (num_reqs, num_sampled_tokens),
+                dtype=torch.int32,
+                device=device,
+            )
+            discard = torch.zeros(num_reqs, dtype=torch.bool, device=device)
+            backup = torch.zeros(num_reqs, dtype=torch.int32, device=device)
+            next_tokens = torch.empty_like(backup)
+            eagle_prepare_next_token_padded_kernel[(num_reqs,)](
+                sampled,
+                discard,
+                backup,
+                next_tokens,
+                valid,
+                200_064,
+                num_sampled_tokens,
+                num_reqs,
+                sampled.stride(0),
+                BLOCK_SIZE_TOKENS=1 << (num_sampled_tokens - 1).bit_length(),
+            )
+
+        positions = torch.zeros(num_reqs, dtype=torch.int64, device=device)
+        block_table = torch.zeros(
+            (num_reqs, n_blocks_per_req), dtype=torch.int32, device=device
+        )
+        seq_lens = torch.zeros(num_reqs, dtype=torch.int32, device=device)
+        out_positions = torch.empty_like(positions)
+        out_slots = torch.empty(num_reqs, dtype=torch.int64, device=device)
+        eagle_step_slot_mapping_metadata_kernel[(num_reqs,)](
+            positions,
+            block_table,
+            block_table.stride(0),
+            seq_lens,
+            out_positions,
+            out_slots,
+            block_size=block_size,
+            max_model_len=max_model_len,
+            n_blocks_per_req=n_blocks_per_req,
+            PAD_ID=-1,
+            batch_size=num_reqs,
+        )
+
+    # Use the loaded EAGLE3 model's real TP-local weights. The old hard-coded
+    # shapes belonged to a different drafter and therefore did not populate
+    # MiniMax-M3's A16W16 specializations.
+    projection_weights = _draft_bf16_projection_weights(worker)
+    token_sizes = (
+        1,
+        2,
+        4,
+        5,
+        8,
+        9,
+        16,
+        17,
+        32,
+        33,
+        64,
+        65,
+        128,
+        129,
+        256,
+        257,
+        512,
+        513,
+        1024,
+        1025,
+        2048,
+        2049,
+        4096,
+        4097,
+        8192,
+        8193,
+    )
+    for tokens in token_sizes:
+        for weight in projection_weights:
+            x = torch.empty(
+                (tokens, int(weight.shape[1])),
+                dtype=torch.bfloat16,
+                device=device,
+            )
+            gemm_a16w16(x, weight)
+            del x
+
+    vocab_size = int(worker.model_config.get_vocab_size())
+    for batch_size in batch_sizes:
+        logits = torch.empty(
+            (batch_size, vocab_size), dtype=torch.float32, device=device
+        )
+        top_k = torch.full((batch_size,), 50, dtype=torch.int32, device=device)
+        top_p = torch.full((batch_size,), 0.95, dtype=torch.float32, device=device)
+        apply_top_k_top_p_triton(logits, None, top_p)
+        apply_top_k_top_p_triton(logits, top_k, None)
+        apply_top_k_top_p_triton(logits, top_k, top_p)
+
+    torch.cuda.synchronize()
+    logger.info("MiniMax M3 ROCm AgentX dynamic-kernel warmup complete.")
+
+
 @instrument(span_name="MiniMax M3 MSA warmup")
 def minimax_m3_msa_warmup(worker: "Worker") -> None:
+    _warmup_rocm_agentx_dynamic_kernels(worker)
+
