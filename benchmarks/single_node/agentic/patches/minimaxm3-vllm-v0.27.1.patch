+def _warmup_aiter_unified_attention(worker: "Worker") -> None:
+    """Compile the FP8-query attention variants reachable in AgentX.
+
+    vLLM's ordinary graph warmup and a small request warmup do not cover every
+    split count selected by AITER for resumed AgentX trajectories.  In
+    particular, the same q=1 kernel can specialize for 8, 16, 32, 64, or 128
+    KV segments as the cached context grows.  Exercise representative inputs
+    directly so those specializations cannot first appear in the measured
+    phase.
+    """
+    unified_attention_module = importlib.import_module(
+        "aiter.ops.triton.attention.unified_attention"
+    )
+    from aiter.ops.triton.utils.types import e4m3_dtype
+
+    text_config = getattr(worker.model_config.hf_config, "text_config", None)
+    if text_config is None:
+        text_config = worker.model_config.hf_config
+    tp_size = worker.parallel_config.tensor_parallel_size
+    num_query_heads = int(text_config.num_attention_heads) // tp_size
+    total_num_kv_heads = int(text_config.num_key_value_heads)
+    num_kv_heads = max(1, total_num_kv_heads // tp_size)
+    head_size = int(text_config.head_dim)
+    block_size = int(worker.cache_config.block_size)
+    max_model_len = int(worker.model_config.max_model_len)
+    device = worker.device
+
+    # Match ROCM_AITER_UNIFIED_ATTN's packed allocation and transposed K/V
+    # views.  A single physical block is enough: the synthetic block table
+    # aliases every logical block to it, preserving the production strides and
+    # compile signature without allocating a long-context cache.
+    packed_cache = torch.zeros(
+        (1, num_kv_heads, block_size, 2 * head_size),
+        dtype=e4m3_dtype,
+        device=device,
+    )
+    key_cache, value_cache = packed_cache.transpose(1, 2).split(
+        head_size, dim=-1
+    )
+    q_descale = torch.ones(1, dtype=torch.float32, device=device)
+    k_descale = torch.ones_like(q_descale)
+    v_descale = torch.ones_like(q_descale)
+    # The production metadata builder allocates this table at max-model width.
+    # Triton includes pointer-range/divisibility properties in its cache key, so
+    # a context-sized synthetic table can compile a different specialization.
+    block_table = torch.zeros(
+        (1, math.ceil(max_model_len / block_size)),
+        dtype=torch.int32,
+        device=device,
+    )
+
+    # (label, per-sequence query lengths, per-sequence context lengths, sliding
+    # window).  The no-window
+    # resumed-prefill sizes map to split counts 128, 64, 32, 16, and 8 on
+    # gfx950.  Decode cases cover the context-limited split counts, while the
+    # two prefill cases on each path cover the small and large 2-D configs.
+    #
+    # AgentX concurrency 1 can still put two requests in one engine batch when
+    # a resumed parent overlaps a spawned branch.  Those mixed decode/prefill
+    # batches have a different Triton specialization from the one-sequence
+    # direct calls.  They first appeared eleven minutes into a real replay, so
+    # cover both the small and large query buckets explicitly.
+    cases = (
+        ("full-2d-decode", (1,), (512,), 0),
+        ("full-3d-decode-16", (1,), (1024,), 0),
+        ("full-3d-decode-32", (1,), (2048,), 0),
+        ("full-3d-decode-64", (1,), (4096,), 0),
+        ("full-3d-decode-128", (1,), (8192,), 0),
+        ("full-3d-prefill-128", (64,), (8192,), 0),
+        ("full-3d-prefill-64", (128,), (8192,), 0),
+        ("full-3d-prefill-32", (256,), (8192,), 0),
+        ("full-3d-prefill-16", (512,), (8192,), 0),
+        ("full-3d-prefill-8", (1024,), (8192,), 0),
+        ("full-2d-prefill-small", (16,), (512,), 0),
+        ("full-2d-prefill-large", (1280,), (1280,), 0),
+        ("full-mixed-prefill-small", (1, 2), (8192, 8192), 0),
+        ("full-mixed-prefill-large", (1, 256), (512, 512), 0),
+        ("window-3d-decode-8", (1,), (512,), 32768),
+        ("window-3d-decode-16", (1,), (1024,), 32768),
+        ("window-3d-decode-32", (1,), (2048,), 32768),
+        ("window-3d-decode-64", (1,), (4096,), 32768),
+        ("window-3d-decode-128", (1,), (8192,), 32768),
+        ("window-mixed-decode-128", (1, 1), (8192, 8192), 32768),
+        ("window-2d-prefill-small", (16,), (512,), 32768),
+        ("window-2d-prefill-large", (256,), (512,), 32768),
+        ("window-mixed-prefill-small", (1, 2), (8192, 8192), 32768),
+        (
+            "window-mixed-prefill-large",
+            (1, 256),
+            (32768, 32768),
+            32768,
+        ),
+    )
+
+    # At high external concurrency, the scheduler can place many resumed
+    # trajectories in the same engine batch. Although ``num_seqs`` itself is
+    # dynamic, the batch allocation size is part of Triton's pointer-range
+    # specialization and the batch width also changes the selected 3-D split
+    # count. Job 1014 proved that covering batch=32 only at context=32768 and
+    # context=2048 only at batch=1 is insufficient: its first profiled request
+    # compiled the batch=32/context~=2048 sliding-window specialization with
+    # NUM_SEGMENTS_PER_SEQ=32. Cover the reachable power-of-two batch/context
+    # cross-product directly, for both full and sliding-window attention.
+    decode_batch_sizes = (2, 4, 8, 16, 32)
+    decode_context_lens = (512, 1024, 2048, 4096, 8192, 32768)
+    high_concurrency_cases = tuple(
+        case
+        for batch_size in decode_batch_sizes
+        for context_len in decode_context_lens
+        for case in (
+            (
+                f"full-batch{batch_size}-decode-{context_len}",
+                (1,) * batch_size,
+                (context_len,) * batch_size,
+                0,
+            ),
+            (
+                f"window-batch{batch_size}-decode-{context_len}",
+                (1,) * batch_size,
+                (context_len,) * batch_size,
+                32768,
+            ),
+        )
+    )
+    batch_size = 32
+    high_concurrency_cases += (
+        (
+            "full-batch32-mixed-prefill-small",
+            (1,) * (batch_size - 1) + (2,),
+            (32768,) * batch_size,
+            0,
+        ),
+        (
+            "window-batch32-mixed-prefill-small",
+            (1,) * (batch_size - 1) + (2,),
+            (32768,) * batch_size,
+            32768,
+        ),
+        (
+            "full-batch32-mixed-prefill-3d",
+            (1,) * (batch_size - 1) + (256,),
+            (32768,) * batch_size,
+            0,
+        ),
+        (
+            "window-batch32-mixed-prefill-256",
+            (1,) * (batch_size - 1) + (256,),
+            (32768,) * batch_size,
+            32768,
+        ),
+        (
+            "full-batch32-mixed-prefill-2d",
+            (1,) * (batch_size - 1) + (1280,),
+            (32768,) * batch_size,
+            0,
+        ),
+        (
+            "window-batch32-mixed-prefill-1280",
+            (1,) * (batch_size - 1) + (1280,),
+            (32768,) * batch_size,
+            32768,
+        ),
+    )
+    cases += high_concurrency_cases
+
+    # The target path quantizes Q to FP8, while the EAGLE drafter keeps BF16 Q
+    # against the same FP8 packed cache. The latter reaches a distinct Triton
+    # specialization. Jobs 940/942/944 showed that the ordinary request warmup
+    # compiled one long-context drafter variant, then the deterministic replay
+    # compiled another after profiling began when a resumed trajectory crossed
+    # 32K. Exercise the observed 35,119- and 315,436-token shapes, plus the
+    # surrounding policy/corpus boundaries, in the serving process itself.
+    draft_bf16_cases = (
+        ("draft-window-decode-512", (1,), (512,), 32768),
+        ("draft-window-decode-8192", (1,), (8192,), 32768),
+        ("draft-window-decode-32768", (1,), (32768,), 32768),
+        ("draft-window-decode-35119", (1,), (35119,), 32768),
+        ("draft-window-decode-81920", (1,), (81920,), 32768),
+        ("draft-window-decode-262144", (1,), (262144,), 32768),
+        ("draft-window-decode-315436", (1,), (315436,), 32768),
+        ("draft-window-decode-393216", (1,), (393216,), 32768),
+    )
+    # C32 can schedule many drafter decode rows together. The target FP8 path
+    # above already covers those engine batch widths, but the BF16 drafter has
+    # a distinct Triton specialization. Job 997 first reached the missing
+    # multi-sequence variant 29 seconds into profiling, after the ordinary 354-
+    # request warmup had completed. Mirror the reachable high-concurrency
+    # decode widths here so every TP worker compiles them before measurement.
+    draft_bf16_cases += tuple(
+        (
+            f"draft-window-batch{batch_size}-decode-{context_len}",
+            (1,) * batch_size,
+            (context_len,) * batch_size,
+            32768,
+        )
+        for batch_size in decode_batch_sizes
+        for context_len in decode_context_lens
+    )
+    variants = (
+        ("target-fp8", cases, e4m3_dtype, q_descale),
+        ("draft-bf16", draft_bf16_cases, torch.bfloat16, None),
+    )
+    logger.info(
+        "Warming %d MiniMax M3 AITER unified-attention configurations twice.",
+        sum(len(variant_cases) for _, variant_cases, _, _ in variants),
+    )
+    for variant, variant_cases, query_dtype, query_scale in variants:
+        for label, query_lens, context_lens, sliding_window in (
+            variant_cases + variant_cases
+        ):
+            num_query_tokens = sum(query_lens)
+            query = torch.zeros(
+                (num_query_tokens, num_query_heads, head_size),
+                dtype=query_dtype,
+                device=device,
+            )
+            output = torch.empty(query.shape, dtype=torch.bfloat16, device=device)
+            cu_seqlens_q = torch.tensor(
+                (0, *tuple(itertools.accumulate(query_lens))),
+                dtype=torch.int32,
+                device=device,
+            )
+            case_block_table = block_table.expand(len(query_lens), -1).contiguous()
+            window_size = (sliding_window - 1, 0) if sliding_window else (-1, -1)
+            # Production selects decode rows from shared metadata buffers. The
+            # resulting ``seqused_k`` view can start one, two, or three int32
+            # elements past an aligned base. Triton specializes on that pointer
+            # alignment. Jobs 997/1009 exposed this on the BF16 drafter, and
+            # job 1014 exposed a distinct FP8 target specialization at the
+            # first C32 profiling batch. Cover every decode alignment while
+            # retaining a single aligned call for prefill cases.
+            context_offsets = (0, 1, 2, 3) if "decode" in label else (0,)
+            for context_offset in context_offsets:
+                seq_lens_storage = torch.tensor(
+                    (0,) * context_offset + tuple(context_lens),
+                    dtype=torch.int32,
+                    device=device,
+                )
+                seq_lens = seq_lens_storage[
+                    context_offset : context_offset + len(context_lens)
+                ]
+                unified_attention_module.unified_attention(
+                    q=query,
+                    k=key_cache,
+                    v=value_cache,
+                    out=output,
+                    cu_seqlens_q=cu_seqlens_q,
+                    max_seqlen_q=max(query_lens),
+                    seqused_k=seq_lens,
+                    max_seqlen_k=max(context_lens),
+                    softmax_scale=head_size**-0.5,
+                    causal=True,
+                    window_size=window_size,
+                    block_table=case_block_table,
+                    softcap=0,
+                    q_descale=query_scale,
+                    k_descale=k_descale,
+                    v_descale=v_descale,
+                )
+                logger.debug(
+                    "Warmed MiniMax M3 AITER attention case %s/%s "
+                    "with context offset %d.",
+                    variant,
+                    label,
+                    context_offset,
+                )
+    torch.cuda.synchronize(device)
+
