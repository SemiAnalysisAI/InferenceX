+    def _open_disk_shard(
+        self,
+        disk_dir: str,
+        weight_shape: tuple[int, int],
+        scale_shape: tuple[int, int],
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        """Refresh shared file mappings from this startup's checkpoint.
+
+        Geometry alone is not checkpoint identity. The normal loader always
+        writes parameters, so loading into a COW mapping would silently create
+        a private RAM copy. Load through writable shared mappings every time;
+        only after both parameters are loaded and flushed may they become COW.
+        A per-layer/rank lock prevents overlapping engines from rewriting files.
+        """
+        os.makedirs(disk_dir, exist_ok=True)
+        layer_key = hashlib.sha256(self.disk_shard_id.encode()).hexdigest()[:16]
+        base = os.path.join(
+            disk_dir,
+            f"engram_{layer_key}_v{self.vocab_start_idx}_{self.vocab_end_idx}"
+            f"_r{engram_head_shard_rank()}",
+        )
+        self._disk_base = base
+        self._disk_lock = open(f"{base}.lock", "a+b")
+        try:
+            fcntl.flock(self._disk_lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError as exc:
+            self._disk_lock.close()
+            raise RuntimeError(f"Engram disk shard is in use: {base}") from exc
+        specs = (
+            (f"{base}.weight.bin", weight_shape, torch.float8_e4m3fn),
+            (f"{base}.scale.bin", scale_shape, torch.uint8),
+        )
+        with contextlib.suppress(FileNotFoundError):
+            os.remove(f"{base}.done.json")
+        for path, shape, dt in specs:
+            with open(path, "ab") as fh:
+                fh.truncate(math.prod(shape) * torch.tensor([], dtype=dt).element_size())
+        self._disk_finalized = False
+        logger.info("Engram disk shard %s: refreshing from checkpoint", base)
+        return tuple(
+            _engram_disk_tensor(path, shape, dt, writable=True)
+            for path, shape, dt in specs
+        )
