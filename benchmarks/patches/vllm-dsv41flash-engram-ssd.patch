+class EngramDiskStager:
+    """Stage live lookup rows before full graph replay into fixed GPU buffers.
+
+    One D2H copy covers all layers. Each worker deduplicates and sorts its local
+    row IDs before touching the mmap, so repeated n-grams are read once and the
+    two independent tables can fault pages concurrently. The captured model
+    contains only device operations consuming these persistent buffers.
+    """
+
+    def __init__(self, layers, max_tokens: int, num_layers: int, num_heads: int):
+        self.layers = layers
+        device = layers[0].staged_rows.device
+        self.hashes = torch.zeros(
+            (max_tokens, num_layers, num_heads), dtype=torch.int32, device=device
+        )
+        self.mask = torch.zeros(max_tokens, dtype=torch.bool, device=device)
+        self.host_hashes = torch.empty(
+            self.hashes.shape, dtype=torch.int32, device="cpu", pin_memory=True
+        )
+        self.pool = ThreadPoolExecutor(max_workers=len(layers), thread_name_prefix="engram-stage")
+        for layer in layers:
+            layer.staged_rows.zero_()
+        self.steps = 0
+
+    def stage(self, hashes: torch.Tensor, mask: torch.Tensor) -> None:
+        if torch.cuda.is_current_stream_capturing():
+            raise RuntimeError("SSD staging must execute before CUDA graph replay")
+        count = hashes.shape[0]
+        if count > self.hashes.shape[0] or hashes.shape[1:] != self.hashes.shape[1:]:
+            raise ValueError("Engram hash shape exceeds fixed staging capacity")
+        if mask.shape != (count,):
+            raise ValueError("Engram keep mask does not match token count")
+        self.hashes[:count].copy_(hashes)
+        self.mask[:count].copy_(mask)
+        host = self.host_hashes[:count]
+        host.copy_(hashes, non_blocking=True)
+        ready = torch.cuda.Event()
+        ready.record()
+        ready.synchronize()
+        futures = [
+            self.pool.submit(
+                layer.embed_tokens.stage_disk_rows_from_host,
+                host[:, layer.layer_hash_index], count,
+            )
+            for layer in self.layers
+        ]
+        try:
+            for layer, future in zip(self.layers, futures):
+                layer.embed_tokens.finish_disk_rows(future.result(), layer.staged_rows[:count])
+        finally:
+            # Even on a read error no worker may retain the shared ID buffer
+            # when the next request starts or model teardown releases it.
+            wait(futures)
+        self.steps += 1
+        if self.steps == 1:
+            logger.info("Engram SSD staged before graph replay: %d tokens, %d layers", count, len(self.layers))
