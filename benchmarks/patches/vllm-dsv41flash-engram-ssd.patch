+class EngramRowCache:
+    """Bounded HBM cache + persistent transfer scratch; mmap is the DRAM tier.
+
+    A direct-mapped tag array keeps lookup overhead bounded. Colliding misses
+    use scratch for the current step; insertion happens AFTER dequantization,
+    so a miss cannot overwrite a cached hit still needed by that same batch.
+    Immutable rows need no writeback on eviction.
+    """
+
+    def __init__(self, embed, max_rows: int, budget: int, device):
+        self.embed = embed
+        self.max_rows = max_rows
+        self.capacity = min(budget // (embed.dim + embed.dim // embed.block_size),
+                            embed.weight.shape[0])
+        self.tags = np.full(self.capacity, -1, dtype=np.int64)
+        self.weights = torch.empty((self.capacity + max_rows, embed.dim),
+                                   dtype=torch.float8_e4m3fn, device=device)
+        self.scales = torch.empty((self.capacity + max_rows, embed.dim // embed.block_size),
+                                  dtype=torch.uint8, device=device)
+        self.host_w = torch.empty((max_rows, embed.dim), dtype=torch.uint8,
+                                  device="cpu", pin_memory=True)
+        self.host_s = torch.empty((max_rows, embed.dim // embed.block_size), dtype=torch.uint8,
+                                  device="cpu", pin_memory=True)
+        self.host_indices = torch.empty((4, max_rows), dtype=torch.int32,
+                                        device="cpu", pin_memory=True)
+        self.device_indices = torch.empty((4, max_rows), dtype=torch.int32, device=device)
+        self.done = None
+        self.steps = self.hits = self.misses = self.evictions = self.prefetch_ranges = 0
+
+    def _prefetch(self, rows: np.ndarray) -> None:
+        # WILLNEED queues batched readahead; cached pages do not require I/O.
+        # Small decode miss sets skip the hint overhead. mmap remains the
+        # authoritative reader and surfaces read errors during the gather.
