+@triton.jit
+def _engram_cache_insert(weight, scales, source, slots, scratch_start: tl.constexpr,
+                         DIM: tl.constexpr, SCALE_DIM: tl.constexpr):
+    row = tl.program_id(0)
+    src = scratch_start + tl.load(source + row)
+    dst = tl.load(slots + row)
+    cols = tl.arange(0, DIM)
+    tl.store(weight + dst * DIM + cols, tl.load(weight + src * DIM + cols))
+    sc = tl.arange(0, SCALE_DIM)
+    tl.store(scales + dst * SCALE_DIM + sc, tl.load(scales + src * SCALE_DIM + sc))
+
