+def engram_page_ranges(row_ids: np.ndarray, row_bytes: int, file_bytes: int,
+                       page_size: int = 4096) -> list[tuple[int, int]]:
+    """Deduplicated contiguous page ranges covering the requested rows."""
+    if not len(row_ids):
+        return []
+    # Hash IDs fit int32, byte offsets into the ~24 GiB shard do not.
+    # Widen before multiplication, never after an already-overflowed result.
+    row_ids = np.asarray(row_ids, dtype=np.int64)
+    if row_bytes <= 0 or page_size <= 0 or np.any(row_ids < 0) or np.any(row_ids >= file_bytes // row_bytes):
+        raise ValueError("Engram prefetch row lies outside its mapped table")
+    first = row_ids * row_bytes // page_size
+    last = ((row_ids + 1) * row_bytes - 1) // page_size
+    pages = np.unique(np.concatenate([
+        (first + shift)[first + shift <= last]
+        for shift in range(int((last - first).max()) + 1)
+    ]))
+    starts = np.r_[0, np.flatnonzero(np.diff(pages) > 1) + 1]
+    ends = np.r_[starts[1:] - 1, len(pages) - 1]
+    return [(int(pages[a]) * page_size,
+             min((int(pages[b]) + 1) * page_size, file_bytes) - int(pages[a]) * page_size)
+            for a, b in zip(starts, ends)]
+
