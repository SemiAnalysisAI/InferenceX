+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+"""Scoped cancellation for the pinned SGLang single-request P/D route."""
+
+import asyncio
+import os
+from contextlib import asynccontextmanager
+
+
+def enabled():
+    return os.environ.get("DYN_GLM52_PREFILL_FAILURE_CONTAINMENT") == "1"
+
+
+def check_request(request):
+    # Check both the canonical request and DisaggPreprocessedRequest wrapper.
+    inner = request.get("request", request)
+    for candidate in (request, inner):
+        extra_args = candidate.get("extra_args") or {}
+        n = (candidate.get("sampling_options") or {}).get("n", 1)
+        if isinstance(extra_args.get("sglang_tito"), dict) or n not in (None, 1):
+            raise ValueError("GLM52 containment supports regular single-request P/D only")
+    n = (request.get("sampling_params") or {}).get("n", 1)
+    if n not in (None, 1):
+        raise ValueError("GLM52 containment supports regular single-request P/D only")
+    if os.environ.get("SGLANG_DISAGGREGATION_DEFERRED_DECODE_KV_RELEASE", "").lower() not in ("1", "true"):
+        raise RuntimeError("GLM52 containment requires deferred KV release on both worker roles")
+
+
+def request_id(request, context):
+    if not enabled():
+        return context.trace_id
+    check_request(request)
+    return context.id()
+
+
+def abort_dispatched(manager, rid):
+    state = manager.rid_to_state.get(rid)
+    if state is not None and state.dispatched and not state.finished:
+        # No await between the registration check and AbortReq. Both execute on
+        # the tokenizer event loop, so AbortReq cannot overtake GenerateReq.
+        manager.abort_request(rid=rid, abort_all=False)
+        return True
+    return False
+
+
+@asynccontextmanager
+async def monitor(manager, rid, context, shutdown_event=None):
+    async def watch():
+        stopped = asyncio.ensure_future(context.async_killed_or_stopped())
+        shutdown = asyncio.create_task(shutdown_event.wait()) if shutdown_event else None
+        tasks = [stopped] + ([shutdown] if shutdown else [])
+        try:
+            await asyncio.wait(tasks, return_when=asyncio.FIRST_COMPLETED)
+            while True:
+                state = manager.rid_to_state.get(rid)
+                if state is not None and state.finished:
+                    return
+                if abort_dispatched(manager, rid):
+                    return
+                # async_generate is lazy. Cancellation may arrive before the
+                # registration or scheduler dispatch; retain ownership until it
+                # is ordered or the generator's scope closes below.
+                await asyncio.sleep(0.01)
+        finally:
+            for task in tasks:
+                if not task.done():
+                    task.cancel()
+            await asyncio.gather(*tasks, return_exceptions=True)
+
+    watcher = asyncio.create_task(watch())
+    try:
+        yield watcher
+    finally:
+        # Closing the output stream is cancellation too. Do not discard a
+        # registered, live request when stopping the monitor before first output.
+        abort_dispatched(manager, rid)
+        watcher.cancel()
+        await asyncio.gather(watcher, return_exceptions=True)
