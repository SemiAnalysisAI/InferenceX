+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+use crate::protocols::common::llm_backend::LLMEngineOutput;
+use dynamo_runtime::{
+    engine::AsyncEngineContext,
+    error::DynamoError,
+    pipeline::{ManyOut, ResponseStream},
+    protocols::{annotated::Annotated, maybe_error::MaybeError},
+};
+use futures::StreamExt;
+use std::sync::Arc;
+use tokio::sync::oneshot;
+
+pub(super) fn enabled() -> bool {
+    std::env::var("DYN_GLM52_PREFILL_FAILURE_CONTAINMENT").as_deref() == Ok("1")
+}
+
+// Observe before either foreground consumption or the bootstrap tail drain.
+// The prefill stream's context is distinct from the original decode context.
+pub(super) fn observe(
+    response: ManyOut<Annotated<LLMEngineOutput>>,
+    decode_context: Arc<dyn AsyncEngineContext>,
+) -> (
+    ManyOut<Annotated<LLMEngineOutput>>,
+    oneshot::Receiver<DynamoError>,
+) {
+    let context = response.context();
+    let (sender, receiver) = oneshot::channel();
+    let mut sender = Some(sender);
+    let response = response.inspect(move |item| {
+        if let Some(error) = item.err() {
+            decode_context.stop_generating();
+            if let Some(sender) = sender.take() {
+                let _ = sender.send(error);
+            }
+        }
+    });
+    (ResponseStream::new(Box::pin(response), context), receiver)
+}
+
+// Call only after decode dispatch: staged KV still needs its receiver and the
+// worker's ordered AbortReq cleanup even when prefill failed during dispatch.
+pub(super) fn forward(
+    mut decode: ManyOut<Annotated<LLMEngineOutput>>,
+    mut failure: oneshot::Receiver<DynamoError>,
+) -> ManyOut<Annotated<LLMEngineOutput>> {
+    let context = decode.context();
+    let response = async_stream::stream! {
+        let mut watching = true;
+        loop {
+            tokio::select! {
+                biased;
+                result = &mut failure, if watching => {
+                    watching = false;
+                    if let Ok(error) = result {
+                        yield Annotated::from_err(error);
+                        break;
+                    }
+                }
+                output = decode.next() => {
+                    match output {
+                        Some(output) => yield output,
+                        None => break,
+                    }
+                }
+            }
+        }
+    };
+    ResponseStream::new(Box::pin(response), context)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use dynamo_runtime::pipeline::context::Controller;
+    use futures::stream;
+
+    fn stream(items: Vec<Annotated<LLMEngineOutput>>) -> ManyOut<Annotated<LLMEngineOutput>> {
+        ResponseStream::new(
+            Box::pin(stream::iter(items)),
+            Arc::new(Controller::default()),
+        )
+    }
+
+    #[tokio::test]
+    async fn late_prefill_error_stops_original_context_and_reaches_decode() {
+        let original: Arc<dyn AsyncEngineContext> = Arc::new(Controller::default());
+        let (mut prefill, failure) = observe(
+            stream(vec![
+                Annotated::from_data(LLMEngineOutput::default()),
+                Annotated::from_error("prefill transfer failed"),
+            ]),
+            original.clone(),
+        );
+        assert!(prefill.next().await.unwrap().err().is_none());
+        assert!(!original.is_stopped());
+        assert!(prefill.next().await.unwrap().err().is_some());
+        assert!(original.is_stopped());
+        let decode = ResponseStream::new(Box::pin(stream::pending()), original);
+        let mut output = forward(decode, failure);
+        assert!(
+            output
+                .next()
+                .await
+                .unwrap()
+                .err()
+                .unwrap()
+                .to_string()
+                .contains("prefill transfer failed")
+        );
+        assert!(output.next().await.is_none());
+    }
+
+    #[tokio::test]
+    async fn healthy_prefill_keeps_decode_unchanged() {
+        let original: Arc<dyn AsyncEngineContext> = Arc::new(Controller::default());
+        let (prefill, failure) = observe(stream(vec![]), original.clone());
+        drop(prefill);
+        let output = forward(
+            stream(vec![Annotated::from_data(LLMEngineOutput::default())]),
+            failure,
+        )
+        .collect::<Vec<_>>()
+        .await;
+        assert_eq!(output.len(), 1);
+        assert!(output[0].err().is_none());
+        assert!(!original.is_stopped());
+    }
+}
