+# SPDX-License-Identifier: Apache-2.0
+"""Fail-closed lifetime guard for the pinned GLM52 recovery route.
+
+The old NIXL ABORT_ACK does not prove that all queued/sibling writes ended.
+Failed requests retain their buffers until the owning native worker teardown.
+This does not restore serving capacity after transport failure.
+"""
+import os
+
+
+def enabled():
+    return os.environ.get("DYN_GLM52_PREFILL_FAILURE_CONTAINMENT") == "1"
+
+
+def mark_failed(manager, room):
+    if enabled():
+        # setdefault cannot overwrite a tombstone set installed by another
+        # transfer/control thread on this pinned CPython runtime.
+        manager.__dict__.setdefault("_glm52_failed_rooms", set()).add(room)
+
+
+def is_failed(manager, room):
+    return enabled() and room in getattr(manager, "_glm52_failed_rooms", ())
+
+
+def retain_prefill(req):
+    sender = getattr(req, "disagg_kv_sender", None)
+    manager = getattr(sender, "kv_mgr", None)
+    if manager is None or not is_failed(manager, req.bootstrap_room):
+        return False
+    if not hasattr(manager, "_glm52_held_requests"):
+        manager._glm52_held_requests = {}
+    manager._glm52_held_requests[req.rid] = req
+    return True
+
+
+def mark_request(req):
+    sender = getattr(req, "disagg_kv_sender", None)
+    manager = getattr(sender, "kv_mgr", None)
+    if manager is not None:
+        mark_failed(manager, req.bootstrap_room)
+
+
+def has_holds(scheduler):
+    if not enabled():
+        return False
+    prefill = getattr(scheduler, "disagg_prefill_bootstrap_queue", None)
+    manager = getattr(prefill, "kv_manager", None)
+    decode = getattr(scheduler, "disagg_decode_transfer_queue", None)
+    return bool(
+        getattr(manager, "_glm52_held_requests", None)
+        or getattr(decode, "_deferred_releases", None)
+    )
