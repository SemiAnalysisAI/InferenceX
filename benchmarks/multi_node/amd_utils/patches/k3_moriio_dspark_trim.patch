+        layer_name,
+        conv,
+        ssm,
+        layer_to_spec,
+        split_info,
+        tp_ratio,
+        tp_rank,
+        world_size,
+    )
+    return apply_mamba_offset_template(template, local_slots, remote_slots)
+
+
+def compute_mamba_conv_split_count(
+    local_slots: list[int],
+    split_info: MambaConvSplitInfo,
