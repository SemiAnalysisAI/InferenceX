+def _dsv4_sparse_flydsl_prefill_enabled() -> bool:
+    return bool(
+        envs.VLLM_ROCM_DSV4_SPARSE_FLYDSL_PREFILL
+        and _ON_GFX950
+        and not _dsv4_sparse_flydsl_prefill_disabled
+    )
+
+
+def _should_split_dsv4_sparse_flydsl_prefill(
+    q: torch.Tensor, max_row_length: int
+) -> bool:
+    """Use two KV workers only where gfx950 measurements show a gain."""
+    return bool(
+        q.ndim == 3
+        and q.shape[1] == 16
+        and q.shape[0] < _DSV4_SPARSE_SPLIT_KV_MAX_QUERIES
+        and max_row_length >= _DSV4_SPARSE_SPLIT_KV_MIN_ROW_LENGTH
+    )
+
+
+@functools.lru_cache(maxsize=1)
+def _resolve_dsv4_sparse_flydsl_prefill():
+    """Resolve AITER lazily so the default Triton path has no FlyDSL import."""
+    try:
+        flydsl_ops = importlib.import_module("aiter.ops.flydsl")
+        return getattr(flydsl_ops, "flydsl_sparse_mla_prefill")
+    except (AttributeError, ImportError):
+        return None
+
+
+def _supports_dsv4_sparse_flydsl_prefill(
+    q: torch.Tensor,
+    kv: torch.Tensor,
+    indices: torch.Tensor,
+    indptr: torch.Tensor,
+    attn_sink: torch.Tensor | None,
+    output: torch.Tensor,
+) -> bool:
+    """Return whether the MVP can consume this ragged prefill invocation."""
+    if not _dsv4_sparse_flydsl_prefill_enabled():
+        return False
+    if (
+        q.device.type != "cuda"
+        or kv.device != q.device
+        or indices.device != q.device
+        or indptr.device != q.device
+        or output.device != q.device
+    ):
+        return False
+    if (
+        q.ndim != 3
+        or kv.ndim != 3
+        or kv.shape[1] != 1
+        or q.shape[-1] != _DSV4_SPARSE_NOPE_DIM + _DSV4_SPARSE_ROPE_DIM
+        or kv.shape[-1] != q.shape[-1]
+        or output.shape != q.shape
+    ):
+        return False
+    if (
+        q.dtype != torch.bfloat16
+        or kv.dtype != torch.bfloat16
+        or output.dtype != torch.bfloat16
+        or indices.dtype != torch.int32
+        or indptr.dtype != torch.int32
+    ):
+        return False
+    if (
+        indices.ndim != 1
+        or indptr.ndim != 1
+        or indptr.numel() != q.shape[0] + 1
+    ):
+        return False
+    if not all(
+        tensor.is_contiguous()
+        for tensor in (q, kv, indices, indptr, output)
+    ):
+        return False
+    if attn_sink is not None:
+        if (
+            attn_sink.device != q.device
+            or attn_sink.dtype != torch.float32
+            or attn_sink.ndim != 1
+            or attn_sink.numel() < q.shape[1]
+            or not attn_sink.is_contiguous()
+        ):
+            return False
+    return True
+
+
+def _try_dsv4_sparse_flydsl_prefill(
+    q: torch.Tensor,
+    kv: torch.Tensor,
+    indices: torch.Tensor,
+    indptr: torch.Tensor,
+    scale: float,
+    attn_sink: torch.Tensor | None,
+    output: torch.Tensor,
+    split_kv: bool = False,
+) -> bool:
+    """Try FlyDSL once; on any failure, latch this process onto Triton."""
+    global _dsv4_sparse_flydsl_prefill_disabled
+    if _dsv4_sparse_flydsl_prefill_disabled:
+        return False
+    if not _supports_dsv4_sparse_flydsl_prefill(
+        q, kv, indices, indptr, attn_sink, output
+    ):
+        return False
+
+    try:
+        op = _resolve_dsv4_sparse_flydsl_prefill()
+        if op is None:
+            logger.warning_once(
+                "VLLM_ROCM_DSV4_SPARSE_FLYDSL_PREFILL is enabled, but the pinned "
+                "AITER FlyDSL sparse-MLA symbol is unavailable; using Triton."
+            )
+            return False
+
+        op(
+            q=q,
+            kv=kv.squeeze(1),
+            indices=indices,
+            indptr=indptr,
+            scale=scale,
+            attn_sink=attn_sink,
+            out=output,
+            split_kv=split_kv,
+        )
+    except Exception:  # noqa: BLE001 - fallback is the feature-gate contract
+        _dsv4_sparse_flydsl_prefill_disabled = True
+        logger.warning(
+            "DSV4 sparse-MLA FlyDSL prefill failed; disabling it for this "
+            "process and falling back to Triton.",
+            exc_info=True,
+        )
+        return False
+
+    logger.info_once("Using gfx950 FlyDSL for DSV4 sparse-MLA prefill.")
+    return True
+
