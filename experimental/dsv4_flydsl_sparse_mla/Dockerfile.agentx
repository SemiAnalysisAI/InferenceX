# syntax=docker/dockerfile:1.7

ARG BASE_IMAGE=vllm/vllm-openai-rocm@sha256:4b403315f9a0d9b0ed4221dfc7ea04538701b4de0ce283c0e2cee622b217ff89
FROM ${BASE_IMAGE}

ARG INFERENCEX_COMMIT=a9698060cb854e730c54cd908102f36f3c245c3b
ARG VLLM_BASE_COMMIT=311b3513af33bc29b4acb2fde2e9313e5e9966a0
ARG VLLM_TARGET_COMMIT=91b654ac84638b582b62bb51921248a0d8023902
ARG AITER_COMMIT=59799f3a16d6dae44617346630aab7be27226789
ARG FLYDSL_COMMIT=421935cc6f09fd9b27d5d5ae52e0960e18834bd5
ARG KERNEL_SHA256=b56f2a20772abf606594136decf483c52d3a8f9881b7ea25c561ae73f555d2fd

LABEL org.opencontainers.image.title="DSV4 gfx950 FlyDSL sparse-MLA AgentX image" \
      org.opencontainers.image.description="Pinned vLLM/AITER/FlyDSL image for DSV4 sparse-MLA prefill A/B validation" \
      inferencex.commit="${INFERENCEX_COMMIT}" \
      vllm.base.commit="${VLLM_BASE_COMMIT}" \
      vllm.target.commit="${VLLM_TARGET_COMMIT}" \
      aiter.commit="${AITER_COMMIT}" \
      flydsl.commit="${FLYDSL_COMMIT}" \
      dsv4.sparse_mla.kernel.sha256="${KERNEL_SHA256}"

# The AITER wheel is built from the exact target checkout with
# PREBUILD_KERNELS=0 and GPU_ARCHS=gfx950 in the matching vLLM base image.
COPY --from=aiter /dist/amd_aiter-*.whl /opt/dsv4-flydsl/wheels/

RUN python3 -m pip uninstall -y aiter amd-aiter flydsl \
    && python3 -m pip install --no-cache-dir "flydsl==0.3.1" \
    && python3 -m pip install --no-cache-dir --no-deps --force-reinstall \
       /opt/dsv4-flydsl/wheels/amd_aiter-*.whl

# The target branch is based directly on the binary-compatible base image
# commit and changes Python only. Overlay the complete target Python package
# while retaining the base image's compiled vLLM extensions.
COPY --from=vllm /vllm/ /opt/dsv4-flydsl/vllm/

RUN cp -a /opt/dsv4-flydsl/vllm/. \
          /usr/local/lib/python3.12/dist-packages/vllm/ \
    && python3 -m py_compile \
       /usr/local/lib/python3.12/dist-packages/vllm/envs.py \
       /usr/local/lib/python3.12/dist-packages/vllm/v1/attention/ops/rocm_aiter_mla_sparse.py \
       /usr/local/lib/python3.12/dist-packages/aiter/ops/flydsl/kernels/sparse_mla.py \
    && test "$(sha256sum \
       /usr/local/lib/python3.12/dist-packages/aiter/ops/flydsl/kernels/sparse_mla.py \
       | awk '{print $1}')" = "${KERNEL_SHA256}" \
    && python3 -c "from importlib.metadata import version; assert version('flydsl') == '0.3.1'" \
    && grep -q "flydsl_sparse_mla_prefill" \
       /usr/local/lib/python3.12/dist-packages/aiter/ops/flydsl/__init__.py \
    && grep -q "VLLM_ROCM_DSV4_SPARSE_FLYDSL_PREFILL" \
       /usr/local/lib/python3.12/dist-packages/vllm/envs.py \
    && grep -q "Using gfx950 FlyDSL for DSV4 sparse-MLA prefill." \
       /usr/local/lib/python3.12/dist-packages/vllm/v1/attention/ops/rocm_aiter_mla_sparse.py
