+TEST_F(TransferEventTest, QueueCompletionAndQueuedCancellation) {
+    std::vector<uint8_t> buf(4096);
+    {
+        auto cfg = makeTraceConfig(1, 1UL << 20);
+        TransferEngineImpl engine(cfg);
+        ASSERT_TRUE(engine.available());
+        auto fake = std::make_shared<FakeTransport>(RDMA);
+        fake->outcome = PENDING;
+        installFakeRdma(engine, fake);
+        ASSERT_TRUE(engine.registerLocalMemory(buf.data(), buf.size()).ok());
+        auto batch = engine.allocateBatch(2);
+        ASSERT_TRUE(
+            engine
+                .submitTransfer(batch, {makeLocalWrite(buf.data(), 128),
+                                        makeLocalWrite(buf.data() + 128, 128)})
+                .ok());
+        ASSERT_TRUE(engine.cancelTransfer(batch, 1).ok());
+        fake->outcome = COMPLETED;
+        TransferStatus status;
+        for (int i = 0; i < 1000; ++i) {
+            ASSERT_TRUE(engine.getTransferStatus(batch, status).ok());
+            if (status.s != PENDING) break;
+            std::this_thread::sleep_for(std::chrono::milliseconds(1));
+        }
+        EXPECT_EQ(status.s, CANCELED);
+        ASSERT_TRUE(engine.freeBatch(batch).ok());
+        ASSERT_TRUE(engine.unregisterLocalMemory(buf.data(), buf.size()).ok());
+    }
+    auto rows = records();
+    size_t canceled = 0, completed = 0;
+    for (const auto& row : rows) {
+        if (row["event"] != "complete") continue;
+        if (row["status"] == "canceled") ++canceled;
+        if (row["status"] == "completed") ++completed;
+    }
+    EXPECT_EQ(canceled, 1);
+    EXPECT_EQ(completed, 1);
+}
