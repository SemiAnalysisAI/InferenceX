+void TransferEngineImpl::recordPreparedSubmit(Batch* batch,
+                                              const PreparedSubmit& prepared) {
+    if (!event_recorder_) return;
+    std::vector<std::vector<TransferEventSpan::Request>> requests(
+        prepared.owners.size());
+    for (const auto& task : prepared.tasks)
+        requests[task.merged_task_index].push_back(
+            {task.task_id, task.public_length});
+    for (size_t i = 0; i < prepared.owners.size(); ++i) {
+        const auto& owner = prepared.owners[i];
+        const auto target = owner.request.target_id;
+        // Handle-to-name lookup only: recording must never fetch metadata.
+        const auto peer =
+            target == LOCAL_SEGMENT_ID
+                ? local_segment_name_
+                : metadata_->segmentManager().lookupSegmentName(target);
+        auto span = event_recorder_->begin(
+            batch->trace_batch_id, target, peer,
+            owner.request.opcode == Request::READ ? "read" : "write",
+            prepared.trace_internal, std::move(requests[i]));
+        batch->task_list[owner.owner_task_id].trace_span = span;
+        for (auto id : owner.derived_task_ids)
+            batch->task_list[id].trace_span = span;
+    }
+}
+
+void TransferEngineImpl::recordTraceCompletion(TaskInfo& task,
+                                               TransferStatusEnum status) {
+    if (!event_recorder_ || status == PENDING) return;
+    const char* name = "unknown";
+    switch (status) {
+        case COMPLETED:
+            name = "completed";
+            break;
+        case FAILED:
+            name = "failed";
+            break;
+        case CANCELED:
+            name = "canceled";
+            break;
+        case TIMEOUT:
+            name = "timeout";
+            break;
+        default:
+            break;
+    }
+    event_recorder_->finish(task.trace_span, name,
+                            transportTypeName(task.type));
+}
