+TEST_F(TransferEventTest, MergedDescriptorsAndAppendKeepOriginalSizes) {
+    std::vector<uint8_t> buf(4096);
+    {
+        auto cfg = makeTraceConfig(4, 1UL << 20);
+        cfg->set("enable_runtime_queue", false);
+        cfg->set("merge_requests", true);
+        TransferEngineImpl engine(cfg);
+        ASSERT_TRUE(engine.available());
+        auto fake = std::make_shared<FakeTransport>(RDMA);
+        installFakeRdma(engine, fake);
+        ASSERT_TRUE(engine.registerLocalMemory(buf.data(), buf.size()).ok());
+        auto batch = engine.allocateBatch(4);
+        auto a = makeLocalWrite(buf.data(), 128);
+        auto b = makeLocalWrite(buf.data() + 128, 256);
+        ASSERT_TRUE(engine.submitTransfer(batch, {a, b}).ok());
+        TransferStatus status;
+        ASSERT_TRUE(engine.getTransferStatus(batch, 1, status).ok());
+        ASSERT_TRUE(engine.getTransferStatus(batch, status).ok());
+        ASSERT_EQ(status.s, COMPLETED);
+        a.opcode = Request::READ;
+        ASSERT_TRUE(engine.submitTransfer(batch, {a}).ok());
+        ASSERT_TRUE(engine.getTransferStatus(batch, status).ok());
+        ASSERT_EQ(status.s, COMPLETED);
+        ASSERT_TRUE(engine.getTransferStatus(batch, status).ok());
+        ASSERT_TRUE(engine.freeBatch(batch).ok());
+        ASSERT_TRUE(engine.unregisterLocalMemory(buf.data(), buf.size()).ok());
+    }
+    auto rows = records();
+    checkPairs(rows, 3, "completed");
+    size_t merged = 0, reads = 0;
+    for (const auto& row : rows) {
+        if (row["event"] != "submit") continue;
+        EXPECT_EQ(row["scope"], "user");
+        EXPECT_EQ(row["peer"], row["initiator"]);
+        if (row["operation"] == "read") ++reads;
+        if (row["merged_request_count"] == 2) ++merged;
+    }
+    EXPECT_EQ(merged, 2);
+    EXPECT_EQ(reads, 1);
+}
