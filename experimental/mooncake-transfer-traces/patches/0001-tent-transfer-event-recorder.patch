+// Copyright 2026 KVCache.AI
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <cstdio>
+#include <deque>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace mooncake {
+namespace tent {
+
+// One span per merged owner; each original API descriptor keeps its own ID.
+// Shared by derived tasks so polling an alias cannot duplicate completions.
+struct TransferEventSpan {
+    struct Request {
+        uint64_t task_index;
+        uint64_t bytes;
+        uint64_t request_id{0};
+    };
+    uint64_t batch_id{0};
+    uint64_t target_id{0};
+    uint64_t submit_wall_ns{0};
+    uint64_t submit_mono_ns{0};
+    std::string peer;
+    std::string operation;
+    bool internal{false};
+    std::vector<Request> requests;
+    std::atomic<bool> finished{false};
+};
+
+class TransferEventRecorder {
+   public:
+    // Unset/empty TENT_TRACE_DIR disables recording. Directory must exist.
+    // Failure to open a trace is reported but never fails engine startup.
+    static std::unique_ptr<TransferEventRecorder> fromEnvironment(
+        const std::string& initiator);
+    static std::unique_ptr<TransferEventRecorder> create(
+        const std::string& directory, const std::string& initiator,
+        size_t capacity = 65536);
+    ~TransferEventRecorder();
+
+    uint64_t nextBatchId() { return next_batch_id_.fetch_add(1); }
+    std::shared_ptr<TransferEventSpan> begin(
+        uint64_t batch_id, uint64_t target_id, std::string peer,
+        std::string operation, bool internal,
+        std::vector<TransferEventSpan::Request> requests);
+    void finish(const std::shared_ptr<TransferEventSpan>& span,
+                const std::string& status, const std::string& transport);
+    const std::string& path() const { return path_; }
+
+   private:
+    struct Event {
+        std::shared_ptr<TransferEventSpan> span;
+        uint64_t wall_ns;
+        uint64_t mono_ns;
+        std::string status;
+        std::string transport;
+    };
+    TransferEventRecorder(FILE* file, std::string path, std::string initiator,
+                          size_t capacity);
+    void enqueue(Event event);
+    void run();
+    void writeLine(const std::string& line);
+
+    FILE* file_;
+    const std::string path_;
+    const std::string initiator_;
+    const size_t capacity_;
+    std::atomic<uint64_t> next_batch_id_{1};
+    std::atomic<uint64_t> next_request_id_{1};
+    std::mutex mutex_;
+    std::condition_variable ready_;
+    std::deque<Event> queue_;
+    size_t queued_records_{0};
+    uint64_t dropped_records_{0};
+    uint64_t written_records_{0};
+    bool stopping_{false};
+    bool write_failed_{false};
+    std::thread writer_;
+};
+
+}  // namespace tent
+}  // namespace mooncake
