@@ -0,0 +1,234 @@
+// Copyright 2026 KVCache.AI
+// SPDX-License-Identifier: Apache-2.0
+
+#include "tent/runtime/transfer_event_recorder.h"
+
+#include <unistd.h>
+
+#include <chrono>
+#include <cstdlib>
+#include <limits>
+#include <stdexcept>
+#include <utility>
+
+#include "tent/thirdparty/nlohmann/json.h"
+
+namespace mooncake {
+namespace tent {
+namespace {
+template <class Clock>
+uint64_t nowNs() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+               Clock::now().time_since_epoch())
+        .count();
+}
+}  // namespace
+
+std::unique_ptr<TransferEventRecorder> TransferEventRecorder::fromEnvironment(
+    const std::string& initiator) {
+    const char* directory = std::getenv("TENT_TRACE_DIR");
+    if (!directory || !*directory) return nullptr;
+    size_t capacity = 65536;
+    const char* value = std::getenv("TENT_TRACE_BUFFER_RECORDS");
+    if (value) {
+        try {
+            const std::string text(value);
+            size_t end = 0;
+            auto parsed = std::stoull(text, &end);
+            if (text.empty() ||
+                text.find_first_not_of("0123456789") != std::string::npos ||
+                end != text.size() || parsed == 0 ||
+                parsed > std::numeric_limits<size_t>::max())
+                throw std::invalid_argument("invalid capacity");
+            capacity = static_cast<size_t>(parsed);
+        } catch (...) {
+            std::fprintf(stderr,
+                         "TENT trace disabled: invalid "
+                         "TENT_TRACE_BUFFER_RECORDS\n");
+            return nullptr;
+        }
+    }
+    return create(directory, initiator, capacity);
+}
+
+std::unique_ptr<TransferEventRecorder> TransferEventRecorder::create(
+    const std::string& directory, const std::string& initiator,
+    size_t capacity) {
+    if (!capacity) return nullptr;
+    char host[256]{};
+    if (gethostname(host, sizeof(host) - 1) != 0) host[0] = '\0';
+    std::string pattern = directory + "/tent-events-" + host + "-" +
+                          std::to_string(getpid()) + "-XXXXXX.jsonl";
+    std::vector<char> filename(pattern.begin(), pattern.end());
+    filename.push_back('\0');
+    int fd = mkstemps(filename.data(), 6);
+    if (fd < 0) {
+        std::fprintf(stderr, "TENT trace disabled: cannot create %s\n",
+                     pattern.c_str());
+        return nullptr;
+    }
+    FILE* file = fdopen(fd, "w");
+    if (!file) {
+        close(fd);
+        unlink(filename.data());
+        std::fprintf(stderr, "TENT trace disabled: fdopen failed\n");
+        return nullptr;
+    }
+    try {
+        auto recorder =
+            std::unique_ptr<TransferEventRecorder>(new TransferEventRecorder(
+                file, filename.data(), initiator, capacity));
+        std::fprintf(stderr, "TENT transfer events: %s\n", filename.data());
+        return recorder;
+    } catch (const std::exception& e) {
+        fclose(file);
+        std::fprintf(stderr, "TENT trace disabled: %s\n", e.what());
+        return nullptr;
+    }
+}
+
+TransferEventRecorder::TransferEventRecorder(FILE* file, std::string path,
+                                             std::string initiator,
+                                             size_t capacity)
+    : file_(file),
+      path_(std::move(path)),
+      initiator_(std::move(initiator)),
+      capacity_(capacity),
+      writer_(&TransferEventRecorder::run, this) {}
+
+TransferEventRecorder::~TransferEventRecorder() {
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        stopping_ = true;
+    }
+    ready_.notify_one();
+    writer_.join();
+    if (fclose(file_) != 0) write_failed_ = true;
+    if (dropped_records_ || write_failed_)
+        std::fprintf(stderr,
+                     "TENT trace incomplete: %llu dropped records, "
+                     "write_failed=%d, file=%s\n",
+                     static_cast<unsigned long long>(dropped_records_),
+                     write_failed_, path_.c_str());
+}
+
+std::shared_ptr<TransferEventSpan> TransferEventRecorder::begin(
+    uint64_t batch_id, uint64_t target_id, std::string peer,
+    std::string operation, bool internal,
+    std::vector<TransferEventSpan::Request> requests) {
+    auto span = std::make_shared<TransferEventSpan>();
+    span->batch_id = batch_id;
+    span->target_id = target_id;
+    span->peer = std::move(peer);
+    span->operation = std::move(operation);
+    span->internal = internal;
+    span->requests = std::move(requests);
+    for (auto& request : span->requests)
+        request.request_id = next_request_id_.fetch_add(1);
+    span->submit_wall_ns = nowNs<std::chrono::system_clock>();
+    span->submit_mono_ns = nowNs<std::chrono::steady_clock>();
+    enqueue({span, span->submit_wall_ns, span->submit_mono_ns, "", ""});
+    return span;
+}
+
+void TransferEventRecorder::finish(
+    const std::shared_ptr<TransferEventSpan>& span, const std::string& status,
+    const std::string& transport) {
+    if (!span || span->finished.exchange(true)) return;
+    enqueue({span, nowNs<std::chrono::system_clock>(),
+             nowNs<std::chrono::steady_clock>(), status, transport});
+}
+
+void TransferEventRecorder::enqueue(Event event) {
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        const auto count = event.span->requests.size();
+        if (count > capacity_ - queued_records_) {
+            dropped_records_ += count;
+            return;
+        }
+        queued_records_ += count;
+        queue_.push_back(std::move(event));
+    }
+    ready_.notify_one();
+}
+
+void TransferEventRecorder::writeLine(const std::string& line) {
+    if (write_failed_) return;
+    if (fwrite(line.data(), 1, line.size(), file_) != line.size() ||
+        fputc('\n', file_) == EOF) {
+        write_failed_ = true;
+        std::fprintf(stderr, "TENT trace write failed: %s\n", path_.c_str());
+    }
+}
+
+void TransferEventRecorder::run() {
+    using nlohmann::json;
+    try {
+        writeLine(json({{"event", "trace_start"},
+                        {"schema_version", 1},
+                        {"initiator", initiator_},
+                        {"pid", getpid()},
+                        {"buffer_records", capacity_}})
+                      .dump());
+        for (;;) {
+            std::deque<Event> events;
+            bool stop;
+            {
+                std::unique_lock<std::mutex> lock(mutex_);
+                ready_.wait_for(lock, std::chrono::milliseconds(250), [this] {
+                    return stopping_ || !queue_.empty();
+                });
+                events.swap(queue_);
+                queued_records_ = 0;
+                stop = stopping_;
+            }
+            for (const auto& event : events) {
+                const auto& span = *event.span;
+                const bool complete = !event.status.empty();
+                for (const auto& request : span.requests) {
+                    json record = {
+                        {"schema_version", 1},
+                        {"event",
+                         complete ? (event.status == "unobserved" ? "abandoned"
+                                                                  : "complete")
+                                  : "submit"},
+                        {"timestamp_ns", event.wall_ns},
+                        {"monotonic_ns", event.mono_ns},
+                        {"initiator", initiator_},
+                        {"peer", span.peer},
+                        {"target_id", span.target_id},
+                        {"batch_id", span.batch_id},
+                        {"request_id", request.request_id},
+                        {"task_index", request.task_index},
+                        {"operation", span.operation},
+                        {"bytes", request.bytes},
+                        {"scope", span.internal ? "staging_internal" : "user"},
+                        {"merged_request_count", span.requests.size()}};
+                    if (complete) {
+                        record["status"] = event.status;
+                        record["transport"] = event.transport;
+                        record["duration_ns"] =
+                            event.mono_ns - span.submit_mono_ns;
+                    }
+                    writeLine(record.dump(-1, ' ', false,
+                                          json::error_handler_t::replace));
+                    if (!write_failed_) ++written_records_;
+                }
+            }
+            if (fflush(file_) != 0) write_failed_ = true;
+            if (stop) break;
+        }
+        writeLine(json({{"event", "trace_end"},
+                        {"schema_version", 1},
+                        {"written_records", written_records_},
+                        {"dropped_records", dropped_records_}})
+                      .dump());
+    } catch (const std::exception& e) {
+        write_failed_ = true;
+        std::fprintf(stderr, "TENT trace writer failed: %s\n", e.what());
+    }
+}
+
+}  // namespace tent
+}  // namespace mooncake
