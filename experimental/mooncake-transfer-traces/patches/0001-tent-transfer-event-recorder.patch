+TEST_F(TransferEventTest, RejectionAndUnobservedTeardown) {
+    std::vector<uint8_t> buf(4096);
+    {
+        auto cfg = makeTraceConfig(4, 1UL << 20);
+        cfg->set("enable_runtime_queue", false);
+        TransferEngineImpl engine(cfg);
+        auto fake = std::make_shared<FakeTransport>(RDMA);
+        installFakeRdma(engine, fake);
+        ASSERT_TRUE(engine.registerLocalMemory(buf.data(), buf.size()).ok());
+        auto rejected = engine.allocateBatch(0);
+        auto request = makeLocalWrite(buf.data(), 128);
+        EXPECT_FALSE(engine.submitTransfer(rejected, {request}).ok());
+        EXPECT_TRUE(engine.freeBatch(rejected).ok());
+        auto unpolled = engine.allocateBatch(1);
+        ASSERT_TRUE(engine.submitTransfer(unpolled, {request}).ok());
+        // Fake transport completed, but the engine has never observed it.
+        // Teardown must not claim success on its behalf.
+    }
+    auto rows = records();
+    size_t submissions = 0, abandoned = 0, completed = 0;
+    for (const auto& row : rows) {
+        if (row["event"] == "submit") ++submissions;
+        if (row["event"] == "abandoned") {
+            ++abandoned;
+            EXPECT_EQ(row["status"], "unobserved");
+        }
+        if (row["event"] == "complete") ++completed;
+    }
+    EXPECT_EQ(submissions, 1);
+    EXPECT_EQ(abandoned, 1);
+    EXPECT_EQ(completed, 0);
+}
+
+TEST_F(TransferEventTest, QueuedSubmitFailureRecordedOnce) {
+    std::vector<uint8_t> buf(4096);
+    {
+        auto cfg = makeTraceConfig(4, 1UL << 20);
+        TransferEngineImpl engine(cfg);
+        auto fake = std::make_shared<FakeTransport>(RDMA);
+        fake->fail_submit = true;
+        installFakeRdma(engine, fake);
+        ASSERT_TRUE(engine.registerLocalMemory(buf.data(), buf.size()).ok());
+        auto batch = engine.allocateBatch(1);
+        ASSERT_TRUE(
+            engine.submitTransfer(batch, {makeLocalWrite(buf.data(), 128)})
+                .ok());
+        TransferStatus status;
+        ASSERT_TRUE(engine.getTransferStatus(batch, status).ok());
+        EXPECT_EQ(status.s, FAILED);
+        ASSERT_TRUE(engine.freeBatch(batch).ok());
+        ASSERT_TRUE(engine.unregisterLocalMemory(buf.data(), buf.size()).ok());
+    }
+    checkPairs(records(), 1, "failed");
+}
+
+TEST_F(TransferEventTest, FailoverKeepsOneLogicalRequest) {
+    std::vector<uint8_t> buf(4096);
+    {
+        auto cfg = makeTraceConfig(4, 1UL << 20);
+        cfg->set("enable_runtime_queue", false);
+        TransferEngineImpl engine(cfg);
+        auto rdma = std::make_shared<FakeTransport>(RDMA);
+        rdma->outcome = FAILED;
+        installFakeRdma(engine, rdma);
+        auto tcp = std::make_shared<FakeTransport>(TCP);
+        engine.swapTransportForTest(TCP, tcp);
+        ASSERT_TRUE(engine.registerLocalMemory(buf.data(), buf.size()).ok());
+        auto batch = engine.allocateBatch(1);
+        auto request = makeLocalWrite(buf.data(), 128);
+        request.transport_hint = UNSPEC;
+        ASSERT_TRUE(engine.submitTransfer(batch, {request}).ok());
+        TransferStatus status;
+        for (int i = 0; i < 1000; ++i) {
+            ASSERT_TRUE(engine.getTransferStatus(batch, status).ok());
+            if (status.s != PENDING) break;
+        }
+        EXPECT_EQ(status.s, COMPLETED);
+        EXPECT_EQ(rdma->submit_calls.load(), 1);
+        EXPECT_EQ(tcp->submit_calls.load(), 1);
+        ASSERT_TRUE(engine.freeBatch(batch).ok());
+        ASSERT_TRUE(engine.unregisterLocalMemory(buf.data(), buf.size()).ok());
+    }
+    auto rows = records();
+    checkPairs(rows, 1, "completed");
+    for (const auto& row : rows)
+        if (row["event"] == "complete") EXPECT_EQ(row["transport"], "tcp");
+}
