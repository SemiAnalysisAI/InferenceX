+class TransferEventTest : public ::testing::Test {
+   protected:
+    std::string directory;
+    std::string old_directory;
+    std::string old_capacity;
+    bool had_directory{false};
+    bool had_capacity{false};
+
+    void SetUp() override {
+        char path[] = "/tmp/tent-event-test-XXXXXX";
+        ASSERT_NE(mkdtemp(path), nullptr);
+        directory = path;
+        if (auto value = getenv("TENT_TRACE_DIR")) {
+            had_directory = true;
+            old_directory = value;
+        }
+        if (auto value = getenv("TENT_TRACE_BUFFER_RECORDS")) {
+            had_capacity = true;
+            old_capacity = value;
+        }
+        setenv("TENT_TRACE_DIR", directory.c_str(), 1);
+        unsetenv("TENT_TRACE_BUFFER_RECORDS");
+    }
+    void TearDown() override {
+        if (had_directory)
+            setenv("TENT_TRACE_DIR", old_directory.c_str(), 1);
+        else
+            unsetenv("TENT_TRACE_DIR");
+        if (had_capacity)
+            setenv("TENT_TRACE_BUFFER_RECORDS", old_capacity.c_str(), 1);
+        else
+            unsetenv("TENT_TRACE_BUFFER_RECORDS");
+        std::filesystem::remove_all(directory);
+    }
+    std::vector<json> records() {
+        std::vector<json> result;
+        for (const auto& file :
+             std::filesystem::directory_iterator(directory)) {
+            std::ifstream input(file.path());
+            std::string line;
+            while (std::getline(input, line))
+                result.push_back(json::parse(line));
+        }
+        return result;
+    }
+    void checkPairs(const std::vector<json>& rows, size_t count,
+                    const std::string& status) {
+        std::map<uint64_t, json> submitted, completed;
+        for (const auto& row : rows) {
+            if (row["event"] == "submit") {
+                EXPECT_TRUE(submitted.emplace(row["request_id"], row).second);
+            } else if (row["event"] == "complete") {
+                EXPECT_TRUE(completed.emplace(row["request_id"], row).second);
+                EXPECT_EQ(row["status"], status);
+            }
+        }
+        ASSERT_EQ(submitted.size(), count);
+        ASSERT_EQ(completed.size(), count);
+        for (const auto& [id, begin] : submitted) {
+            ASSERT_EQ(completed.count(id), 1);
+            const auto& end = completed.at(id);
+            EXPECT_EQ(begin["bytes"], end["bytes"]);
+            EXPECT_EQ(begin["batch_id"], end["batch_id"]);
+            EXPECT_EQ(begin["task_index"], end["task_index"]);
+            EXPECT_GE(end["monotonic_ns"].get<uint64_t>(),
+                      begin["monotonic_ns"].get<uint64_t>());
+            EXPECT_EQ(end["duration_ns"].get<uint64_t>(),
+                      end["monotonic_ns"].get<uint64_t>() -
+                          begin["monotonic_ns"].get<uint64_t>());
+        }
+    }
+};
