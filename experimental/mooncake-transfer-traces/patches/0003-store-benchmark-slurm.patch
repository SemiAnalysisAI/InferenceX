@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+# Shared initialization. sbatch copies scripts, so resolve from MOONCAKE_ROOT.
+set -euo pipefail
+: "${SLURM_JOB_ID:?Submit this script with sbatch}"
+export MOONCAKE_ROOT=${MOONCAKE_ROOT:-${SLURM_SUBMIT_DIR}}
+[[ -f "$MOONCAKE_ROOT/mooncake-store/benchmarks/store_kv_bench.py" ]] || {
+    echo 'Set MOONCAKE_ROOT to the absolute Mooncake checkout path.' >&2; exit 1;
+}
+export BUILD_DIR=${BUILD_DIR:-$MOONCAKE_ROOT/build}
+export PYTHON=${PYTHON:-python3}
+if [[ -n ${VENV_DIR:-} ]]; then
+    source "$VENV_DIR/bin/activate"
+fi
+export PYTHONUNBUFFERED=1
+export OMP_NUM_THREADS=${OMP_NUM_THREADS:-1}
+export RUN_DIR=${RESULT_ROOT:-$MOONCAKE_ROOT/benchmark-results}/${SLURM_JOB_ID}${SLURM_ARRAY_TASK_ID:+_$SLURM_ARRAY_TASK_ID}
+mkdir -p "$RUN_DIR"
+# Unique local scratch is created inside the srun task, never on the login node.
+export SLURM_BENCH_DIR=$MOONCAKE_ROOT/mooncake-store/benchmarks/slurm
+scontrol show job "$SLURM_JOB_ID" > "$RUN_DIR/slurm-job.txt"
+git -C "$MOONCAKE_ROOT" rev-parse HEAD > "$RUN_DIR/commit.txt"
+git -C "$MOONCAKE_ROOT" status --short > "$RUN_DIR/worktree.txt"
