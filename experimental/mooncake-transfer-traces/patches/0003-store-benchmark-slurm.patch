+++ b/mooncake-store/benchmarks/slurm/worker.sh
@@ -0,0 +1,172 @@
+#!/usr/bin/env bash
+set -euo pipefail
+mode=$1
+shift
+master_pid=
+scratch=$(mktemp -d "${SCRATCH_ROOT:-${SLURM_TMPDIR:-/tmp}}/mooncake-${SLURM_JOB_ID}.XXXXXX")
+cleanup() {
+    local rc=$?
+    trap - EXIT
+    if [[ -n $master_pid ]]; then
+        kill "$master_pid" 2>/dev/null || true
+        # Bound shutdown; only kill the process started by this worker.
+        for ((i=0; i<20; i++)); do
+            kill -0 "$master_pid" 2>/dev/null || break
+            sleep 0.1
+        done
+        kill -KILL "$master_pid" 2>/dev/null || true
+        wait "$master_pid" 2>/dev/null || true
+    fi
+    if [[ ${KEEP_SCRATCH:-0} != 1 ]]; then
+        rm -rf -- "$scratch"
+    fi
+    exit "$rc"
+}
+trap cleanup EXIT
+trap 'exit 143' TERM
+trap 'exit 130' INT
+exec > >(tee "$RUN_DIR/benchmark.log") 2>&1
+{
+    hostname
+    date -u
+    printf 'scratch=%s\nmode=%s\n' "$scratch" "$mode"
+    findmnt -T "$scratch"
+    lscpu
+} > "$RUN_DIR/host.txt"
+cd "$scratch"
+export MOONCAKE_HOST_ID
+MOONCAKE_HOST_ID=$(hostname)
+
+run() {
+    printf '%q ' "$@"
+    printf '\n'
+    "$@"
+}
+require_binary() {
+    [[ -x $1 ]] || { echo "Missing executable: $1 (build this checkout first)" >&2; exit 1; }
+}
+start_master() {
+    local master=${MASTER_BIN:-$BUILD_DIR/mooncake-store/src/mooncake_master}
+    require_binary "$master"
+    # Allocate three currently free ports; startup detects collisions/races.
+    read -r master_port metadata_port metrics_port < <("$PYTHON" - <<'PY'
+import socket
+sockets = [socket.socket() for _ in range(3)]
+for sock in sockets:
+    sock.bind(('127.0.0.1', 0))
+print(*(sock.getsockname()[1] for sock in sockets))
+PY
+)
+    "$master" --rpc_port="$master_port" --rpc_thread_num=4 \
+        --enable_http_metadata_server=true \
+        --http_metadata_server_host=127.0.0.1 \
+        --http_metadata_server_port="$metadata_port" \
+        --metrics_host=127.0.0.1 --metrics_port="$metrics_port" \
+        --enable_ha=false --enable_offload=false > "$RUN_DIR/master.log" 2>&1 &
+    master_pid=$!
+    "$PYTHON" - "$master_pid" "$master_port" "$metadata_port" <<'PY'
+import os
+import socket
+import sys
+import time
+pid, *ports = map(int, sys.argv[1:])
+deadline = time.monotonic() + 60
+while time.monotonic() < deadline:
+    os.kill(pid, 0)
+    try:
+        for port in ports:
+            with socket.create_connection(('127.0.0.1', port), timeout=0.5):
+                pass
+        break
+    except OSError:
+        time.sleep(0.2)
+else:
+    raise SystemExit('Master readiness timed out; inspect master.log')
+PY
+    kill -0 "$master_pid"
+}
+case "$mode" in
+    kv)
+        "$PYTHON" -c 'from mooncake.store import MooncakeDistributedStore, ReplicateConfig'
+        start_master
+        scenario=${SCENARIO:-verify_write}
+        # Count-bounded writes avoid accidentally filling node memory in a timed loop.
+        run "$PYTHON" "$MOONCAKE_ROOT/mooncake-store/benchmarks/store_kv_bench.py" \
+            --scenario "$scenario" --io-api "${IO_API:-plain}" \
+            --local-hostname 127.0.0.1 \
+            --metadata-server "http://127.0.0.1:$metadata_port/metadata" \
+            --master-server "127.0.0.1:$master_port" --protocol tcp \
+            --global-segment-size "${SEGMENT_BYTES:-8589934592}" \
+            --local-buffer-size "${BUFFER_BYTES:-268435456}" \
+            --nr-objects "${OBJECTS:-1024}" --write-objects "${WRITE_OBJECTS:-1024}" \
+            --value-size "${VALUE_BYTES:-131072}" --batch-size "${BATCH_SIZE:-16}" \
+            --numjobs "${NUMJOBS:-4}" --iodepth "${IODEPTH:-1}" \
+            --runtime "${RUNTIME:-0}" --memory-replica-num 1 --nof-replica-num 0 \
+            --key-prefix "j${SLURM_JOB_ID}_" --key-size 64 \
+            --verify --pattern 0xab --output-dir "$RUN_DIR/kv" "$@"
+        # Some performance scenarios return 0 even with failed KV operations.
+        "$PYTHON" - "$RUN_DIR/kv/summary.json" <<'PY'
+import json
+import sys
+with open(sys.argv[1]) as stream:
+    result = json.load(stream)
+if not result['ok']:
+    raise SystemExit('KV errors recorded; inspect summary.json and journal.jsonl')
+PY
+        ;;
+    micro)
+        benchmark=${BENCHMARK:-allocation_strategy_bench}
+        binary=$BUILD_DIR/mooncake-store/benchmarks/$benchmark
+        require_binary "$binary"
+        case "$benchmark" in
+            allocation_strategy_bench)
+                run "$binary" --workload=size_class_churn --segment_capacity=1024 \
+                    --num_allocations=10000 --prefill_pct=70 "$@" ;;
+            offset_allocator_concurrency_bench)
+                run "$binary" --threads="${SLURM_CPUS_PER_TASK:-16}" "$@" ;;
+            storage_backend_bench)
+                run "$binary" --storage_path="$scratch/backend" --capacity_gb=4 \
+                    --num_operations=100 --warmup_operations=10 \
+                    --num_threads="${SLURM_CPUS_PER_TASK:-16}" "$@" ;;
+            file_interface_bench)
+                run "$binary" --file "$scratch/file.dat" "$@" ;;
+            uring_batch_read_bench)
+                run "$binary" "$scratch/uring.dat" "$@" ;;
+            master_bench)
+                start_master
+                run "$binary" --master_server="127.0.0.1:$master_port" \
+                    --num_clients=4 --num_threads=1 --duration=30 "$@" ;;
+            batch_get_replica_bench)
+                start_master
+                run "$binary" --master_server="127.0.0.1:$master_port" \
+                    --num_objects=100000 --prefill_threads=4 --lookup_threads=8 \
+                    --batch_size=128 --duration=30 --cycles=1 \
+                    --csv_path="$RUN_DIR/replica.csv" "$@" ;;
+            allocator_bench|batch_evict_bench|batch_oplog_promotion_bench)
+                run "$binary" "$@" ;;
+            *) echo "Unsupported benchmark: $benchmark; see README.md" >&2; exit 2 ;;
+        esac
+        ;;
+    trace)
+        scenario=${SCENARIO:-toolagent}
+        trace_dir=${TRACE_DIR:-$MOONCAKE_ROOT/FAST25-release/traces}
+        case "$scenario" in
+            conversation|synthetic|toolagent) scenarios=("$scenario") ;;
+            all) scenarios=(conversation synthetic toolagent) ;;
+            *) echo "Unknown trace scenario: $scenario" >&2; exit 2 ;;
+        esac
+        for item in "${scenarios[@]}"; do
+            [[ -s "$trace_dir/${item}_trace.jsonl" ]] || {
+                echo "Missing trace: $trace_dir/${item}_trace.jsonl" >&2; exit 1;
+            }
+        done
+        cd "$MOONCAKE_ROOT/benchmarks/storage_benchmark_v1"
+        run "$PYTHON" benchmark.py --trace-dir "$trace_dir" --scenario "$scenario" \
+            --storage-dir "$scratch/trace" --model "${MODEL:-glm5}" \
+            --threads "${THREADS:-1}" --max-pages "${MAX_PAGES:-128}" \
+            --max-requests "${MAX_REQUESTS:-100}" --file-mode "${FILE_MODE:-single}" \
+            --fsync-mode "${FSYNC_MODE:-none}" --replay-scales "${REPLAY_SCALES:-0}" \
+            --progress-interval 0 "$@"
+        ;;
+    *) echo "Unknown mode: $mode" >&2; exit 2 ;;
+esac
