 vllm/model_executor/models/qwen2.py           |  9 +++++--
 vllm/models/deepseek_v4/nvidia/model.py       |  8 ++++--
 vllm/models/kimi_k3/nvidia/model.py           |  9 +++++--
 6 files changed, 54 insertions(+), 20 deletions(-)

