 pkg/amdgpu/gpuagent/gpuagent.go               |  32 +++
 .../gpuagent/gpuagent_cache_ttl_test.go       | 185 ++++++++++++++++++
 pkg/amdgpu/gpuagent/gpuagent_gpu.go           |   8 +-
 pkg/exporter/exporter.go                      |  10 +
 pkg/exporter/exporter_test.go                 |  16 ++
 6 files changed, 258 insertions(+), 3 deletions(-)
 create mode 100644 pkg/amdgpu/gpuagent/gpuagent_cache_ttl_test.go

