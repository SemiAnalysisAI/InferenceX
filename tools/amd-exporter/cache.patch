 		enableGPUMonitoring:    true,
 		enableIFOEMonitoring:   false,
+		gpuGetCacheTTL:         DefaultGPUGetCacheTTL,
 	}
 	for _, o := range opts {
 		o(ga)
diff --git a/pkg/amdgpu/gpuagent/gpuagent_cache_ttl_test.go b/pkg/amdgpu/gpuagent/gpuagent_cache_ttl_test.go
new file mode 100644
index 0000000..776b330
--- /dev/null
+++ b/pkg/amdgpu/gpuagent/gpuagent_cache_ttl_test.go
@@ -0,0 +1,185 @@
