+// Copyright (c) Advanced Micro Devices, Inc. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package gpuagent
+
+import (
+	"fmt"
+	"os"
+	"time"
+)
+
+const (
+	gpuGetCacheTTLEnv     = "AMD_GPU_GET_CACHE_TTL"
+	defaultGPUGetCacheTTL = time.Second
+)
+
+// GPUGetCacheTTLFromEnv resolves the startup setting shared by the exporter
+// entrypoint and GPU client construction. It does not cache the environment.
+func GPUGetCacheTTLFromEnv() (time.Duration, error) {
+	return parseGPUGetCacheTTL(os.Getenv(gpuGetCacheTTLEnv))
+}
+
+func parseGPUGetCacheTTL(value string) (time.Duration, error) {
+	if value == "" {
+		return defaultGPUGetCacheTTL, nil
+	}
+	ttl, err := time.ParseDuration(value)
+	if err != nil {
+		return 0, fmt.Errorf("%s=%q: expected a non-negative duration: %w", gpuGetCacheTTLEnv, value, err)
+	}
+	if ttl < 0 {
+		return 0, fmt.Errorf("%s=%q: duration must not be negative", gpuGetCacheTTLEnv, value)
+	}
+	return ttl, nil
+}
