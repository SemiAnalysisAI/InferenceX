@@ -0,0 +1,186 @@
+// Copyright (c) Advanced Micro Devices, Inc. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package gpuagent
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/ROCm/device-metrics-exporter/pkg/amdgpu/gen/amdgpu"
+	"github.com/ROCm/device-metrics-exporter/pkg/amdgpu/mock_gen"
+	"github.com/ROCm/device-metrics-exporter/pkg/exporter/logger"
+	"go.uber.org/mock/gomock"
+)
+
+func TestParseGPUGetCacheTTL(t *testing.T) {
+	for _, tc := range []struct {
+		value string
+		want  time.Duration
+		bad   bool
+	}{
+		{"", time.Second, false},
+		{"15s", 15 * time.Second, false},
+		{"1s", time.Second, false},
+		{"500ms", 500 * time.Millisecond, false},
+		{"0s", 0, false},
+		{"0", 0, false},
+		{"-1s", 0, true},
+		{"1", 0, true},
+		{"invalid", 0, true},
+		{"999999999999999999999s", 0, true},
+	} {
+		t.Run(tc.value, func(t *testing.T) {
+			got, err := parseGPUGetCacheTTL(tc.value)
+			if (err != nil) != tc.bad || got != tc.want {
+				t.Fatalf("parse(%q) = %v, %v; want %v, error=%v", tc.value, got, err, tc.want, tc.bad)
+			}
+			if err != nil && !strings.Contains(err.Error(), gpuGetCacheTTLEnv) {
+				t.Fatalf("error does not identify the setting: %v", err)
+			}
+		})
+	}
+}
+
+func TestGPUGetCacheTTLFromEnvironment(t *testing.T) {
+	logger.Init(true)
+	for _, value := range []string{"", "1s", "0s", "bad", "-1s"} {
+		t.Run(value, func(t *testing.T) {
+			t.Setenv(gpuGetCacheTTLEnv, value)
+			want, wantErr := parseGPUGetCacheTTL(value)
+			ga, err := NewGPUAgentGPUClient(&GPUAgentClient{})
+			if wantErr != nil {
+				if err == nil || ga != nil {
+					t.Fatal("invalid TTL must reject client construction")
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer ga.Close()
+			if ga.gpuGetCacheTTL != want {
+				t.Fatalf("client TTL = %v, want %v", ga.gpuGetCacheTTL, want)
+			}
+		})
+	}
+}
+
+func newCacheTestClient(t *testing.T, ttl time.Duration) (*GPUAgentGPUClient, *mock_gen.MockGPUSvcClient) {
+	t.Helper()
+	logger.Init(true)
+	client := mock_gen.NewMockGPUSvcClient(gomock.NewController(t))
+	return &GPUAgentGPUClient{
+		gpuclient:      client,
+		gpuHandler:     &GPUAgentClient{ctx: context.Background()},
+		gCache:         &gpuCache{},
+		gpuGetCacheTTL: ttl,
+	}, client
+}
+
+func TestGPUGetCacheReadTTL(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		ttl  time.Duration
+		age  time.Duration
+		hit  bool
+	}{
+		{"legacy TTL retains two-second-old response", 15 * time.Second, 2 * time.Second, true},
+		{"default expires two-second-old response", defaultGPUGetCacheTTL, 2 * time.Second, false},
+		{"one second expires two-second-old response", time.Second, 2 * time.Second, false},
+		{"fresh response", time.Second, 0, true},
+		{"zero bypasses fresh response", 0, 0, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ga, client := newCacheTestClient(t, tc.ttl)
+			old := &amdgpu.GPUGetResponse{ApiStatus: amdgpu.ApiStatus_API_STATUS_OK}
+			fresh := &amdgpu.GPUGetResponse{}
+			slot := &ga.gCache.metricsCache
+			slot.resp, slot.ts = old, time.Now().Add(-tc.age)
+			filter := &amdgpu.GPUGetFilter{SkipProcessStatus: true}
+			want := old
+			if !tc.hit {
+				client.EXPECT().GPUGet(gomock.Any(), &amdgpu.GPUGetRequest{Filter: filter}).Return(fresh, nil).Times(1)
+				want = fresh
+			}
+			got, err := ga.cacheRead(filter, slot)
+			if err != nil || got != want || slot.resp != want {
+				t.Fatalf("cacheRead = %p, %v; want %p", got, err, want)
+			}
+		})
+	}
+}
+
+func TestGPUGetCacheReadErrorClearsResponse(t *testing.T) {
+	ga, client := newCacheTestClient(t, time.Second)
+	slot := &ga.gCache.metricsCache
+	slot.resp, slot.ts = &amdgpu.GPUGetResponse{}, time.Now().Add(-2*time.Second)
+	readErr := errors.New("GPUGet failed")
+	fresh := &amdgpu.GPUGetResponse{}
+	gomock.InOrder(
+		client.EXPECT().GPUGet(gomock.Any(), gomock.Any()).Return(nil, readErr),
+		client.EXPECT().GPUGet(gomock.Any(), gomock.Any()).Return(fresh, nil),
+	)
+	got, err := ga.cacheRead(nil, slot)
+	if !errors.Is(err, readErr) || got != nil || slot.resp != nil {
+		t.Fatalf("failed read retained a response: %v, %v", got, err)
+	}
+	got, err = ga.cacheRead(nil, slot)
+	if err != nil || got != fresh {
+		t.Fatalf("retry = %v, %v", got, err)
+	}
+}
+
+func TestGPUGetCacheReadConcurrent(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		ttl   time.Duration
+		calls int
+	}{
+		{"reuse", 15 * time.Second, 1},
+		{"bypass", 0, 16},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ga, client := newCacheTestClient(t, tc.ttl)
+			fresh := &amdgpu.GPUGetResponse{}
+			client.EXPECT().GPUGet(gomock.Any(), gomock.Any()).Return(fresh, nil).Times(tc.calls)
+			start := make(chan struct{})
+			var wg sync.WaitGroup
+			for i := 0; i < 16; i++ {
+				wg.Add(1)
+				go func() {
+					defer wg.Done()
+					<-start
+					got, err := ga.cacheRead(nil, &ga.gCache.metricsCache)
+					if err != nil || got != fresh {
+						t.Errorf("concurrent read = %v, %v", got, err)
+					}
+				}()
+			}
+			close(start)
+			wg.Wait()
+		})
+	}
+}
+
+func TestGPUGetCacheReadSeparateSlots(t *testing.T) {
+	ga, client := newCacheTestClient(t, time.Second)
+	metrics, npd := &amdgpu.GPUGetResponse{}, &amdgpu.GPUGetResponse{}
+	filter := &amdgpu.GPUGetFilter{SkipProcessStatus: true}
+	gomock.InOrder(
+		client.EXPECT().GPUGet(gomock.Any(), &amdgpu.GPUGetRequest{}).Return(metrics, nil),
+		client.EXPECT().GPUGet(gomock.Any(), &amdgpu.GPUGetRequest{Filter: filter}).Return(npd, nil),
+	)
+	for i := 0; i < 2; i++ {
+		if got, err := ga.cacheRead(nil, &ga.gCache.metricsCache); err != nil || got != metrics {
+			t.Fatalf("metrics slot = %v, %v", got, err)
+		}
+		if got, err := ga.cacheRead(filter, &ga.gCache.npdCache); err != nil || got != npd {
+			t.Fatalf("NPD slot = %v, %v", got, err)
+		}
+	}
+}
