@@ -0,0 +1,35 @@
+// Copyright (c) Advanced Micro Devices, Inc. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+package gpuagent
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/ROCm/device-metrics-exporter/pkg/amdgpu/gen/amdgpu"
+	"github.com/ROCm/device-metrics-exporter/pkg/amdgpu/mock_gen"
+	"github.com/ROCm/device-metrics-exporter/pkg/exporter/logger"
+	"go.uber.org/mock/gomock"
+)
+
+func TestDefaultGPUGetDoesNotReuseTwoSecondOldReading(t *testing.T) {
+	logger.Init(true)
+	t.Setenv("AMD_GPU_GET_CACHE_TTL", "")
+	ga, err := NewGPUAgentGPUClient(&GPUAgentClient{ctx: context.Background()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ga.Close()
+	client := mock_gen.NewMockGPUSvcClient(gomock.NewController(t))
+	ga.gpuclient = client
+	old, fresh := &amdgpu.GPUGetResponse{}, &amdgpu.GPUGetResponse{}
+	slot := &ga.gCache.metricsCache
+	slot.resp, slot.ts = old, time.Now().Add(-2*time.Second)
+	client.EXPECT().GPUGet(gomock.Any(), gomock.Any()).Return(fresh, nil).Times(1)
+	got, err := ga.cacheRead(nil, slot)
+	if err != nil || got != fresh {
+		t.Fatalf("read = %p, %v; want fresh %p", got, err, fresh)
+	}
+}
