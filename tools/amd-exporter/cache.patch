@@ -50,6 +51,7 @@ type GPUAgentClient struct {
 	enableSriov          bool
 	exitOnAgentDown      bool // exit DME process when agent is unreachable
 	exitOnRocpctlError   bool // exit DME process when rocpctl auto-disables on failure
