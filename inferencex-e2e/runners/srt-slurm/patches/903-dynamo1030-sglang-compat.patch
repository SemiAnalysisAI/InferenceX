+"""Let Dynamo 1.7.0.dev20261030 run on SGLang after sglang#48087.
+
+Put this directory on PYTHONPATH. Every Python process then:
+- imports logging.config, which sglang's log_utils uses without importing;
+- re-exports MultimodalProcessorOutput from schedule_batch once that module
+  loads, since Dynamo 1030 imports it there and sglang#48087 moved it to req_types.
+"""
+
+import importlib
+import importlib.abc
+import logging.config  # noqa: F401
+import sys
+
+_TARGET = "sglang.srt.managers.schedule_batch"
+
+
+class _ReExportFinder(importlib.abc.MetaPathFinder):
+    def find_spec(self, name, path, target=None):
+        if name != _TARGET:
+            return None
+        for finder in sys.meta_path:
+            if finder is self:
+                continue
+            spec = finder.find_spec(name, path, target) if hasattr(finder, "find_spec") else None
+            if spec is not None and spec.loader is not None:
+                exec_module = spec.loader.exec_module
+
+                def _exec(module, _exec_module=exec_module):
+                    _exec_module(module)
+                    if not hasattr(module, "MultimodalProcessorOutput"):
+                        req_types = importlib.import_module("sglang.srt.managers.req_types")
+                        module.MultimodalProcessorOutput = req_types.MultimodalProcessorOutput
+
+                spec.loader.exec_module = _exec
+                return spec
+        return None
+
+
+sys.meta_path.insert(0, _ReExportFinder())
