@@ -240,3 +242,21 @@ def test_role_connector_selects_discovery_over_engine_default() -> None:
     mori, cpu = result["kv_connector_extra_config"]["connectors"]
     assert mori["kv_connector_extra_config"]["host_ip"] == "10.0.0.2"
     assert cpu["kv_connector"] == "SimpleCPUOffloadConnector"
+
+
+@pytest.mark.parametrize("mode", ["prefill", "decode"])
+def test_explicit_moriio_registration_preserves_offload_and_ports(mode):
+    template = _template()
+    template["kv_connector_extra_config"]["connectors"][0]["kv_role"] = (
+        "kv_producer" if mode == "prefill" else "kv_consumer"
+    )
+    command = _command(template, mode=mode, environment={"SRT_MORIIO_EXPLICIT_REGISTRATION": "1"})
+    transfer = json.loads(command[command.index("--kv-transfer-config") + 1])
+    connectors = transfer["kv_connector_extra_config"]["connectors"]
+    mori = connectors[0]["kv_connector_extra_config"]
+    assert "proxy_ip" not in mori and "proxy_ping_port" not in mori
+    assert mori["host_ip"] == "10.0.0.2"
+    assert mori["handshake_port"] == "26008"
+    assert mori["notify_port"] == "27008"
+    assert mori["read_mode"] is True
+    assert connectors[1]["kv_connector"] == "SimpleCPUOffloadConnector"
