@@ -0,0 +1,141 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 LayerScale, Inc. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+
+"""LayerScale's own OpenAI server for one single-node aggregate worker."""
+
+from __future__ import annotations
+
+import builtins
+from collections.abc import Mapping, Sequence
+from dataclasses import field
+from pathlib import Path
+from typing import TYPE_CHECKING, Any, ClassVar, Literal
+
+from marshmallow import Schema
+from marshmallow_dataclass import dataclass
+
+from srtctl.backends.base import Backend, BoundRolesField, ProcessGroup, RoleSettings, WorkerMode
+from srtctl.ports import DYN_SYSTEM_PORT_BASE
+
+if TYPE_CHECKING:
+    from srtctl.core.runtime import RuntimeContext
+    from srtctl.core.schema import ProfilingConfig
+    from srtctl.core.topology import Endpoint, NodePortAllocator, Process
+
+# The image's ENTRYPOINT; srtctl starts every step with --no-container-entrypoint.
+LOADER = "/app/layerscale-loader"
+
+
+def _flag_args(config: Mapping[str, Any]) -> list[str]:
+    """``--key value`` for each argument: ``True`` is a bare flag, ``False``/``None`` are left out."""
+    args: list[str] = []
+    for key, value in config.items():
+        flag = f"--{key}"
+        if value is True:
+            args.append(flag)
+        elif value is not False and value is not None:
+            for item in value if isinstance(value, list) else [value]:
+                args.extend([flag, str(item)])
+    return args
+
+
+@dataclass(frozen=True)
+class LayerScaleBackend(Backend):
+    """Launch ``layerscale serve`` from the LayerScale image.
+
+    Example YAML:
+        engine: layerscale
+        frontend:
+          type: layerscale
+        roles:
+          agg:
+            args:
+              tp: 1
+              ctx: 262144
+              speculative-algorithm: mtp
+    """
+
+    # Engine type discriminator.
+    type: Literal["layerscale"] = "layerscale"
+    # The loader replaces itself with the engine, whose argv[0] is `layerscale`.
+    process_exporter_groups: ClassVar[tuple[ProcessGroup, ...]] = (
+        ProcessGroup("layerscale", cmdline=(r"^layerscale serve ",)),
+    )
+    # The roles this engine runs (`roles.<role>` of the recipe), bound by SrtConfig and
+    # never written on `engine:`. The agg role's env and args are read from here.
+    roles: Mapping[str, RoleSettings] = field(default_factory=dict, metadata={"marshmallow_field": BoundRolesField()})
+
+    Schema: ClassVar[builtins.type[Schema]] = Schema
+
+    def allocate_endpoints(
+        self,
+        num_prefill: int,
+        num_decode: int,
+        num_agg: int,
+        gpus_per_prefill: int,
+        gpus_per_decode: int,
+        gpus_per_agg: int,
+        gpus_per_node: int,
+        available_nodes: Sequence[str],
+        spread_workers: bool = False,
+        gpu_indices_by_mode: Mapping[WorkerMode, Sequence[frozenset[int]]] | None = None,
+    ) -> list[Endpoint]:
+        from srtctl.core.topology import allocate_endpoints
+
+        return allocate_endpoints(
+            num_prefill=num_prefill,
+            num_decode=num_decode,
+            num_agg=num_agg,
+            gpus_per_prefill=gpus_per_prefill,
+            gpus_per_decode=gpus_per_decode,
+            gpus_per_agg=gpus_per_agg,
+            gpus_per_node=gpus_per_node,
+            available_nodes=available_nodes,
+            spread_workers=spread_workers,
+            gpu_indices_by_mode=gpu_indices_by_mode,
+        )
+
+    def endpoints_to_processes(
+        self,
+        endpoints: list[Endpoint],
+        base_sys_port: int = DYN_SYSTEM_PORT_BASE,
+        port_allocator: NodePortAllocator | None = None,
+        frontend_type: str = "layerscale",
+        dynamo_sidecar: bool = False,
+    ) -> list[Process]:
+        from srtctl.core.topology import endpoints_to_processes
+
+        if dynamo_sidecar:
+            raise ValueError("LayerScale does not support Dynamo sidecars")
+        if any(ep.mode != "agg" or len(ep.nodes) != 1 for ep in endpoints):
+            raise ValueError("LayerScale supports single-node aggregate workers only")
+        return endpoints_to_processes(endpoints, base_sys_port=base_sys_port, port_allocator=port_allocator)
+
+    def build_worker_command(
+        self,
+        process: Process,
+        endpoint_processes: list[Process],
+        runtime: RuntimeContext,
+        frontend_type: str = "layerscale",
+        nsys_prefix: list[str] | None = None,
+        dump_config_path: Path | None = None,
+        profiling: ProfilingConfig | None = None,
+    ) -> list[str]:
+        from srtctl.frontends import get_frontend
+
+        if process.endpoint_mode != "agg" or len({p.node for p in endpoint_processes}) != 1:
+            raise ValueError("LayerScale supports single-node aggregate workers only")
+        config = self.get_config_for_mode("agg")
+        if "model" in config:
+            raise ValueError("srtctl supplies the model; drop roles.agg.args.model")
+        public = get_frontend(frontend_type).worker_api_port("agg") == "public"
+        port = runtime.frontend_port if public else process.http_port
+        return [
+            *(nsys_prefix or []),
+            LOADER,
+            "serve",
+            f"0.0.0.0:{port}",
+            "--model",
+            runtime.worker_model_arg,
+            *_flag_args(config),
+        ]
