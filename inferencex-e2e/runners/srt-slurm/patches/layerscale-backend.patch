diff --git a/src/srtctl/frontends/layerscale.py b/src/srtctl/frontends/layerscale.py
new file mode 100644
index 00000000..00d91191
--- /dev/null
+++ b/src/srtctl/frontends/layerscale.py
@@ -0,0 +1,100 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 LayerScale, Inc. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+
+"""Direct LayerScale frontend (`frontend.type: layerscale`).
+
+For one aggregate LayerScale worker the OpenAI-compatible HTTP server is the
+worker process itself (`layerscale serve` bound to the public port). No router
+process starts.
+"""
+
+from __future__ import annotations
+
+import logging
+import threading
+from typing import TYPE_CHECKING, Any, ClassVar, Literal
+
+from srtctl.core.health import WorkerHealthResult, probe_direct_server
+from srtctl.frontends.base import Frontend, agg_leader_nodes, register_frontend
+
+if TYPE_CHECKING:
+    from srtctl.core.processes import ManagedProcess
+    from srtctl.core.runtime import RuntimeContext
+    from srtctl.core.topology import Process
+
+logger = logging.getLogger(__name__)
+
+
+@register_frontend("layerscale")
+class LayerScaleFrontend(Frontend):
+    """Direct LayerScale OpenAI server frontend.
+
+    Exactly one aggregate worker, which binds the public port itself. Readiness
+    is the worker's ``/health`` plus ``/v1/models``.
+    """
+
+    required_backend: ClassVar[str | None] = "layerscale"
+
+    @property
+    def type(self) -> str:
+        return "layerscale"
+
+    def worker_api_port(self, mode: str) -> Literal["public", "allocated"]:
+        """The one ``layerscale serve`` is the endpoint, so it binds the public port."""
+        return "public"
+
+    def worker_metrics_port(self, process: Process, runtime: RuntimeContext) -> int | None:
+        """The aggregate leader serves ``/metrics`` on the public port."""
+        if process.endpoint_mode == "agg" and process.is_leader:
+            return runtime.frontend_port
+        return None
+
+    def worker_endpoint_port(self, process: Process, config: Any, runtime: RuntimeContext) -> int | None:
+        return runtime.frontend_port if process.is_leader else None
+
+    def profiling_control_port(self, process: Process, config: Any, runtime: RuntimeContext) -> int | None:
+        """LayerScale serves no profiler control routes."""
+        return None
+
+    def direct_endpoint_nodes(self, processes: list[Process]) -> list[str]:
+        return agg_leader_nodes(processes)
+
+    def worker_ready_port(self, process: Process) -> int:
+        return process.sys_port
+
+    def probe_ready(
+        self, host: str, port: int, expected_prefill: int, expected_decode: int, config: Any
+    ) -> WorkerHealthResult:
+        """The worker's own /health, then /v1/models must list the model."""
+        return probe_direct_server(host, port)
+
+    def validate(self, config: Any) -> None:
+        """One aggregate ``layerscale serve`` owns the public port; there is no router to balance replicas."""
+        if config.frontend.enable_multiple_frontends:
+            raise ValueError(
+                "frontend.type: layerscale binds layerscale serve directly; set frontend.enable_multiple_frontends: false"
+            )
+        if config.topology.is_disaggregated or config.topology.num_agg != 1:
+            raise ValueError("frontend.type: layerscale supports exactly one aggregate worker")
+        if config.dynamo.sidecar:
+            raise ValueError("frontend.type: layerscale does not support dynamo.sidecar")
+
+    def start_frontends(
+        self,
+        topology: Any,
+        runtime: RuntimeContext,
+        config: Any,
+        backend: Any,
+        backend_processes: list[Process],
+        stop_event: threading.Event | None = None,
+    ) -> list[ManagedProcess]:
+        if topology.uses_nginx or len(topology.frontend_nodes) != 1:
+            raise ValueError(
+                "frontend.type: layerscale binds layerscale serve directly to the public port; "
+                "set frontend.enable_multiple_frontends: false"
+            )
+        logger.info(
+            "frontend.type=layerscale: no separate frontend process; layerscale serve owns port %d",
+            topology.public_port,
+        )
+        return []
