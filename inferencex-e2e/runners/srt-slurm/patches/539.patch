+def _file_version(stat: os.stat_result) -> tuple[int, int, int]:
+    return stat.st_ino, stat.st_size, stat.st_mtime_ns
+
+
+@dataclass
+class _CaptureUpload:
+    source: BinaryIO
+    version: tuple[int, int, int]
+    generation: str
+    offset: int = 0
+    pending: bytes | None = None
