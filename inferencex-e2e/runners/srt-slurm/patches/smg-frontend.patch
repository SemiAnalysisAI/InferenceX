diff --git a/examples/sglang/smg-disagg.yaml b/examples/sglang/smg-disagg.yaml
new file mode 100644
index 00000000..7ae710d9
--- /dev/null
+++ b/examples/sglang/smg-disagg.yaml
@@ -0,0 +1,63 @@
+# SGLang disaggregated prefill/decode behind the Shepherd Model Gateway (SMG).
+#
+# One TP1 prefill worker and one TP1 decode worker sharing a node (`nodes: colocate`
+# places decode on the prefill node's spare GPUs). srtctl adds `--disaggregation-mode`
+# and the prefill bootstrap port; SMG is launched with `--pd-disaggregation`, gets the
+# prefill URL with that bootstrap port, and pairs each request across the two workers.
+# SMG runs from its own image (`frontend.container_image`).
+#
+# Aliases (`qwen3-0.6b`, `sglang`, `smg`) resolve through srtslurm.yaml; see examples/README.md.
+
+schema: 2
+name: "qwen3-0.6b-sglang-smg-disagg"
+
+slurm:
+  time_limit: "00:30:00"
+
+model:
+  path: "qwen3-0.6b"
+  container: "sglang"
+  precision: "bf16"
+
+resources:
+  gpu_type: "h100"
+  gpus_per_node: 8
+frontend:
+  type: smg
+  container_image: smg
+  enable_multiple_frontends: false
+  args:
+    policy: "cache_aware"
+
+engine: sglang
+roles:
