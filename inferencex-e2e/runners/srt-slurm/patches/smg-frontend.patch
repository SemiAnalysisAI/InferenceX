@@ -0,0 +1,57 @@
+# TRT-LLM aggregated behind the Shepherd Model Gateway (SMG).
+#
+# Two TP1 `trtllm-serve` workers on one node, each on its own allocated port;
+# SMG receives them through `--worker-urls` and routes with its cache-aware
+# policy. `frontend.type: trtllm_serve` aggregate mode allows one worker only.
+# No Dynamo, NATS, or etcd. SMG runs from its own image (`frontend.container_image`).
+#
+# Aliases (`qwen3-0.6b`, `trtllm`, `smg`) resolve through srtslurm.yaml; see examples/README.md.
+
+schema: 2
+name: "qwen3-0.6b-trtllm-smg-agg"
+
+slurm:
+  time_limit: "00:30:00"
+
+model:
+  path: "qwen3-0.6b"
+  container: "trtllm"
+  precision: "bf16"
+
+resources:
+  gpu_type: "h100"
+  gpus_per_node: 8
+frontend:
+  type: smg
+  container_image: smg
+  enable_multiple_frontends: false
+  args:
+    policy: "cache_aware"
+
+engine:
+  type: trtllm
+  # API model name shared by the workers, SMG, and the benchmark client.
+  served_model_name: "Qwen/Qwen3-0.6B"
+roles:
+  agg:
+    nodes: 1
+    workers: 2
+    gpus: 1
+    env:
+      PYTHONUNBUFFERED: "1"
+      TLLM_LOG_LEVEL: "INFO"
+    args:
+      backend: "pytorch"
+      tensor_parallel_size: 1
+      max_batch_size: 64
+      max_num_tokens: 8192
+      max_seq_len: 4096
+      trust_remote_code: true
+      kv_cache_config:
+        free_gpu_memory_fraction: 0.5
+
+benchmark:
+  type: "sa-bench"
+  isl: 128
+  osl: 128
+  concurrencies: "4x8"
