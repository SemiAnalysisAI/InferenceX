+    def discovers_workers(self, backend: Any) -> bool:
+        return backend.discovers_workers()
+
+    def build_bash_preamble(self, config: Any) -> str:
+        return "python3 -m venv /tmp/smg-router-venv && /tmp/smg-router-venv/bin/pip install --disable-pip-version-check smg==1.13.0"
+
+    def start_frontends(self, topology, runtime, config, backend, backend_processes, stop_event=None):
+        if not backend.discovers_workers():
+            return super().start_frontends(topology, runtime, config, backend, backend_processes, stop_event)
+        from srtctl.core.slurm import get_hostname_ip
+
+        specs = []
+        for process in backend_processes:
+            if process.http_port <= 0:
+                continue
+            host = get_hostname_ip(process.node, runtime.network_interface)
+            role = process.endpoint_mode
+            specs.append(
+                {
+                    "url": f"http://{host}:{process.http_port}",
+                    "worker_type": role,
+                    "runtime_type": "vllm",
+                    "connection_mode": "http",
+                    "kv_connector": "MoRIIOConnector",
+                    "kv_role": "kv_producer" if role == "prefill" else "kv_consumer",
+                    "labels": {
+                        "moriio_mode": "read",
+                        "moriio_host": host,
+                        "moriio_handshake_port": str(process.moriio_handshake_port),
+                        "moriio_notify_port": str(process.moriio_notify_port),
+                        "tp_size": str(len(process.gpu_indices)),
+                    },
+                }
+            )
+        (runtime.log_dir / "smg-workers.json").write_text(json.dumps(specs))
+        args = {
+            **config.frontend.args,
+            "moriio-workers": str(runtime.container_log_dir / "smg-workers.json"),
+            "enable-igw": True,
+        }
+        updated = replace(config, frontend=replace(config.frontend, args=args))
+        return super().start_frontends(topology, runtime, updated, backend, backend_processes, stop_event)
+
+    def build_router_command(self, workers, host, port, backend):
