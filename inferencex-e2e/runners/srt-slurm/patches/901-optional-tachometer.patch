diff --git a/tests/test_tachometer_optional.py b/tests/test_tachometer_optional.py
new file mode 100644
index 00000000..d9b4c473
--- /dev/null
+++ b/tests/test_tachometer_optional.py
@@ -0,0 +1,75 @@
+from dataclasses import replace
+import os
+from pathlib import Path
+import platform
+import shutil
+import subprocess
+
+import pytest
+
+from srtctl.cli.submit import validate_setup
+from srtctl.core.schema import BenchmarkConfig, ModelConfig, ResourceConfig, SrtConfig
+
+
+@pytest.mark.parametrize("enabled", [False, True, None])
+@pytest.mark.parametrize("missing_uv", [False, True])
+def test_missing_tachometer_allowed_only_for_explicit_opt_out(tmp_path, enabled, missing_uv):
+    (tmp_path / "configs").mkdir()
+    (tmp_path / "configs/nats-server").touch()
+    (tmp_path / "configs/etcd").touch()
+    (tmp_path / "bin").mkdir()
+    if not missing_uv:
+        (tmp_path / "bin/uv").touch()
+    config = SrtConfig(
+        name="test",
+        model=ModelConfig(path="/model", container="/image", precision="fp8"),
+        resources=ResourceConfig(gpu_type="h200"),
+        benchmark=BenchmarkConfig(type="manual"),
+    )
+    config = replace(
+        config,
+        observability=replace(
+            config.observability,
+            enabled=False,
+            tachometer=replace(config.observability.tachometer, enabled=enabled),
+        ),
+    )
+    if enabled is False and not missing_uv:
+        validate_setup(tmp_path, config)
+    else:
+        with pytest.raises(SystemExit):
+            validate_setup(tmp_path, config)
+
+
+@pytest.mark.parametrize("enabled", ["false", "true", None])
+def test_make_setup_skips_process_exporter_only_when_disabled(tmp_path, enabled):
+    shutil.copy(Path(__file__).parents[1] / "Makefile", tmp_path / "Makefile")
+    (tmp_path / "configs").mkdir()
+    (tmp_path / "bin").mkdir()
+    for name in ["configs/nats-server", "configs/etcd", "configs/etcdctl", "bin/uv"]:
+        shutil.copy("/bin/true", tmp_path / name)
+    (tmp_path / "srtslurm.yaml").touch()
+    wget = tmp_path / "bin/wget"
+    wget.write_text("#!/bin/sh\nexit 1\n")
+    wget.chmod(0o755)
+    file_probe = tmp_path / "bin/file"
+    file_probe.write_text("#!/bin/sh\necho 'ELF x86-64 aarch64'\n")
+    file_probe.chmod(0o755)
+    argv = [
+        "make", "setup", f"ARCH={platform.machine()}",
+        "--assume-old=tachometer-scraper-download",
+        "--assume-old=cpu-power-exporter-setup",
+        "--assume-old=otel-collector-download",
+    ]
+    if enabled is not None:
+        argv.append(f"TACHOMETER_ENABLED={enabled}")
+    result = subprocess.run(
+        argv, cwd=tmp_path, capture_output=True, text=True, timeout=10,
+        env={**os.environ, "PATH": f"{tmp_path / 'bin'}:{os.environ['PATH']}"},
+    )
+    assert (result.returncode == 0) is (enabled == "false"), result.stdout + result.stderr
+    if enabled == "false":
+        assert "Skipping process-exporter" in result.stdout
+        assert "uv already installed" in result.stdout
+    else:
+        assert "Failed to download process-exporter" in result.stdout
