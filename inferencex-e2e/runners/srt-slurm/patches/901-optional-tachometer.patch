diff --git a/tests/test_tachometer_optional.py b/tests/test_tachometer_optional.py
new file mode 100644
index 00000000..09b96abd
--- /dev/null
+++ b/tests/test_tachometer_optional.py
@@ -0,0 +1,36 @@
+from dataclasses import replace
+
+import pytest
+
+from srtctl.cli.submit import validate_setup
+from srtctl.core.schema import BenchmarkConfig, ModelConfig, ResourceConfig, SrtConfig
+
+
+@pytest.mark.parametrize("enabled", [False, True, None])
+@pytest.mark.parametrize("missing_uv", [False, True])
+def test_missing_tachometer_allowed_only_for_explicit_opt_out(tmp_path, enabled, missing_uv):
+    (tmp_path / "configs").mkdir()
+    (tmp_path / "configs/nats-server").touch()
+    (tmp_path / "configs/etcd").touch()
+    (tmp_path / "bin").mkdir()
+    if not missing_uv:
+        (tmp_path / "bin/uv").touch()
+    config = SrtConfig(
+        name="test",
+        model=ModelConfig(path="/model", container="/image", precision="fp8"),
+        resources=ResourceConfig(gpu_type="h200"),
+        benchmark=BenchmarkConfig(type="manual"),
+    )
+    config = replace(
+        config,
+        observability=replace(
+            config.observability,
+            enabled=False,
+            tachometer=replace(config.observability.tachometer, enabled=enabled),
+        ),
+    )
+    if enabled is False and not missing_uv:
+        validate_setup(tmp_path, config)
+    else:
+        with pytest.raises(SystemExit):
+            validate_setup(tmp_path, config)
