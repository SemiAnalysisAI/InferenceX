+@plain_dataclass(frozen=True)
+class DecodeRendezvous:
+    """Where one node of a multi-node TileRT decode worker joins the others."""
+
+    nnodes: int
+    node_rank: int
+    nproc_per_node: int
+    master_addr: str
+    master_port: int
+
