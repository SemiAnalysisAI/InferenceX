+fn read_u64(path: &Path) -> Result<u64> {
+    let raw = fs::read_to_string(path).with_context(|| format!("read {}", path.display()))?;
+    raw.trim()
+        .parse()
+        .with_context(|| format!("parse {} as an integer", path.display()))
