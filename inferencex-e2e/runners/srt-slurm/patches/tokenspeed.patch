+# TokenSpeed aggregated behind the Shepherd Model Gateway (SMG).
+#
+# Two TP1 workers on one node, each TokenSpeed's gRPC engine
+# (`python3 -m smg_grpc_servicer.tokenspeed`), the engine `ts serve` runs behind its
+# bundled SMG. srtctl advertises them to SMG as grpc:// URLs. The `tokenspeed`
+# container must ship TokenSpeed, which installs the gRPC servicer and the `smg`
+# command it pins; SMG runs in the same container. See docs/tokenspeed.md.
+#
+# Aliases (`qwen3-0.6b`, `tokenspeed`) resolve through srtslurm.yaml; see examples/README.md.
+
+schema: 2
+name: "qwen3-0.6b-tokenspeed-smg-agg"
+
+slurm:
+  time_limit: "00:30:00"
+
+model:
+  path: "qwen3-0.6b"
+  container: "tokenspeed"
+  precision: "bf16"
+
+resources:
+  gpu_type: "h100"
+  gpus_per_node: 8
+
+frontend:
+  type: smg
+  enable_multiple_frontends: false
+
+engine: tokenspeed
+roles:
+  agg:
+    nodes: 1
+    workers: 2
+    gpus: 1
+    env:
+      PYTHONUNBUFFERED: "1"
+    args:
+      served-model-name: "Qwen/Qwen3-0.6B"
+      tensor-parallel-size: 1
+      gpu-memory-utilization: 0.5
+      max-model-len: 4096
+
+benchmark:
+  type: "sa-bench"
+  isl: 128
+  osl: 128
+  concurrencies: "4x8"
