+# TokenSpeed disaggregated prefill/decode behind the Dynamo frontend.
+#
+# One TP1 prefill worker and one TP1 decode worker sharing a node (`nodes: colocate`
+# places decode on the prefill node's spare GPUs). Both run `dynamo.tokenspeed`, which
+# moves the KV cache with Mooncake; the Dynamo frontend dispatches prefill to the
+# prefill pool. srtctl adds `--disaggregation-mode` and the prefill bootstrap port.
+# P/D needs a Dynamo build that includes ai-dynamo/dynamo#9237; see docs/tokenspeed.md.
+#
+# Aliases (`qwen3-0.6b`, `tokenspeed`) resolve through srtslurm.yaml; see examples/README.md.
+
+schema: 2
+name: "qwen3-0.6b-tokenspeed-dynamo-disagg"
+
+slurm:
+  time_limit: "00:30:00"
+
+model:
+  path: "qwen3-0.6b"
+  container: "tokenspeed"
+  precision: "bf16"
+
+resources:
+  gpu_type: "h100"
+  gpus_per_node: 8
+dynamo:
+  install: false
+
+frontend:
+  type: dynamo
+  enable_multiple_frontends: false
+  args:
+    router-mode: "kv"
+
+engine: tokenspeed
+roles:
+  prefill:
+    nodes: 1
+    workers: 1
+    gpus: 1
+    env:
+      PYTHONUNBUFFERED: "1"
+    args:
+      served-model-name: "Qwen/Qwen3-0.6B"
+      tensor-parallel-size: 1
+      gpu-memory-utilization: 0.5
+      max-model-len: 4096
+  decode:
+    nodes: colocate
+    workers: 1
+    gpus: 1
+    env:
+      PYTHONUNBUFFERED: "1"
+    args:
+      served-model-name: "Qwen/Qwen3-0.6B"
+      tensor-parallel-size: 1
+      gpu-memory-utilization: 0.5
+      max-model-len: 4096
+
+benchmark:
+  type: "sa-bench"
+  isl: 128
+  osl: 128
+  concurrencies: "4x8"
