+#if defined(USE_CUDA)
+// Per-thread, per-device non-blocking stream for loopback copies.  The legacy
+// default stream implicitly orders against every blocking stream on the
+// device, so a synchronous cudaMemcpy + cudaStreamSynchronize(0) here can wait
+// on unrelated work (e.g. a collective that needs other ranks to launch) while
+// holding the context lock those ranks' launches need.  The stream is created
+// in, and only used with, the device's primary context.
+static cudaStream_t loopbackStream(int device, cudaError_t& rc) {
+    thread_local std::unordered_map<int, cudaStream_t> streams;
+    auto it = streams.find(device);
+    if (it != streams.end()) {
+        rc = cudaSuccess;
+        return it->second;
+    }
+    cudaStream_t stream = nullptr;
+    rc = cudaStreamCreateWithFlags(&stream, cudaStreamNonBlocking);
+    if (rc == cudaSuccess) streams.emplace(device, stream);
+    return stream;
+}
+#endif
