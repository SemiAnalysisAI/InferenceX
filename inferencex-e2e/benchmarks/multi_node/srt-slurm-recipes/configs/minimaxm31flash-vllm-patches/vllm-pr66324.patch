+            [I64(addr), I32(pred)],
+            "{\n\t.reg .pred p;\n\tsetp.ne.b32 p, $2, 0;\n\tmov.b32 $0, 0;\n\t@p ld.global.b32 $0, [$1];\n\t}",
+            "=r,l,r",
+            loc=loc,
