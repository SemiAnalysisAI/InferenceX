+@dsl_user_op
+def e4m3x2(lo, hi, *, loc=None, ip=None):
+    """E4M3 (RN, satfinite) of lo (byte 0) and hi (byte 1), zero-extended."""
+    return I32(
+        _asm(
+            _i32t(),
+            [F32(lo), F32(hi)],
+            "{\n\t.reg .b16 h;\n\tcvt.rn.satfinite.e4m3x2.f32 h, $2, $1;\n\tcvt.u32.u16 $0, h;\n\t}",
+            "=r,f,f",
+            side=False,
+            loc=loc,
+            ip=ip,
