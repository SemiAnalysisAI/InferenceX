+        _asm(
+            _i32t(),
+            [I32(t)],
+            "{\n\t.reg .b32 z;\n\tand.b32 z, $1, 0x7F7F7F7F;\n\tadd.u32 z, z, 0x7F7F7F7F;\n\t"
+            "or.b32 z, z, $1;\n\tnot.b32 z, z;\n\tand.b32 $0, z, 0x80808080;\n\t}",
+            "=r,r",
+            side=False,
+            loc=loc,
+            ip=ip,
