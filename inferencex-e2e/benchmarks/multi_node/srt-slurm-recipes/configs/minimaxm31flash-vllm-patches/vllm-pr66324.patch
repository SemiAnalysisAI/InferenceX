+@dsl_user_op
+def ptx_rp(text, a, pred, *, loc=None, ip=None):
+    """A PTX statement with one register operand ($0), executed when pred != 0."""
+    _asm(
+        None,
+        [I32(a), I32(pred)],
+        "{\n\t.reg .pred p;\n\tsetp.ne.b32 p, $1, 0;\n\t@p " + text + "\n\t}",
