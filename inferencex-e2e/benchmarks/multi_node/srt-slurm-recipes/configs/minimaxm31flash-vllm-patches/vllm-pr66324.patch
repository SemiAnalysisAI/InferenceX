+@dsl_user_op
+def bf16x2(lo, hi, *, loc=None, ip=None):
+    """bf16(lo) | bf16(hi) << 16 (RN)."""
+    return I32(
+        _asm(
+            _i32t(),
+            [F32(lo), F32(hi)],
+            "cvt.rn.bf16x2.f32 $0, $2, $1;",
+            "=r,f,f",
+            side=False,
+            loc=loc,
+            ip=ip,
+        )
+    )
+
+
+def bf_lo(w):
+    return (w << I32(16)).bitcast(F32)
+
+
+def bf_hi(w):
+    return (w & I32(-65536)).bitcast(F32)
