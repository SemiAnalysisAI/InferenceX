+# ---- global memory (addresses are Int64 generic addresses of global memory)
+@dsl_user_op
+def ldg_v4(addr, pred, *, loc=None, ip=None):
+    """ld.global.v4.b32, zeros when pred is 0."""
+    out = _asm(
+        _struct(4),
