+                        c1 = _min(cap, c0 + chunk)
+                        lo = _max(init, c0)
+                        hi = _min(_min(fend, cap), c1)
+                        avail = _max(cutlass.Int32(0), hi - lo)
+                        prt = part + (
+                            cutlass.Int64(row) * cutlass.Int64(nsplit_grid)
+                            + cutlass.Int64(split)
+                        ) * cutlass.Int64(TOPK * 8)
+                        srw_c = srw + cutlass.Int64(c0) * cutlass.Int64(4)
+                        if avail <= need:
