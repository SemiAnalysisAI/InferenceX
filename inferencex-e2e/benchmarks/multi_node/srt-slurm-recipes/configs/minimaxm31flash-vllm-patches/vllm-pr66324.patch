+        din_rs = cutlass.Array(
+            cutlass.Float32, 8, space=cutlass.AddressSpace.smem, alignment=16
+        )
+
+    if cutlass.const_expr(ra):
+        assert (
+            ra % split == 0
+            and ra * RA_E == 128
+            and ring * W_TILE_BYTES >= RA_A_BYTES + RA_R_BYTES
+        )
+        assert (
+            k_in == RA_KO
+            and n_out == RA_H
