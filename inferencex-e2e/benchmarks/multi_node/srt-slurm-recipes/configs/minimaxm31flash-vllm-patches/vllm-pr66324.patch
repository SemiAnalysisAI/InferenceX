+                    for ra_m in cutlass.range_constexpr(RA_KM):
+                        ra_w = [
+                            _ra_lds4(
+                                ra_sb
+                                + cutlass.Int32(_rc_a_base(ra_h * 4 + e))
+                                + cutlass.Int32(16)
+                                * (cutlass.Int32(ra_m * THREADS) + tx)
