From a02a204017e4e0ef88e2ae0d1eac76e8ac1b9332 Mon Sep 17 00:00:00 2001
From: Yichao Zhu <Yichao.Zhu@amd.com>
Date: Mon, 19 Oct 2026 19:30:48 +0800
Subject: [PATCH] Keep the KDA dense state contract and consolidate BF16 tests

Remove the implicit dense initial-state conversion now that HIP prefill handles BF16 paged states natively. Extend the existing paged-state comparison instead of maintaining a separate BF16 case.

Signed-off-by: Yichao Zhu <Yichao.Zhu@amd.com>
(cherry picked from commit ae6bb332600412fdf95fec94548e091a7638be99)
---
 tests/models/kimi_k3/test_amd_kda_chunk.py | 36 ++++++----------------
 vllm/models/kimi_k3/amd/ops/kda_prefill.py |  8 ++---
 2 files changed, 13 insertions(+), 31 deletions(-)

diff --git a/tests/models/kimi_k3/test_amd_kda_chunk.py b/tests/models/kimi_k3/test_amd_kda_chunk.py
index c7a2c511f..6865dea65 100644
--- a/tests/models/kimi_k3/test_amd_kda_chunk.py
+++ b/tests/models/kimi_k3/test_amd_kda_chunk.py
@@ -687,15 +687,19 @@ def _run_paged(inp: dict, cache, idx, warm, use_fused: bool, **kw):
 
 @pytest.mark.parametrize("use_fused", [False, True])
 @pytest.mark.parametrize("seqlens", [[512], [2048], [320, 64], [513, 64, 1]])
+@pytest.mark.parametrize("dtype", [torch.float32, torch.bfloat16])
 def test_paged_state_matches_the_dense_pair(
-    use_fused: bool, seqlens: list[int]
+    use_fused: bool, seqlens: list[int], dtype: torch.dtype
 ) -> None:
     """A paged cache must give the same result as the dense pair."""
     _requires_kernel()
     inp = _inputs(seqlens, seed=11)
+    inp["h0"] = inp["h0"].to(dtype).float()
     n = len(seqlens)
     rows = [3 * i + 5 for i in range(n)]
-    cache, idx, warm = _paged_cache(inp, [True] * n, rows, slots=3 * n + 12)
+    cache, idx, warm = _paged_cache(
+        inp, [True] * n, rows, slots=3 * n + 12, dtype=dtype
+    )
     before = cache.clone()
 
     o_ref, ht_ref = _run(inp, use_fused=use_fused)
@@ -703,7 +707,9 @@ def test_paged_state_matches_the_dense_pair(
 
     assert ht_got is None, "the final state is in the cache, not returned"
     torch.testing.assert_close(o_got, o_ref, rtol=5e-3, atol=5e-3)
-    torch.testing.assert_close(cache[idx.long()], ht_ref, rtol=5e-3, atol=5e-3)
+    torch.testing.assert_close(
+        cache[idx.long()], ht_ref.to(dtype), rtol=5e-3, atol=5e-3
+    )
 
     untouched = torch.ones(cache.shape[0], dtype=torch.bool, device="cuda")
     untouched[idx.long()] = False
@@ -712,29 +718,6 @@ def test_paged_state_matches_the_dense_pair(
     )
 
 
-@pytest.mark.parametrize("use_fused", [False, True])
-def test_paged_bf16_state_matches_dense_pair(use_fused: bool) -> None:
-    """The FP32 walk may load and store a BF16 persistent cache."""
-    if use_fused:
-        _requires_kernel()
-    seqlens = [513, 64, 1]
-    inp = _inputs(seqlens, seed=17)
-    rows = [2, 7, 11]
-    cache, idx, warm = _paged_cache(inp, [True] * len(seqlens), rows, slots=16)
-    cache = cache.to(torch.bfloat16)
-
-    dense = dict(inp)
-    dense["h0"] = cache[idx.long()].float()
-    o_ref, ht_ref = _run(dense, use_fused=use_fused)
-    o_got, ht_got = _run_paged(inp, cache, idx, warm, use_fused=use_fused)
-
-    assert ht_got is None
-    torch.testing.assert_close(o_got, o_ref, rtol=5e-3, atol=5e-3)
-    torch.testing.assert_close(
-        cache[idx.long()], ht_ref.to(torch.bfloat16), rtol=5e-3, atol=5e-3
-    )
-
-
 @pytest.mark.parametrize("use_fused", [False, True])
 @pytest.mark.parametrize("dtype", [torch.float32, torch.bfloat16])
 def test_cold_rows_start_from_zero_not_from_cache_junk(
@@ -966,6 +949,7 @@ def test_padded_cache_stride_is_honoured(use_fused: bool, dtype: torch.dtype) ->
     inp["h0"] = inp["h0"].to(dtype).float()
     n = len(seqlens)
     row = NUM_HEADS * HEAD_DIM * HEAD_DIM
+    # An odd BF16 row stride exercises unaligned vector loads and stores.
     slots, pad = 16, 513 if dtype == torch.bfloat16 else 512
     raw = torch.full((slots, row + pad), -7.0, device="cuda", dtype=dtype)
     cache = raw.as_strided(
diff --git a/vllm/models/kimi_k3/amd/ops/kda_prefill.py b/vllm/models/kimi_k3/amd/ops/kda_prefill.py
index e1900b5e5..ecdb36f4b 100644
--- a/vllm/models/kimi_k3/amd/ops/kda_prefill.py
+++ b/vllm/models/kimi_k3/amd/ops/kda_prefill.py
@@ -150,8 +150,9 @@ def chunk_kda_prefill(
             has_initial_state=has_initial_state,
         )
 
-    # Only the fused walk addresses paged rows directly. The Triton path
-    # gathers the active rows and scatters the final state back here.
+    # Only the fused walk addresses the paged rows directly. The Triton path
+    # gathers the rows it needs and scatters the results back here, so callers
+    # pass the cache the same way for either backend.
     scatter_to: torch.Tensor | None = None
     if state_cache is not None and not fused:
         initial_state = gather_initial_states(
@@ -164,9 +165,6 @@ def chunk_kda_prefill(
         # Restated for the type checker; `fused` already implies all three.
         assert cu_seqlens is not None and lower_bound is not None
         assert g_bias is not None
-        # The dense state API remains FP32; paged caches bypass this conversion.
-        if initial_state is not None and initial_state.dtype != torch.float32:
-            initial_state = initial_state.to(torch.float32)
         logger.info_once(
             "Kimi-K3 KDA prefill: dispatching the fused ROCm chunk kernel."
         )
