+    play = peer_layout(s)
+    half = peer_bytes(s) // 2
+
+    @fx.struct
+    class RouteLds:
+        route: fx.Array[fx.Int32, s * 2 * k2b.TOPK, 16]
+        flag: fx.Array[fx.Int32, k2b.E, 16]
+        expert: fx.Array[fx.Int32, k2b.MAX_U, 16]
+        kof: fx.Array[fx.Int32, k2b.MAX_U * 8, 16]
+        scan: fx.Array[fx.Int32, WAVES, 16]
+
+    @fx.struct
