+                got = poll(
+                    [
+                        (
+                            base_addr,
+                            (fx.min(q, tot - 1) // nq) * (row_elems // 2)
+                            + elem0 // 2
+                            + (fx.min(q, tot - 1) % nq) * 2,
+                            2,
+                        )
+                        for q in qs[i0 : i0 + batch]
+                    ],
+                    batch,
+                )
+                for k_ in range_constexpr(len(got)):
+                    words[i0 + k_] = got[k_]
