+@triton.jit
+def _ssm_commit_track_kernel(
+    src_ptr,
+    dst_ptr,
+    dst_idx_ptr,  # [R] committed slot of each request
+    step_ptr,  # [R] last accepted step (>= 0 valid)
+    src_rows_ptr,  # [R] verify scratch row of each request
+    trk_idx_ptr,  # [R] track slot (HAS_TRACK)
+    trk_step_ptr,  # [R] step to track, -1 = none (HAS_TRACK)
+    elem_per_entry,
+    src_layer_stride,
+    src_req_stride,
+    src_step_stride,
+    dst_layer_stride,
+    dst_req_stride,
+    src_req_size,
+    src_step_size,
+    dst_req_size,
+    inplace_step,  # step the verify already stored in the committed slot; -1 = none
+    HAS_TRACK: tl.constexpr,
+    HAS_SRC_ROWS: tl.constexpr,
+    CHUNK: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    """Commit + interval track of the SSM state in one launch, CHUNK elements per program.
+
+    main:  dst[l, dst_idx] = src[l, row, step]      unless step == inplace_step (already in dst[l, dst_idx])
+    track: dst[l, trk_idx] = src[l, row, tstep]     or dst[l, dst_idx] when tstep == inplace_step
+    (tstep <= step, so tstep == inplace_step implies the main copy is skipped: no overlap.)
+    Grid: (R, num_layers, cdiv(elem_per_entry, CHUNK)).
+    """
+    pid_req = tl.program_id(0)
+    pid_layer = tl.program_id(1).to(tl.int64)
+    pid_chunk = tl.program_id(2).to(tl.int64)
+
+    step = tl.load(step_ptr + pid_req).to(tl.int64)
+    dst_idx = tl.load(dst_idx_ptr + pid_req).to(tl.int64)
+    if HAS_SRC_ROWS:
+        src_row = tl.load(src_rows_ptr + pid_req).to(tl.int64)
+    else:
+        src_row = pid_req.to(tl.int64)
+    row_ok = (src_row >= 0) & (src_row < src_req_size)
+    dst_ok = (dst_idx >= 0) & (dst_idx < dst_req_size)
+    do_main = row_ok & dst_ok & (step >= 0) & (step < src_step_size)
+    do_main = do_main & (step != inplace_step)
+    do_trk = do_main & False
+    trk_from_slot = do_main & False
+    tstep = step * 0
+    tidx = dst_idx * 0
+    if HAS_TRACK:
+        tstep = tl.load(trk_step_ptr + pid_req).to(tl.int64)
+        tidx = tl.load(trk_idx_ptr + pid_req).to(tl.int64)
+        do_trk = (
+            row_ok
+            & (tstep >= 0)
+            & (tstep < src_step_size)
+            & (tidx >= 0)
+            & (tidx < dst_req_size)
+        )
+        trk_from_slot = tstep == inplace_step
+        do_trk = do_trk & ((tstep != inplace_step) | dst_ok)
+
+    if do_main | do_trk:
+        src_base = src_ptr + pid_layer * src_layer_stride + src_row * src_req_stride
+        slot_base = dst_ptr + pid_layer * dst_layer_stride
+        start = pid_chunk * CHUNK
+        for off in tl.static_range(0, CHUNK, BLOCK):
+            offs = start + off + tl.arange(0, BLOCK)
+            m = offs < elem_per_entry
+            if do_main:
+                x = tl.load(src_base + step * src_step_stride + offs, mask=m)
+                tl.store(slot_base + dst_idx * dst_req_stride + offs, x, mask=m)
+            if HAS_TRACK:
+                if do_trk:
+                    if trk_from_slot:
+                        y = tl.load(slot_base + dst_idx * dst_req_stride + offs, mask=m)
+                    else:
+                        y = tl.load(src_base + tstep * src_step_stride + offs, mask=m)
+                    tl.store(slot_base + tidx * dst_req_stride + offs, y, mask=m)
+
+
+SSM_COMMIT_CHUNK = 16384
+SSM_COMMIT_BLOCK = 2048
+
+
+def fused_ssm_commit_and_track(
+    dst: torch.Tensor,  # [num_layers, cache_size, *state_shape]
+    src: torch.Tensor,  # [num_layers, spec_size, draft_tokens, *state_shape]
+    dst_indices_raw: torch.Tensor,
+    step_indices_raw: torch.Tensor,
+    track_indices: torch.Tensor | None,
+    track_steps: torch.Tensor | None,
+    inplace_step: int | None,
+    src_indices_raw: torch.Tensor | None = None,
+    chunk: int | None = None,
+    block: int | None = None,
+):
+    """One launch for the SSM commit and its interval track, with a grid of
+    CHUNK-element programs (the per-1024-element grid of
+    fused_mamba_state_scatter_with_mask costs ~60 us at R = 5 even when every
+    program exits). Same result as
+    fused_mamba_state_scatter_with_mask(dst, src, dst_idx, steps) followed by
+    fused_mamba_state_scatter_with_mask(dst, src, track_idx, track_steps),
+    except that a step equal to ``inplace_step`` is read from the committed
+    slot (where the verify stored it) instead of ``src``."""
+    total_requests = step_indices_raw.shape[0]
+    if total_requests == 0:
+        return
+    if dst.shape[0] != src.shape[0] or dst.shape[2:] != src.shape[3:]:
+        raise ValueError(f"shape mismatch: {dst.shape=} {src.shape=}")
+    if dst.dtype != src.dtype or dst.device != src.device:
+        raise ValueError("dst and src must share dtype and device")
+    _require_entry_contiguous_dst(dst, 2, "fused_ssm_commit_and_track")
+    if not src.is_contiguous():
+        raise ValueError("src tensor must be contiguous")
+    has_track = track_indices is not None
+    if has_track and track_steps is None:
+        raise ValueError("track_steps required with track_indices")
+    chunk = chunk or SSM_COMMIT_CHUNK
+    block = block or SSM_COMMIT_BLOCK
+    num_layers = dst.shape[0]
+    elem_per_entry = dst.numel() // (dst.shape[0] * dst.shape[1])
+    # integer index vectors are read as they are (the kernel widens to int64): no conversion launches
+    def _idx(t):
+        if t.ndim != 1 or t.shape[0] != total_requests:
+            raise ValueError(f"index vector shape {tuple(t.shape)} != ({total_requests},)")
+        if t.dtype not in (torch.int32, torch.int64):
+            t = t.to(torch.int64)
+        return t.contiguous()
+
+    dst_indices_raw = _idx(dst_indices_raw)
+    step_indices_raw = _idx(step_indices_raw)
+    has_src_rows = src_indices_raw is not None
+    src_indices_raw = _idx(src_indices_raw) if has_src_rows else step_indices_raw
+    if has_track:
+        track_indices = _idx(track_indices)
+        track_steps = _idx(track_steps)
+    else:
+        track_indices = track_steps = step_indices_raw
+    grid = (total_requests, num_layers, triton.cdiv(elem_per_entry, chunk))
+    _ssm_commit_track_kernel[grid](
+        src,
+        dst,
+        dst_indices_raw,
+        step_indices_raw,
+        src_indices_raw,
+        track_indices,
+        track_steps,
+        elem_per_entry,
+        src.stride(0),
+        src.stride(1),
