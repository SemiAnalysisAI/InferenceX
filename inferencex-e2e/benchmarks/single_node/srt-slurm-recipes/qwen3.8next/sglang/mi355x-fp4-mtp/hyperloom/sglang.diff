+// SGLANG_INFX_TOPK_ILP copy of fast_topk.cuh: the two full-row passes issue kUnroll
+// independent loads per thread. Selected sets are those of fast_topk.cuh.
+// Radix-select fast top-k with the AOT fast_topk_v2 semantics: for each row b,
+// select the kTopK largest scores in [row_starts[b], row_starts[b] + lengths[b])
+// and write their indices relative to row_starts[b]; order within a row is unspecified.
+#include <sgl_kernel/tensor.h>
+#include <sgl_kernel/utils.h>
+
+#include <sgl_kernel/utils.cuh>
+
+#include <tvm/ffi/container/tensor.h>
+
+namespace sglang {
+
+namespace fast_topk_ilp_detail {
+
+constexpr uint32_t kThreadsPerBlock = 1024;
+// Each radix pass needs at most ~kTopK candidates in the threshold bin, so
+// 4K entries per round (2 rounds = 8K entries = 32KB) is sufficient.
+constexpr size_t kSmemBytes = 8 * 1024 * sizeof(uint32_t);  // 32KB
+
+struct FastTopKParams {
+  const float* __restrict__ input;         // [B, input_stride]
+  const int32_t* __restrict__ row_starts;  // [B]
+  int32_t* __restrict__ indices;           // [B, kTopK]
+  const int32_t* __restrict__ lengths;     // [B]
+  int64_t input_stride;
+};
+
+SGL_DEVICE auto convert_to_uint8(float x) -> uint8_t {
+  const __half h = __float2half_rn(x);
+  const uint16_t bits = __half_as_ushort(h);
+  const uint16_t key = (bits & 0x8000) ? static_cast<uint16_t>(~bits) : static_cast<uint16_t>(bits | 0x8000);
+  return static_cast<uint8_t>(key >> 8);
+}
+
+SGL_DEVICE auto convert_to_uint32(float x) -> uint32_t {
+  const uint32_t bits = __float_as_uint(x);
+  return (bits & 0x80000000u) ? ~bits : (bits | 0x80000000u);
+}
+
+// SGLANG_INFX_TOPK_ILP: visit every element of [0, length) of one row with kUnroll
+// independent loads in flight per thread (same element-to-thread map as the
+// strided loop, so per-element work is unchanged; only the load issue order moves).
+template <int kUnroll, typename F>
+SGL_DEVICE void scan_row(const float* __restrict__ row, int length, F&& f) {
+  constexpr int B = static_cast<int>(kThreadsPerBlock);
+  int idx = threadIdx.x;
+  for (; idx + (kUnroll - 1) * B < length; idx += kUnroll * B) {
+    float v[kUnroll];
+#pragma unroll
+    for (int u = 0; u < kUnroll; ++u) v[u] = row[idx + u * B];
+#pragma unroll
+    for (int u = 0; u < kUnroll; ++u) f(idx + u * B, v[u]);
+  }
+  for (; idx < length; idx += B) f(idx, row[idx]);
+}
+
+// When length <= kTopK, write the indices directly.
+template <int kTopK>
+SGL_DEVICE void naive_topk(int32_t* __restrict__ indice, int32_t length) {
+  const auto tid = threadIdx.x;
+  for (int i = tid; i < kTopK; i += kThreadsPerBlock) {
+    indice[i] = (i < length) ? i : -1;
+  }
+}
+
+// Radix-select top-k. Assumes length > kTopK (checked by the caller).
+template <int kTopK, int kUnroll, int kCopies, bool kExact>
+SGL_DEVICE bool radix_select_topk(const float* __restrict__ input, int* __restrict__ index, int row_start, int length) {
+  int topk = kTopK;
+  constexpr auto BLOCK_SIZE = kThreadsPerBlock;
+  constexpr auto RADIX = 256;
+  constexpr auto SMEM_INPUT_SIZE = kSmemBytes / (2 * sizeof(int));
+
+  alignas(128) __shared__ int s_histogram_buf[2][RADIX + 128];
+  alignas(128) __shared__ int s_counter;
+  alignas(128) __shared__ int s_threshold_bin_id;
+  alignas(128) __shared__ int s_num_input[2];
+
+  auto& s_histogram = s_histogram_buf[0];
+  // allocate for two rounds
+  extern __shared__ int s_input_idx[][SMEM_INPUT_SIZE];
+
+  const int tx = threadIdx.x;
+
+  // stage 1: 8bit coarse histogram. kCopies > 1: lane l adds into copy l % kCopies
+  // (fewer same-address LDS atomics per wave), then the copies are summed per bin.
+  // The counts, and so every threshold and selected set, are unchanged.
+  if constexpr (kCopies > 1) {
+    __shared__ int s_hist_copies[kCopies][RADIX + 1];  // +1: copies of a bin in distinct LDS banks
+    for (int i = tx; i < kCopies * (RADIX + 1); i += BLOCK_SIZE) (&s_hist_copies[0][0])[i] = 0;
+    if (tx < RADIX + 1) s_histogram[tx] = 0;
+    __syncthreads();
+    const int copy = tx % kCopies;
+    scan_row<kUnroll>(input + row_start, length, [&](int idx, float x) {
+      const auto bin = convert_to_uint8(x);
+      ::atomicAdd(&s_hist_copies[copy][bin], 1);
+    });
+    __syncthreads();
+    if (tx < RADIX) {
+      int sum = 0;
+#pragma unroll
+      for (int c = 0; c < kCopies; ++c) sum += s_hist_copies[c][tx];
+      s_histogram[tx] = sum;
+    }
+    __syncthreads();
+  } else {
+    if (tx < RADIX + 1) s_histogram[tx] = 0;
+    __syncthreads();
+
+    scan_row<kUnroll>(input + row_start, length, [&](int idx, float x) {
+      const auto bin = convert_to_uint8(x);
+      ::atomicAdd(&s_histogram[bin], 1);
+    });
+    __syncthreads();
+  }
+
+  const auto run_cumsum = [&] {
+#pragma unroll 8
+    for (int i = 0; i < 8; ++i) {
+      static_assert(1 << 8 == RADIX);
+      if (tx < RADIX) {
+        const auto j = 1 << i;
+        const auto k = i & 1;
+        auto value = s_histogram_buf[k][tx];
+        if (tx < RADIX - j) {
+          value += s_histogram_buf[k][tx + j];
+        }
+        s_histogram_buf[k ^ 1][tx] = value;
+      }
+      __syncthreads();
+    }
+  };
+
+  run_cumsum();
+  if (tx < RADIX && s_histogram[tx] > topk && s_histogram[tx + 1] <= topk) {
+    s_threshold_bin_id = tx;
+    s_num_input[0] = 0;
+    s_counter = 0;
+  }
+  __syncthreads();
+
+  const auto threshold_bin = s_threshold_bin_id;
+  topk -= s_histogram[threshold_bin + 1];
+
+  if (topk == 0) {
+    scan_row<kUnroll>(input + row_start, length, [&](int idx, float x) {
+      const auto bin = static_cast<int>(convert_to_uint8(x));
+      if (bin > threshold_bin) {
+        const auto pos = ::atomicAdd(&s_counter, 1);
+        index[pos] = idx;
+      }
+    });
+    __syncthreads();
+    return false;
+  } else {
+    __syncthreads();
+    if (tx < RADIX + 1) {
+      s_histogram[tx] = 0;
+    }
+    __syncthreads();
+
+    scan_row<kUnroll>(input + row_start, length, [&](int idx, float raw_input) {
+      const auto bin = static_cast<int>(convert_to_uint8(raw_input));
+      if (bin > threshold_bin) {
+        const auto pos = ::atomicAdd(&s_counter, 1);
+        index[pos] = idx;
+      } else if (bin == threshold_bin) {
+        const auto pos = ::atomicAdd(&s_num_input[0], 1);
+        // fuse the histogram computation here
+        if (pos < int(SMEM_INPUT_SIZE)) {
+          s_input_idx[0][pos] = idx;
+          const auto bin = convert_to_uint32(raw_input);
+          const auto sub_bin = (bin >> 24) & 0xFF;
+          ::atomicAdd(&s_histogram[sub_bin], 1);
+        }
+      }
+    });
+    __syncthreads();
+  }
+
+  // stage 2: refine with 8bit radix passes
+#pragma unroll 4
+  for (int round = 0; round < 4; ++round) {
+    __shared__ int s_last_remain;
+    const auto r_idx = round % 2;
+
+    // clip here to prevent overflow
+    const auto _raw_num_input = s_num_input[r_idx];
+    if constexpr (kExact) {
+      // block-uniform: written before the previous barrier
+      if (_raw_num_input > int(SMEM_INPUT_SIZE)) return true;
+    }
+    const auto num_input = (_raw_num_input < int(SMEM_INPUT_SIZE)) ? _raw_num_input : int(SMEM_INPUT_SIZE);
+
+    run_cumsum();
+    if (tx < RADIX && s_histogram[tx] > topk && s_histogram[tx + 1] <= topk) {
+      s_threshold_bin_id = tx;
+      s_num_input[r_idx ^ 1] = 0;
+      s_last_remain = topk - s_histogram[tx + 1];
+    }
+    __syncthreads();
+
+    const auto threshold_bin = s_threshold_bin_id;
+    topk -= s_histogram[threshold_bin + 1];
+
+    if (topk == 0) {
+      for (int i = tx; i < num_input; i += BLOCK_SIZE) {
+        const auto idx = s_input_idx[r_idx][i];
+        const auto offset = 24 - round * 8;
+        const auto bin = (convert_to_uint32(input[idx + row_start]) >> offset) & 0xFF;
+        if (bin > threshold_bin) {
+          const auto pos = ::atomicAdd(&s_counter, 1);
+          index[pos] = idx;
+        }
+      }
+      __syncthreads();
+      break;
+    } else {
+      __syncthreads();
+      if (tx < RADIX + 1) {
+        s_histogram[tx] = 0;
+      }
+      __syncthreads();
+      for (int i = tx; i < num_input; i += BLOCK_SIZE) {
+        const auto idx = s_input_idx[r_idx][i];
+        const auto raw_input = input[idx + row_start];
+        const auto offset = 24 - round * 8;
+        const auto bin = (convert_to_uint32(raw_input) >> offset) & 0xFF;
+        if (bin > threshold_bin) {
+          const auto pos = ::atomicAdd(&s_counter, 1);
+          index[pos] = idx;
+        } else if (bin == threshold_bin) {
+          if (round == 3) {
+            const auto pos = ::atomicAdd(&s_last_remain, -1);
+            if (pos > 0) {
+              index[kTopK - pos] = idx;
+            }
+          } else {
+            const auto pos = ::atomicAdd(&s_num_input[r_idx ^ 1], 1);
+            if (pos < int(SMEM_INPUT_SIZE)) {
+              // fuse the histogram computation here
+              s_input_idx[r_idx ^ 1][pos] = idx;
+              const auto bin = convert_to_uint32(raw_input);
+              const auto sub_bin = (bin >> (offset - 8)) & 0xFF;
+              ::atomicAdd(&s_histogram[sub_bin], 1);
+            }
+          }
+        }
+      }
+      __syncthreads();
+    }
+  }
+  return false;
+}
+
+// SGLANG_INFX_TOPK_EXACT (r2-c16 it13): exact radix select over the whole row in global
+// memory (4 MSB-first 8-bit passes of the fp32 key, then one write pass). Used only for a
+// row whose threshold-bin candidates overflowed the SMEM_INPUT_SIZE shared buffer in
+// radix_select_topk (those candidates were dropped, so its selection was not the top-k).
+// Rows that never overflow keep the shared-memory path and its exact selected set.
+template <int kTopK>
+SGL_DEVICE void exact_radix_topk(const float* __restrict__ input, int* __restrict__ index, int row_start, int length) {
+  constexpr int RADIX = 256;
+  constexpr int BLOCK_SIZE = static_cast<int>(kThreadsPerBlock);
+  __shared__ int s_xhist[RADIX];
+  __shared__ int s_xsuf[2][RADIX + 1];
+  __shared__ uint32_t s_xprefix, s_xmask;
+  __shared__ int s_xremain, s_xcnt_gt, s_xcnt_eq;
+  const int tx = threadIdx.x;
+  if (tx == 0) {
+    s_xprefix = 0u;
+    s_xmask = 0u;
+    s_xremain = kTopK;
+    s_xcnt_gt = 0;
+    s_xcnt_eq = 0;
+  }
+  __syncthreads();
+  for (int shift = 24; shift >= 0; shift -= 8) {
+    const uint32_t prefix = s_xprefix;
+    const uint32_t mask = s_xmask;
+    const int remain = s_xremain;
+    if (remain == 0) break;  // block-uniform (read after a barrier)
+    if (tx < RADIX) s_xhist[tx] = 0;
+    __syncthreads();
+    for (int idx = tx; idx < length; idx += BLOCK_SIZE) {
+      const uint32_t key = convert_to_uint32(input[idx + row_start]);
+      if ((key & mask) == prefix) ::atomicAdd(&s_xhist[(key >> shift) & 0xFF], 1);
+    }
+    __syncthreads();
+    if (tx < RADIX) s_xsuf[0][tx] = s_xhist[tx];
+    if (tx == RADIX) {
+      s_xsuf[0][RADIX] = 0;
+      s_xsuf[1][RADIX] = 0;
+    }
+    __syncthreads();
+#pragma unroll
+    for (int i = 0; i < 8; ++i) {  // suffix sums; 8 steps -> result in s_xsuf[0]
+      const int k = i & 1;
+      if (tx < RADIX) {
+        int v = s_xsuf[k][tx];
+        if (tx + (1 << i) < RADIX) v += s_xsuf[k][tx + (1 << i)];
+        s_xsuf[k ^ 1][tx] = v;
+      }
+      __syncthreads();
+    }
+    // candidates with this prefix number > remain, so exactly one bin b has
+    // suffix(b) > remain >= suffix(b + 1)
+    if (tx < RADIX && s_xsuf[0][tx] > remain && s_xsuf[0][tx + 1] <= remain) {
+      s_xprefix = prefix | (static_cast<uint32_t>(tx) << shift);
+      s_xmask = mask | (0xFFu << shift);
+      s_xremain = remain - s_xsuf[0][tx + 1];
+    }
+    __syncthreads();
+  }
+  const uint32_t P = s_xprefix;
+  const uint32_t M = s_xmask;
+  const int R = s_xremain;  // ties at the full key P still to take
+  for (int idx = tx; idx < length; idx += BLOCK_SIZE) {
+    const uint32_t mk = convert_to_uint32(input[idx + row_start]) & M;
+    if (mk > P) {
+      const int pos = ::atomicAdd(&s_xcnt_gt, 1);
+      index[pos] = idx;
+    } else if (R > 0 && mk == P) {
+      const int pos = ::atomicAdd(&s_xcnt_eq, 1);
+      if (pos < R) index[kTopK - R + pos] = idx;
+    }
+  }
+  __syncthreads();
+}
+
+
+// Unrolled row scan for the fallback (4 independent loads in flight per thread).
+template <typename F>
+SGL_DEVICE void fb_scan_row(const float* __restrict__ row, int length, F&& f) {
+  constexpr int B = static_cast<int>(kThreadsPerBlock);
+  int idx = threadIdx.x;
+  for (; idx + 3 * B < length; idx += 4 * B) {
+    float v[4];
+#pragma unroll
+    for (int u = 0; u < 4; ++u) v[u] = row[idx + u * B];
+#pragma unroll
+    for (int u = 0; u < 4; ++u) f(idx + u * B, v[u]);
+  }
+  for (; idx < length; idx += B) f(idx, row[idx]);
+}
+
+// SGLANG_INFX_TOPK_EXACT fast fallback: one global pass builds a 4096-bin histogram of the
+// fp32 key's top 12 bits, a second pass writes the rows above the threshold bin and gathers the
+// bin's candidates (index + key) into the 32 KB dynamic buffer, then 8/8/4-bit radix rounds
+// over the candidates in LDS finish the exact selection. A threshold bin above 4096 candidates
+// (never seen on real rows) takes exact_radix_topk.
+template <int kTopK>
+SGL_DEVICE void exact_topk_fallback(const float* __restrict__ input, int* __restrict__ index, int row_start, int length) {
+  constexpr int BLOCK_SIZE = static_cast<int>(kThreadsPerBlock);
+  constexpr int NB = 4096;
+  constexpr int PER = NB / BLOCK_SIZE;
+  constexpr int CAP = static_cast<int>(kSmemBytes / sizeof(int)) - NB;
+  static_assert(CAP >= 4096 && NB % BLOCK_SIZE == 0);
+  constexpr int RADIX = 256;
+  extern __shared__ int s_fbdyn[];
+  int* s_key = s_fbdyn;        // 12-bit histogram, then candidate keys
+  int* s_cidx = s_fbdyn + NB;  // candidate indices
+  __shared__ int s_tsum[2][BLOCK_SIZE + 1];
+  __shared__ int s_fhist[RADIX];
+  __shared__ int s_fsuf[2][RADIX + 1];
+  __shared__ int s_fb_bin, s_fb_above, s_fb_cnt, s_fb_gt, s_fb_eq, s_fb_nc, s_fb_remain;
+  __shared__ uint32_t s_fb_prefix, s_fb_mask;
+  const float* row = input + row_start;
+  const int tx = threadIdx.x;
+  for (int i = tx; i < NB; i += BLOCK_SIZE) s_key[i] = 0;
+  if (tx == 0) {
+    s_fb_gt = 0;
+    s_fb_eq = 0;
+    s_fb_nc = 0;
+  }
+  if (tx < 2) s_tsum[tx][BLOCK_SIZE] = 0;
+  __syncthreads();
+  fb_scan_row(row, length, [&](int, float x) { ::atomicAdd(&s_key[convert_to_uint32(x) >> 20], 1); });
+  __syncthreads();
+  int loc[PER];
+  {
+    int acc = 0;
+#pragma unroll
+    for (int j = PER - 1; j >= 0; --j) {
+      acc += s_key[tx * PER + j];
+      loc[j] = acc;
+    }
+    s_tsum[0][tx] = acc;
+  }
+  __syncthreads();
+#pragma unroll
+  for (int i = 0; i < 10; ++i) {  // suffix sums over threads; 10 steps -> s_tsum[0]
+    const int k = i & 1;
+    int v = s_tsum[k][tx];
+    if (tx + (1 << i) < BLOCK_SIZE) v += s_tsum[k][tx + (1 << i)];
+    s_tsum[k ^ 1][tx] = v;
+    __syncthreads();
+  }
+  {
+    const int after = s_tsum[0][tx + 1];
+#pragma unroll
+    for (int j = 0; j < PER; ++j) {
+      const int suf = loc[j] + after;
+      const int suf_next = (j + 1 < PER ? loc[j + 1] : 0) + after;
+      if (suf > kTopK && suf_next <= kTopK) {
+        s_fb_bin = tx * PER + j;
+        s_fb_above = suf_next;
+        s_fb_cnt = suf - suf_next;
+      }
+    }
+  }
+  __syncthreads();
+  const int b = s_fb_bin;
+  const int cnt = s_fb_cnt;
+  const int remain0 = kTopK - s_fb_above;
+  if (cnt > CAP) {  // block-uniform
+    exact_radix_topk<kTopK>(input, index, row_start, length);
+    return;
+  }
+  fb_scan_row(row, length, [&](int idx, float x) {
+    const uint32_t key = convert_to_uint32(x);
+    const int k12 = static_cast<int>(key >> 20);
+    if (k12 > b) {
+      index[::atomicAdd(&s_fb_gt, 1)] = idx;
+    } else if (k12 == b) {
+      const int p = ::atomicAdd(&s_fb_nc, 1);
+      s_cidx[p] = idx;
+      s_key[p] = static_cast<int>(key);
+    }
+  });
+  if (tx == 0) {
+    s_fb_prefix = static_cast<uint32_t>(b) << 20;
+    s_fb_mask = 0xFFF00000u;
+    s_fb_remain = remain0;
+  }
+  __syncthreads();
+#pragma unroll
+  for (int d = 0; d < 3; ++d) {
+    const int shift = d == 0 ? 12 : (d == 1 ? 4 : 0);
+    const uint32_t dmask = d < 2 ? 0xFFu : 0xFu;
+    const uint32_t prefix = s_fb_prefix;
+    const uint32_t mask = s_fb_mask;
+    const int remain = s_fb_remain;
+    if (remain == 0) break;  // block-uniform
+    if (tx < RADIX) s_fhist[tx] = 0;
+    __syncthreads();
+    for (int i = tx; i < cnt; i += BLOCK_SIZE) {
+      const uint32_t key = static_cast<uint32_t>(s_key[i]);
+      if ((key & mask) == prefix) ::atomicAdd(&s_fhist[(key >> shift) & dmask], 1);
+    }
+    __syncthreads();
+    if (tx < RADIX) s_fsuf[0][tx] = s_fhist[tx];
+    if (tx < 2) s_fsuf[tx][RADIX] = 0;
+    __syncthreads();
+#pragma unroll
+    for (int i = 0; i < 8; ++i) {
+      const int k = i & 1;
+      if (tx < RADIX) {
+        int v = s_fsuf[k][tx];
+        if (tx + (1 << i) < RADIX) v += s_fsuf[k][tx + (1 << i)];
+        s_fsuf[k ^ 1][tx] = v;
+      }
+      __syncthreads();
+    }
+    if (tx < RADIX && s_fsuf[0][tx] > remain && s_fsuf[0][tx + 1] <= remain) {
+      s_fb_prefix = prefix | (static_cast<uint32_t>(tx) << shift);
+      s_fb_mask = mask | (dmask << shift);
+      s_fb_remain = remain - s_fsuf[0][tx + 1];
+    }
+    __syncthreads();
+  }
+  const uint32_t P = s_fb_prefix;
+  const uint32_t M = s_fb_mask;
+  const int R = s_fb_remain;
+  for (int i = tx; i < cnt; i += BLOCK_SIZE) {
+    const uint32_t mk = static_cast<uint32_t>(s_key[i]) & M;
+    if (mk > P) {
+      index[::atomicAdd(&s_fb_gt, 1)] = s_cidx[i];
+    } else if (R > 0 && mk == P) {
+      const int pos = ::atomicAdd(&s_fb_eq, 1);
+      if (pos < R) index[kTopK - R + pos] = s_cidx[i];
+    }
+  }
+  __syncthreads();
+}
+
+template <int kTopK, bool kUsePDL, int kUnroll, int kCopies, bool kExact>
+__global__ __launch_bounds__(fast_topk_ilp_detail::kThreadsPerBlock) void fast_topk_ilp_kernel(
+    const fast_topk_ilp_detail::FastTopKParams __grid_constant__ params) {
+  using namespace fast_topk_ilp_detail;
+  device::PDLWaitPrimary<kUsePDL>();
+
+  const auto bid = static_cast<uint64_t>(blockIdx.x);
+  const auto row_start = params.row_starts[bid];
+  const auto length = params.lengths[bid];
+  const auto indice = params.indices + bid * kTopK;
+  const auto score = params.input + bid * params.input_stride;
+  if (length <= kTopK) {
+    naive_topk<kTopK>(indice, length);
+  } else {
+    const bool overflow = radix_select_topk<kTopK, kUnroll, kCopies, kExact>(score, indice, row_start, length);
+    if constexpr (kExact) {
+      if (overflow) {
+        __syncthreads();
+        exact_topk_fallback<kTopK>(score, indice, row_start, length);
+      }
+    }
+  }
+
+  device::PDLTriggerSecondary<kUsePDL>();
+}
+
+}  // namespace fast_topk_ilp_detail
+
+/**
+ * \brief Per-row top-k selection over ragged rows of a fp32 score matrix.
+ *
+ * Row b selects the kTopK largest values in
+ * score[b, row_starts[b] : row_starts[b] + lengths[b]) and writes their
+ * indices (relative to row_starts[b]) into indices[b]. Unfilled slots are
+ * -1 when lengths[b] < kTopK.
+ */
+template <int kTopK, bool kUsePDL, int kUnroll, int kCopies, bool kExact = false>
+struct FastTopKIlpKernel {
+  static constexpr auto kernel = fast_topk_ilp_detail::fast_topk_ilp_kernel<kTopK, kUsePDL, kUnroll, kCopies, kExact>;
+
+  static void
+  run(const tvm::ffi::TensorView score,
+      const tvm::ffi::TensorView row_starts,
+      const tvm::ffi::TensorView indices,
+      const tvm::ffi::TensorView lengths) {
+    using namespace host;
+    auto B = SymbolicSize{"batch"};
+    auto L = SymbolicSize{"length"};
+    auto S = SymbolicSize{"input_stride"};
+    auto device = SymbolicDevice{};
+    device.set_options<kDLGPU>();
+
+    TensorMatcher({B, L})  // score
+        .with_strides({S, 1})
+        .with_dtype<fp32_t>()
+        .with_device(device)
+        .verify(score);
+    TensorMatcher({B})  // row_starts
+        .with_dtype<int32_t>()
+        .with_device(device)
+        .verify(row_starts);
+    TensorMatcher({B, kTopK})  // indices
+        .with_dtype<int32_t>()
+        .with_device(device)
+        .verify(indices);
+    TensorMatcher({B})  // lengths
+        .with_dtype<int32_t>()
+        .with_device(device)
+        .verify(lengths);
+
+    const auto params = fast_topk_ilp_detail::FastTopKParams{
+        .input = static_cast<const float*>(score.data_ptr()),
+        .row_starts = static_cast<const int32_t*>(row_starts.data_ptr()),
+        .indices = static_cast<int32_t*>(indices.data_ptr()),
+        .lengths = static_cast<const int32_t*>(lengths.data_ptr()),
+        .input_stride = S.unwrap(),
+    };
+
+    const auto num_rows = static_cast<uint32_t>(B.unwrap());
+    LaunchKernel(num_rows, fast_topk_ilp_detail::kThreadsPerBlock, device.unwrap(), fast_topk_ilp_detail::kSmemBytes)
+        .enable_pdl(kUsePDL)(kernel, params);
+  }
+};
+
+}  // namespace sglang
