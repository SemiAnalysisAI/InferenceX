--- /dev/null
+++ b/python/sglang/srt/speculative/infx_replayssm_amortize.py
@@ -0,0 +1,165 @@
+# SPDX-License-Identifier: Apache-2.0
+"""SGLANG_INFX_REPLAYSSM_AMORTIZE (r2-c16 iter 7): amortized ReplaySSM GDN commit for a 16-bit
+SSM checkpoint (--mamba-ssm-dtype bfloat16).
+
+The served schedule for a 16-bit checkpoint is fold-every-commit: after every verify step the
+commit re-materializes every row's full checkpoint (36 GDN layers x 48 heads x 128 x 128), so
+temporal[slot] is always current. With this switch the cursors follow the fp32-checkpoint
+schedule (fold when the 16-entry ring is near full, ~every 4 steps); verify already rebuilds its
+output from checkpoint + compact d/k history including the bf16 low parts. CHANGES NUMERICS
+(fewer bf16 roundings of the state; closer to an fp32 checkpoint in eval/eval_replayssm_amortize.py).
+
+Between folds temporal[slot] lags the live state by the ring depth, so every place that hands a
+request's mamba slot to the radix cache first folds the slot's remaining ring
+(force_fold_request), which makes the donated checkpoint as current as on the served path.
+"""
+
+from __future__ import annotations
+
+import logging
+
+import torch
+
+from sglang.srt import infx_knobs
+
+logger = logging.getLogger(__name__)
+
+_LOGGED = False
+_FORWARD_STREAM = None
+
+
+def set_forward_stream(stream) -> None:
+    """ModelRunner registers its forward stream so the caching-time fold can order behind it."""
+    global _FORWARD_STREAM
+    _FORWARD_STREAM = stream
+
+
+def enabled() -> bool:
+    global _LOGGED
+    if not infx_knobs.REPLAYSSM_AMORTIZE:
+        return False
+    if not _LOGGED:
+        _LOGGED = True
+        logger.info(
+            "SGLANG_INFX_REPLAYSSM_AMORTIZE=1: ReplaySSM GDN commit folds the 16-bit "
+            "checkpoint only when the ring is near full (no fold-every-commit); "
+            "caching a request folds its ring first"
+        )
+    return True
+
+
+def applies(mamba_pool) -> bool:
+    """True when the GDN spec ring is live with a 16-bit checkpoint and the switch is on."""
+    if mamba_pool is None or getattr(mamba_pool, "replayssm_spec_write_pos", None) is None:
+        return False
+    if getattr(mamba_pool, "replayssm_is_kda", False):
+        return False
+    if mamba_pool.mamba_cache.temporal.dtype == torch.float32:
+        return False
+    return enabled()
+
+
+def _commit_kwargs(spec_state, state_idx, replay_idx, mamba_pool, accept_lens):
+    return dict(
+        checkpoint_state=spec_state.temporal,
+        d_cache=spec_state.replayssm_d,
+        k_cache=spec_state.replayssm_k,
+        g_cache=spec_state.replayssm_g,
+        d_residual_cache=spec_state.replayssm_rawv,
+        k_residual_cache=spec_state.replayssm_rawk,
+        state_batch_indices=state_idx,
+        replay_indices=replay_idx,
+        write_pos=mamba_pool.replayssm_spec_write_pos,
+        cache_base=mamba_pool.replayssm_cache_base,
+        is_flush=mamba_pool.replayssm_is_flush,
+        accept_lens=accept_lens,
+        null_block_id=-1,
+    )
+
+
+def force_fold_request(req_to_token_pool, req) -> None:
+    """Fold the request's unflushed ring into temporal[slot] (device-only, no host sync).
+
+    Sets the row's flush flag and runs the served commit kernel for that one row: it folds
+    write_pos entries into the checkpoint, then resets write_pos / is_flush and advances
+    cache_base. With write_pos == 0 the fold is the identity (old state, exp(0), no deltas).
+    """
+    mamba_pool = getattr(req_to_token_pool, "mamba_pool", None)
+    if not applies(mamba_pool):
+        return
+    req_pool_idx = getattr(req.kv, "req_pool_idx", None)
+    if req_pool_idx is None or getattr(req.kv, "mamba_pool_idx", None) is None:
+        return
+    from sglang.kernels.ops.attention.fla.gdn_replayssm_spec_decode import (
+        commit_gdn_replayssm_circular,
+    )
+
+    device = mamba_pool.replayssm_is_flush.device
+    # The scheduler runs on its own stream; a forward already launched on the forward stream
+    # may still verify/commit this row. Order the fold (and every later scheduler-stream op,
+    # e.g. a CoW copy of the donated slot) behind it with a GPU-side wait, no host sync.
+    cur = torch.cuda.current_stream(device)
+    fwd = _FORWARD_STREAM
+    if fwd is not None and fwd.cuda_stream != cur.cuda_stream:
+        cur.wait_stream(fwd)
+    replay_idx = torch.tensor([int(req_pool_idx)], dtype=torch.int64, device=device)
+    state_idx = req_to_token_pool.get_mamba_indices(replay_idx)
+    mamba_pool.replayssm_is_flush.index_fill_(0, replay_idx, 1)
+    spec_state = req_to_token_pool.get_speculative_mamba2_params_all_layers()
+    accept_lens = torch.zeros(1, dtype=torch.int32, device=device)
+    commit_gdn_replayssm_circular(
+        **_commit_kwargs(spec_state, state_idx, replay_idx, mamba_pool, accept_lens)
+    )
+
+
+def warm(mamba_pool, max_spec_len: int, max_rows: int = 64) -> None:
+    """Compile the cursor/commit variants the switch adds before the server is healthy.
+
+    Every launch uses null rows (-1), so no state or cursor changes.
+    """
+    if not applies(mamba_pool):
+        return
+    from sglang.kernels.ops.attention.fla.gdn_replayssm_spec_decode import (
+        commit_gdn_replayssm_circular,
+        commit_gdn_replayssm_spec,
+    )
+
+    spec_state = mamba_pool.mamba_cache
+    max_cache_len = spec_state.replayssm_d.shape[-2]
+    device = mamba_pool.replayssm_is_flush.device
+    n = 1
+    rows = []
+    while n <= max(1, max_rows):
+        rows.append(n)
+        n *= 2
+    for n in rows:
+        for idt in (torch.int64, torch.int32):
+            replay_idx = torch.full((n,), -1, dtype=idt, device=device)
+            for adt in (torch.int32, torch.int64):
+                acc = torch.zeros(n, dtype=adt, device=device)
+                commit_gdn_replayssm_spec(
+                    write_pos=mamba_pool.replayssm_spec_write_pos,
+                    cache_base=mamba_pool.replayssm_cache_base,
+                    is_flush=mamba_pool.replayssm_is_flush,
+                    num_accepted=acc,
+                    replay_indices=replay_idx,
+                    max_cache_len=max_cache_len,
+                    max_spec_len=max_spec_len,
+                    fold_every_commit=False,
+                    null_block_id=-1,
+                )
+            if n == 1:
+                commit_gdn_replayssm_circular(
+                    **_commit_kwargs(
+                        spec_state,
+                        replay_idx,
+                        replay_idx,
+                        mamba_pool,
+                        torch.zeros(1, dtype=torch.int32, device=device),
+                    )
+                )
+    torch.cuda.synchronize()
+    logger.info(
+        "SGLANG_INFX_REPLAYSSM_AMORTIZE=1: warmed amortized ReplaySSM cursor kernels "
+        f"(rows {rows}, max_spec_len {max_spec_len}, ring {max_cache_len})"
+    )
