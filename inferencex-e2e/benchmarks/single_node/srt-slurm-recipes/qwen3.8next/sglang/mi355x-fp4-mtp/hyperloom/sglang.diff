+                NPR = nq // 64  # wave partials per row
+                am = lds_ld(red, tid * NPR)
+                for k_ in range_constexpr(1, NPR):
+                    am = fx.max(am, lds_ld(red, tid * NPR + k_))
+                am = fx.max(am, fx.Float32(1e-12))
