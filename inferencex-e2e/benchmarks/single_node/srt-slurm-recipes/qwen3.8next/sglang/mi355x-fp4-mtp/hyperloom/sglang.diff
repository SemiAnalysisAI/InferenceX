+            nq = n_elems // 4
+            assert nq % 64 == 0
+            tot = NT * nq
+            NI = (tot + THREADS - 1) // THREADS
+            for i0 in range_constexpr(0, NI, batch):
+                ii = list(range(i0, min(i0 + batch, NI)))
+                qs = [fx.min(tid + i * THREADS, tot - 1) for i in ii]
+                vals = poll(
+                    [
+                        (base_addr, (q // nq) * (n_elems // 2) + (q % nq) * 2, 2)
+                        for q in qs
+                    ],
+                    batch,
+                )
+                for k_ in range_constexpr(len(ii)):
