+                g0_, g1_ = bf2_f32(lds_ld(xi, HO + 128 + fx.min(ht, 127)))
+                gm = fx.max(fx.max(g0_, -g0_), fx.max(g1_, -g1_))
+                for off in (32, 16, 8, 4, 2, 1):
+                    gm = _xred(gm, off, fx.max)
+                if lane == 0:
+                    lds_st(red, wave, gm)
+                gpu.barrier()
+                if ht == 0:
+                    put(
+                        mb(layer, "og_amax"),
+                        t * 24 + h,
+                        fx.max(lds_ld(red, hf * 4), lds_ld(red, hf * 4 + 1)),
+                    )
+                gpu.barrier()
+                _ = yield [fx.Int32(0)]
+
+        # NT * 24 (token, head) tasks fit one loop iteration up to NT = 10: one head per CTA; above, a head pair per
+        # CTA (NT * 12 tasks, one iteration up to NT = 21). Both are bitwise the same per head.
+        # SGLANG_INFX_MONO_ATTN_TASKS off: always one head per CTA (the recipe stage).
+        stage_qsa_merge = [stage_qsa_merge_one, stage_qsa_merge_pair][
+            int(ATT_TF) * int(NT * LY.MERGE_TASKS > G)
