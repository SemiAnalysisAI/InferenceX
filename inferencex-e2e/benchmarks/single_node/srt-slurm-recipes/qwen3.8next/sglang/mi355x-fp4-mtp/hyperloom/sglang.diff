+                            keys + (wave * 256 + digit),
+                            fx.Int32(1),
+                            syncscope="workgroup",
+                        )
+                gpu.barrier()
+                prefix, remain = select_digit(shift, prefix, remain)
+                prefix_mask |= 255 << shift
