+                nb_ = (lds_ld(xi, RQ_P0 + t_ // L) + t_ % L + 1) // 4
+                acc_ = acc_ + fx.max(
+                    (nb_ + LY.SEG_BLOCKS - 1) // LY.SEG_BLOCKS, fx.Int32(1)
+                )
+            lds_st(xi, SL_PFX + NT, acc_)
+        gpu.barrier()
+        tid0 = fx.thread_idx.x
+        stamp("start")
+        if const_expr(first_src == "global"):
