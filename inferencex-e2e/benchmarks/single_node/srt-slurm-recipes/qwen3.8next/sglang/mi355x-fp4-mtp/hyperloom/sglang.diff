+                        # sibling CTA's wave (half 1, same task at the same loop step) adds them
+                        pidx = (
+                            (tc * NPAIR + fx.max(rk, fx.Int32(0))) * (2 * MOE_INTER)
+                            + tile * 16
+                            + rows
+                        )
+                        if kh == 0:
