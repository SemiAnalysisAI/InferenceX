+                        mb(layer, "og_amax"),
+                        t * 24 + h,
+                        fx.max(lds_ld(red, 0), lds_ld(red, 1)),
+                    )
+                gpu.barrier()
+                _ = yield [fx.Int32(0)]
+
+        def stage_qsa_merge_pair(layer):
+            """Task (token, head pair): threads [256 hf, 256 hf + 256) combine the chunk partials of head 2 hp + hf,
+            sigmoid gate -> og. Per-head arithmetic and order are those of one head per task (bitwise); two heads per
