+// SGLANG_INFX_INDEXER_PIPE (r2-indexer-rewrite, design A): QSA grouped target-verify indexer logits.
+// Same math as mqa._tilelang_qsa_mqa_decode_grouped_kernel at group=4 draft rows x 4 heads (16 query
+// columns), head_dim 128, compressed page 16, BF16. Per 16-key page one wave runs the same
+// mfma_f32_16x16x16bf16_1k chain over k-chunks 0..7 (first operand the 16 query columns, second the
+// 16 keys, the operand slices the TileLang kernel feeds), relu, the per-row head sum in head order
+// 0..3 starting from 0, then / Scale: the logits are bitwise identical.
+// What changes: the TileLang kernel stages a 64-key tile through LDS for the whole CTA with two
+// block barriers per tile, and each CTA does about one tile. Here every wave is an independent
+// worker over pages: coalesced 16 B global loads (lane l takes bytes 16 l of each 1 KB quarter of
+// the 4 KB page) go to a wave-private 4 KB LDS slice whose 16 B chunk index is XOR-swizzled by the
+// key row, and are read back in the MFMA operand layout. No block barrier: only the wave touches
+// its slice, and a wave's LDS operations execute in issue order.
+#include <sgl_kernel/tensor.h>
+#include <sgl_kernel/utils.h>
+
+#include <sgl_kernel/utils.cuh>
+
+#include <tvm/ffi/container/tensor.h>
+
+namespace sglang {
+
+namespace qsa_indexer_pipe_detail {
+
+typedef short bf16x4_t __attribute__((ext_vector_type(4)));
+typedef float floatx4_t __attribute__((ext_vector_type(4)));
+
+constexpr int kGroup = 4;      // draft rows per request (one shared page table)
+constexpr int kCols = 16;      // kGroup * index heads
+constexpr int kHeadDim = 128;
+constexpr int kPageSize = 16;  // compressed keys per page
+constexpr int kChunks = kHeadDim / 16;
+constexpr int kSliceU4 = kPageSize * kHeadDim * 2 / 16;  // 4 KB page in 16 B chunks
+
+struct Params {
+  const uint16_t* __restrict__ q;            // [groups, 16, 128] bf16
+  const uint16_t* __restrict__ kcache;       // [pages, 16, 1, 128] bf16
+  const int32_t* __restrict__ page_table;    // [rows, max_pages] (row 4g is group g's table)
+  const int32_t* __restrict__ context_lens;  // [rows]
+  float* __restrict__ logits;                // [rows, max_model_len]
+  int64_t pt_stride;
+  int64_t logits_stride;
+  int max_model_len;
+  int min_scored_len;
+  float scale;
+};
+
+// A wave's LDS operations execute in issue order, so a ds_write by one lane followed by a ds_read of
+// another lane of the same wave sees the data; this only keeps the compiler from reordering them
+// (a wavefront fence would also wait on outstanding global loads).
+#define QSA_PIPE_LDS_ORDER() asm volatile("" ::: "memory")
+
+template <int kWaves, int kCtas>
+__global__ void __launch_bounds__(kWaves * 64) indexer_pipe_kernel(const Params p) {
+  __shared__ uint4 smem[kWaves][kSliceU4];
+  const int g = blockIdx.x;
+  const int lane = threadIdx.x & 63;
+  const int wave = __builtin_amdgcn_readfirstlane(threadIdx.x >> 6);
+  const int row0 = g * kGroup;
+  int max_len = 0;
+#pragma unroll
+  for (int r = 0; r < kGroup; ++r) max_len = max(max_len, p.context_lens[row0 + r]);
+  if (max_len <= p.min_scored_len) return;  // every row of the group selects all its blocks
+  const int num_pages = (max_len + kPageSize - 1) / kPageSize;
+  constexpr int kWorkers = kWaves * kCtas;
+  const int worker = blockIdx.y * kWaves + wave;
+  if (worker >= num_pages) return;
+
+  const int n = lane & 15;     // key within the page (D column); query column for the A operand
+  const int quad = lane >> 4;  // 4-dim slice of each 16-dim chunk; D row block = draft row
+  const int my_len = p.context_lens[row0 + quad];
+  const bool row_scored = my_len > p.min_scored_len;
+
+  // A operand: query column n, dims 16 ki + 4 quad + 0..3.
+  bf16x4_t qa[kChunks];
+  const uint16_t* qrow = p.q + (int64_t)g * kCols * kHeadDim + n * kHeadDim + 4 * quad;
+#pragma unroll
+  for (int ki = 0; ki < kChunks; ++ki) qa[ki] = *reinterpret_cast<const bf16x4_t*>(qrow + 16 * ki);
+
+  const int32_t* pt = p.page_table + (int64_t)row0 * p.pt_stride;
+  float* lrow = p.logits + (int64_t)(row0 + quad) * p.logits_stride;
+  uint4* slice = smem[wave];
+  const int wrow = lane >> 4, wchunk = lane & 15;
+
+  for (int page = worker; page < num_pages; page += kWorkers) {
+    const uint4* kp = reinterpret_cast<const uint4*>(p.kcache + (int64_t)pt[page] * (kPageSize * kHeadDim)) + lane;
+    uint4 v[4];
+#pragma unroll
+    for (int j = 0; j < 4; ++j) v[j] = kp[j * 64];
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+      const int r = j * 4 + wrow;  // key row of bytes [1024 j + 16 lane, +16)
+      slice[r * 16 + (wchunk ^ r)] = v[j];
+    }
+    QSA_PIPE_LDS_ORDER();
+    // B operand: key n, dims 16 ki + 4 quad + 0..3 = half (quad & 1) of 16 B chunk 2 ki + (quad >> 1).
+    bf16x4_t kb[kChunks];
+#pragma unroll
+    for (int ki = 0; ki < kChunks; ++ki) {
+      const int c = 2 * ki + (quad >> 1);
+      kb[ki] = reinterpret_cast<const bf16x4_t*>(&slice[n * 16 + (c ^ n)])[quad & 1];
+    }
+    floatx4_t acc = {0.f, 0.f, 0.f, 0.f};
+#pragma unroll
+    for (int ki = 0; ki < kChunks; ++ki) acc = __builtin_amdgcn_mfma_f32_16x16x16bf16_1k(qa[ki], kb[ki], acc, 0, 0, 0);
+    QSA_PIPE_LDS_ORDER();
+    // acc[i] = query column 4 quad + i (draft row quad, head i) against key n.
+    float red = 0.f;
+#pragma unroll
+    for (int i = 0; i < 4; ++i) red = red + fmaxf(acc[i], 0.f);
+    const int pos = page * kPageSize + n;
+    if (row_scored && pos < my_len && pos < p.max_model_len) lrow[pos] = red / p.scale;
+  }
+}
+
+}  // namespace qsa_indexer_pipe_detail
+
+template <int kWaves, int kCtas>
+struct QsaIndexerPipeKernel {
+  static constexpr auto kernel = qsa_indexer_pipe_detail::indexer_pipe_kernel<kWaves, kCtas>;
+
+  static void
+  run(const tvm::ffi::TensorView q,
+      const tvm::ffi::TensorView kcache,
+      const tvm::ffi::TensorView page_table,
+      const tvm::ffi::TensorView context_lens,
+      const tvm::ffi::TensorView logits,
+      double scale,
+      int64_t min_scored_len) {
+    using namespace host;
+    namespace d = qsa_indexer_pipe_detail;
+    auto G = SymbolicSize{"groups"};
+    auto R = SymbolicSize{"rows"};
+    auto P = SymbolicSize{"pages"};
+    auto MP = SymbolicSize{"max_pages"};
+    auto PS = SymbolicSize{"pt_stride"};
+    auto L = SymbolicSize{"max_model_len"};
+    auto LS = SymbolicSize{"logits_stride"};
+    auto device = SymbolicDevice{};
+    device.set_options<kDLGPU>();
+    TensorMatcher({G, d::kCols, d::kHeadDim}).with_dtype<bf16_t>().with_device(device).verify(q);
+    TensorMatcher({P, d::kPageSize, 1, d::kHeadDim}).with_dtype<bf16_t>().with_device(device).verify(kcache);
+    TensorMatcher({R, MP}).with_strides({PS, 1}).with_dtype<int32_t>().with_device(device).verify(page_table);
+    TensorMatcher({R}).with_dtype<int32_t>().with_device(device).verify(context_lens);
+    TensorMatcher({R, L}).with_strides({LS, 1}).with_dtype<fp32_t>().with_device(device).verify(logits);
+    RuntimeCheck(R.unwrap() == G.unwrap() * d::kGroup, "rows must be 4 x groups");
+    const auto params = d::Params{
+        .q = static_cast<const uint16_t*>(q.data_ptr()),
+        .kcache = static_cast<const uint16_t*>(kcache.data_ptr()),
+        .page_table = static_cast<const int32_t*>(page_table.data_ptr()),
+        .context_lens = static_cast<const int32_t*>(context_lens.data_ptr()),
+        .logits = static_cast<float*>(logits.data_ptr()),
+        .pt_stride = PS.unwrap(),
+        .logits_stride = LS.unwrap(),
+        .max_model_len = static_cast<int>(L.unwrap()),
+        .min_scored_len = static_cast<int>(min_scored_len),
+        .scale = static_cast<float>(scale),
+    };
+    const auto groups = static_cast<uint32_t>(G.unwrap());
+    if (groups == 0) return;
+    LaunchKernel(dim3(groups, kCtas), dim3(kWaves * 64), device.unwrap(), 0)(kernel, params);
+  }
+};
+
+}  // namespace sglang
