+                rq = [_rsq(tt * (1.0 / HIDDEN) + EPS) for tt in tots[HC:]]
+                prods = []
+                for i in range_constexpr(NQ):
+                    a, b = gsel(rk, i), gsel(rq, i)
+                    pr = fx.Float32(0.0)
+                    for e in range_constexpr(4):
