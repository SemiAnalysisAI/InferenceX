+                "a",
+                src,
+                LY.P_HCA_NORM,
+                LY.P_HCA_DOWN,
+                LY.P_HCA_UP,
+                LY.P_HCA_INJ,
+                x_out=ptr(GI, LY.G_FIN_OUT),
+            )
