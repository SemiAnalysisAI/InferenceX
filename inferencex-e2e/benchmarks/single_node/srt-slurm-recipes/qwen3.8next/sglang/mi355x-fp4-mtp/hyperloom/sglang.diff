+                        keys, SCR + 8, fx.Int32(prefix | (fx.Uint32(digit) << shift))
+                    )
+                    lds_st(keys, SCR + 9, remain - above)
+                gpu.barrier()
+                return fx.Uint32(lds_ld(keys, SCR + 8)), lds_ld(keys, SCR + 9)
