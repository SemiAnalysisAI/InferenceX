+                            ptr(GI, LY.G_NGRAM_W)
+                            + ((fx.Int64(hi) << 32) | fx.Int64(fx.Uint32(lo)))
+                            * LY.NGRAM_DIM
+                        )
+                        if lane < DW:
+                            word = fx.Int32(
+                                bo.buffer_load(
+                                    _rsrc(rowaddr), lane, vec_width=1, dtype=T.i32
+                                )
+                            )
+                            one = fx.Float32(1.0).ir_value()
+                            vals = []
+                            for half in range_constexpr(2):
