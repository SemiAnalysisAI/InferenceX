diff --git a/python/sglang/srt/infx_mem_guard.py b/python/sglang/srt/infx_mem_guard.py
new file mode 100644
index 0000000000..2611801837
--- /dev/null
+++ b/python/sglang/srt/infx_mem_guard.py
@@ -0,0 +1,65 @@
+"""SGLANG_INFX_MEM_GUARD (r3-c80b it9, stability): keep device headroom for ROCr scratch.
+
+At C80 with --mem-fraction-static 0.91 the PyTorch caching allocator can grow into the
+whole post-capture headroom (~9.6 GB) during 16k chunk prefill with breakable-graph eager
+breaks. A kernel whose first launch at a new grid size has to grow its queue's scratch
+(private segment) then fails with HIP 701 / HSA_STATUS_ERROR_OUT_OF_RESOURCES, because
+ROCr's scratch allocation cannot ask torch to release cached blocks
+(eval/r3c80b/eval_scratch_oor.py reproduces it). With the switch on, once the scheduler
+has finished init (weights, KV/mamba pools, HiCache device buffers, graphs), the torch
+allocator is capped at its current reservation plus the device's free memory minus
+RESERVE_GB, via torch.cuda.set_per_process_memory_fraction. Over the cap, torch frees its
+cached blocks and retries before it would OOM, so RESERVE_GB stays free for ROCr scratch.
+A daemon thread logs device free / torch reserved / allocated every LOG_S seconds.
+No kernel, numerics or scheduling change. Off: nothing here runs.
+"""
+
+import logging
+import threading
+import time
+
+logger = logging.getLogger(__name__)
+
+RESERVE_GB = 2.0
+LOG_S = 60.0
+_GB = 1 << 30
+
+
+def install(device_index: int) -> None:
+    import torch
+
+    free, total = torch.cuda.mem_get_info(device_index)
+    reserved = torch.cuda.memory_reserved(device_index)
+    reserve = int(RESERVE_GB * _GB)
+    if free < 2 * reserve:
+        reserve = free // 2
+    limit = reserved + max(0, free - reserve)
+    frac = min(1.0, limit / total)
+    torch.cuda.set_per_process_memory_fraction(frac, device_index)
+    logger.info(
+        "SGLANG_INFX_MEM_GUARD=1 on: torch allocator capped at %.2f GB (fraction %.5f); "
+        "device free %.2f GB, torch reserved %.2f GB, kept free for ROCr scratch %.2f GB",
+        limit / _GB, frac, free / _GB, reserved / _GB, reserve / _GB,
+    )
+
+    def _loop():
+        torch.cuda.set_device(device_index)
+        min_free = free
+        while True:
+            time.sleep(LOG_S)
+            try:
+                f, _ = torch.cuda.mem_get_info(device_index)
+                min_free = min(min_free, f)
+                logger.info(
+                    "SGLANG_INFX_MEM_GUARD mem: device free %.2f GB (min %.2f), torch reserved "
+                    "%.2f GB (peak %.2f), allocated %.2f GB",
+                    f / _GB, min_free / _GB,
+                    torch.cuda.memory_reserved(device_index) / _GB,
+                    torch.cuda.max_memory_reserved(device_index) / _GB,
+                    torch.cuda.memory_allocated(device_index) / _GB,
+                )
+            except Exception as e:  # never take the scheduler down for a log line
+                logger.info("SGLANG_INFX_MEM_GUARD mem: probe failed: %s", e)
+                return
+
+    threading.Thread(target=_loop, name="infx-mem-guard", daemon=True).start()
