+"""One-launch replacements for small eager decode-glue chains (spec v2, chain/topk=1 decode).
+
+* fused_simulated_accept: the device half of spec_utils.generate_simulated_accept_index (sim_accept_index build,
+  num_correct_drafts fill, real-draft-token predict writes) in one launch instead of ~10 eager ops. Same values,
+  same writes; the acceptance length itself is still drawn on the CPU by the caller (unchanged RNG use).
+* fused_relay_stash: FutureMap.stash's bonus-token / top-k / hidden-state row scatters (4 index_put + 1 cast)
+  in one launch. Same rows, same casts as the indexed assignments.
+"""
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit(do_not_specialize=["L"])
+def _sim_accept_kernel(
+    acc_ptr,
+    acc_stride,
+    cand_ptr,
+    cand_stride,
+    tp_ptr,
+    tp_stride,
+    pred_ptr,
+    sim_ptr,
+    ncd_ptr,
+    L,
+    W: tl.constexpr,
+    BLOCK: tl.constexpr,
+    REAL: tl.constexpr,
+):
+    b = tl.program_id(0).to(tl.int64)
+    j = tl.arange(0, BLOCK)
+    a0 = tl.load(acc_ptr + b * acc_stride).to(tl.int64)
+    idx = a0 + j
+    tl.store(sim_ptr + b * W + j, tl.where(j < L, idx, -1).to(tl.int32), mask=j < W)
+    tl.store(ncd_ptr + b, (L - 1).to(ncd_ptr.dtype.element_ty))
+    if REAL:
+        c = tl.load(cand_ptr + b * cand_stride + 1 + j, mask=j < L - 1, other=0)
+        t = tl.load(tp_ptr + b * tp_stride + j, mask=j == L - 1, other=0)
+        v = tl.where(j < L - 1, c.to(tl.int64), t.to(tl.int64))
+        tl.store(pred_ptr + idx, v.to(pred_ptr.dtype.element_ty), mask=j < L)
+
+
+def fused_simulated_accept_eligible(accept_index, predict, num_correct_drafts, candidates, target_predict, bs):
+    return (
+        bs > 0
+        and accept_index.is_cuda
+        and accept_index.dim() == 2
+        and predict.dim() == 1
+        and predict.is_contiguous()
+        and num_correct_drafts.is_contiguous()
+        and num_correct_drafts.numel() == bs
+        and candidates.dim() == 2
+        and target_predict is not None
+        and target_predict.dim() == 2
+        and target_predict.is_cuda
+        and candidates.stride(1) == 1
+        and target_predict.stride(1) == 1
+    )
+
+
+def fused_simulated_accept(
+    accept_index, predict, num_correct_drafts, candidates, target_predict, bs, spec_steps, acc_len, real_tokens
+):
+    W = spec_steps + 1
+    sim = torch.empty((bs, W), dtype=torch.int32, device=accept_index.device)
+    _sim_accept_kernel[(bs,)](
+        accept_index,
+        accept_index.stride(0),
+        candidates,
+        candidates.stride(0),
+        target_predict,
+        target_predict.stride(0),
+        predict,
+        sim,
+        num_correct_drafts,
+        acc_len,
+        W=W,
+        BLOCK=triton.next_power_of_2(W),
+        REAL=real_tokens,
+        num_warps=1,
+    )
+    return sim
+
+
+@triton.jit
+def _relay_stash_kernel(
+    idx_ptr,
+    tok_src,
+    tok_dst,
+    p_src,
+    p_dst,
+    i_src,
+    i_dst,
+    h_src,
+    h_dst,
+    P_W: tl.constexpr,
+    I_W: tl.constexpr,
+    H_W: tl.constexpr,
+    HAS_TOPK: tl.constexpr,
+    HAS_HID: tl.constexpr,
+    BLOCK_S: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+):
+    r = tl.program_id(0).to(tl.int64)
+    d = tl.load(idx_ptr + r).to(tl.int64)
+    tl.store(tok_dst + d, tl.load(tok_src + r).to(tok_dst.dtype.element_ty))
+    if HAS_TOPK:
+        s = tl.arange(0, BLOCK_S)
+        pv = tl.load(p_src + r * P_W + s, mask=s < P_W)
+        tl.store(p_dst + d * P_W + s, pv.to(p_dst.dtype.element_ty), mask=s < P_W)
+        iv = tl.load(i_src + r * I_W + s, mask=s < I_W)
+        tl.store(i_dst + d * I_W + s, iv.to(i_dst.dtype.element_ty), mask=s < I_W)
+    if HAS_HID:
+        for off in range(0, H_W, BLOCK_H):
+            h = off + tl.arange(0, BLOCK_H)
+            hv = tl.load(h_src + r * H_W + h, mask=h < H_W)
+            tl.store(h_dst + d * H_W + h, hv.to(h_dst.dtype.element_ty), mask=h < H_W)
+
+
+def _rows_ok(src, dst, n):
+    return (
+        src is not None
+        and dst is not None
+        and src.is_cuda
+        and src.is_contiguous()
+        and dst.is_contiguous()
+        and src.shape[0] == n
+        and src[0].numel() == dst[0].numel()
+    )
+
+
+def fused_relay_stash(indices, tok_src, tok_dst, p_src=None, p_dst=None, i_src=None, i_dst=None, h_src=None, h_dst=None):
+    """Returns False (nothing written) when the inputs do not fit; the caller then runs the indexed assignments."""
+    n = indices.shape[0]
+    if not (indices.is_cuda and indices.is_contiguous() and indices.dim() == 1):
+        return False
+    if not (_rows_ok(tok_src, tok_dst, n) and tok_src[0].numel() == 1):
+        return False
+    has_topk = p_src is not None
+    if has_topk and not (_rows_ok(p_src, p_dst, n) and _rows_ok(i_src, i_dst, n)):
+        return False
+    has_hid = h_src is not None
+    if has_hid and not _rows_ok(h_src, h_dst, n):
+        return False
+    P_W = p_src[0].numel() if has_topk else 1
+    I_W = i_src[0].numel() if has_topk else 1
+    H_W = h_src[0].numel() if has_hid else 1
+    _relay_stash_kernel[(n,)](
+        indices,
+        tok_src,
+        tok_dst,
+        p_src if has_topk else tok_src,
+        p_dst if has_topk else tok_dst,
+        i_src if has_topk else tok_src,
+        i_dst if has_topk else tok_dst,
+        h_src if has_hid else tok_src,
+        h_dst if has_hid else tok_dst,
+        P_W=P_W,
+        I_W=I_W,
+        H_W=H_W,
+        HAS_TOPK=has_topk,
+        HAS_HID=has_hid,
+        BLOCK_S=triton.next_power_of_2(max(P_W, I_W)),
+        BLOCK_H=min(4096, triton.next_power_of_2(H_W)),
+        num_warps=4,
+    )
+    return True
