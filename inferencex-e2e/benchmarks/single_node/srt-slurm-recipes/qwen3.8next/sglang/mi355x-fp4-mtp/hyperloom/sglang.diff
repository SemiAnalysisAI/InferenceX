+                            lds_st(xs, PO + t * 192 + 64 + li_, gvn)
+                            lds_st(xs, PO + t * 192 + 128 + li_, hv[i][e])
+            gpu.barrier()
+            r_cw = _rsrc(ptr(layer, LY.P_PLE_CW))
+            r_ist = _rsrc(ptr(layer, LY.P_PLE_ISTATE))
+            PH = PO + NT * 192  # [S][40] ple_h values
+            if tid < LY.PLE_CH_PER_CTA:
