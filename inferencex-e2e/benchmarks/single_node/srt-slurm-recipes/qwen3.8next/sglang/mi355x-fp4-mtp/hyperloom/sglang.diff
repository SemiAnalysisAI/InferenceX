+@functools.cache
+def build_qwen4_exp_monokernel(
+    plan: tuple,
+    nreq: int,
+    ntok: int,
+    rtt_stride: int = 0,
+    pos_stride: int = 1,
+    map_i64: bool = False,
+    timeline: bool = False,
+    ple_first: bool = False,
+    final_mix: bool = False,
+    prelude: bool = False,
+    eos_token_id: int = 0,
+    iconv_strides: tuple = (30720, 3, 1, 4 * 30720),
+    issm_row: int = 4 * LY.SSM_STEP_WORDS,
+    ple_ist_row: int = 4 * HC_DIM * LY.PLE_STATE_LEN,
+    ictx_row: int = 8,
+    first_src: str = "global",
+    ssm_bf16: bool = False,
+    final_state_inplace: bool = False,
+    op_merge: bool = False,
+    gu_spread: bool = False,
+    dn_pre: int = 0,
