+                                    fx.Float32
+                                )
+                                u_h = accu[ct * 4 + i] + got_h0[2 + i // 2][
+                                    i % 2
+                                ].bitcast(fx.Float32)
+                                hv_h.append(g_h * sigmoid(g_h) * u_h)
