+                            vec_width=1,
+                            dtype=T.bf16,
+                        )
+                    )
+                )
+                r_emb = _rsrc(ptr(GI, LY.G_PLE_EMB))
+                DW = LY.NGRAM_DIM // 4  # 40 dwords per head row
+                for rr in range_constexpr((NH + WAVES - 1) // WAVES):
