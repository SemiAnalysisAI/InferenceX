+
+        def put(base_addr, i, v):
+            bits = v.bitcast(fx.Int32) if isinstance(v, fx.Float32) else fx.Int32(v)
+            bo.buffer_store(
+                fx.Vector.from_elements([bits, tag], fx.Int32),
+                _rsrc(base_addr),
+                i * 2,
+                cache_modifier=CM_DEV,
