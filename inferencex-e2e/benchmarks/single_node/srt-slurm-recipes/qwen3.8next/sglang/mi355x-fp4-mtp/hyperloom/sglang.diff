diff --git a/python/sglang/srt/speculative/fused_sim_accept.py b/python/sglang/srt/speculative/fused_sim_accept.py
new file mode 100644
index 0000000000..0cdce1ee4c
--- /dev/null
+++ b/python/sglang/srt/speculative/fused_sim_accept.py
@@ -0,0 +1,279 @@
+"""One-launch greedy chain verify + simulated acceptance (topk=1, real-draft-token).
+
+Replaces, on the SGLANG_SIMULATE_ACC_LEN path with token mode "real-draft-token"
+and a topk=1 chain, the eager tail of eagle_sample after the target argmax:
+torch.zeros(predict), torch.full(accept_index), VerifyTreeGreedy,
+generate_simulated_accept_index's full/arange/add/fill/index_put ops and the
+accept_lens add -- about 15 launches -- with one Triton program.
+
+Semantics are identical to running VerifyTreeGreedy followed by
+generate_simulated_accept_index (spec_utils.py): the simulated length is still
+sampled on the host by sample_simulated_acc_len (same RNG calls, same order);
+only the device-side writes are fused. eval/eval_fused_sim_accept.py checks the
+outputs bit-for-bit against the reference ops.
+
+Opt-in (integration-r1): SGLANG_INFX_SAMPLE_TAIL=1. Default off = the original op
+sequence. SGLANG_DISABLE_FUSED_SIM_ACCEPT=1 still forces it off.
+"""
+
+import logging
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+logger = logging.getLogger(__name__)
+
+from sglang.srt import infx_knobs
+
+_DISABLED = (not infx_knobs.SAMPLE_TAIL) or os.environ.get(
+    "SGLANG_DISABLE_FUSED_SIM_ACCEPT", "0"
+) in ("1", "true", "True")
+_logged = False
+
+
+def fused_sim_accept_enabled() -> bool:
+    return not _DISABLED
+
+
+@triton.jit
+def _target_argmax_partial_kernel(
+    logits,
+    part_val,
+    part_idx,
+    part_nan,
+    row_stride,
+    vocab_size,
+    NUM_SPLITS: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    # torch.argmax semantics: NaN is the maximum; ties -> first index.
+    row = tl.program_id(0).to(tl.int64)
+    split = tl.program_id(1)
+    offs = split * BLOCK + tl.arange(0, BLOCK)
+    m = offs < vocab_size
+    v = tl.load(logits + row * row_stride + offs, mask=m, other=-float("inf")).to(
+        tl.float32
+    )
+    isnan = (v != v) & m
+    first_nan = tl.min(tl.where(isnan, offs, 2147483647), axis=0)
+    has_nan = first_nan != 2147483647
+    vv = tl.where(isnan, -float("inf"), v)
+    mx = tl.max(vv, axis=0)
+    am = split * BLOCK + tl.argmax(vv, axis=0, tie_break_left=True)
+    o = row * NUM_SPLITS + split
+    tl.store(part_val + o, mx)
+    tl.store(part_idx + o, tl.where(has_nan, first_nan, am).to(tl.int32))
+    tl.store(part_nan + o, has_nan.to(tl.int32))
+
+
+@triton.jit(do_not_specialize=["BS", "SIM_LEN"])
+def _fused_greedy_sim_accept_kernel(
+    predict_ptr,  # int32 [BS * D]   out
+    accept_ptr,  # int32 [BS, NSPEC] out (simulated accept index)
+    accept_lens_ptr,  # int32 [BS]   out (= simulated len)
+    cand_ptr,  # int [BS, D]
+    tpred_ptr,  # int64 [BS * D]
+    ri_ptr,  # int64 [BS, D] retrieve_index
+    nt_ptr,  # int64 [BS, D] retrieve_next_token
+    sib_ptr,  # int64 [BS, D] retrieve_next_sibling
+    part_val,
+    part_idx,
+    part_nan,
+    BS,
+    SIM_LEN,
+    D: tl.constexpr,
+    NSPEC: tl.constexpr,
+    DP2: tl.constexpr,
+    SP2: tl.constexpr,
+    NUM_SPLITS: tl.constexpr,
+    NSP2: tl.constexpr,
+    FROM_PARTIALS: tl.constexpr,
+):
+    b = tl.program_id(0).to(tl.int64)
+    row = b * D
+    lane = tl.arange(0, DP2)
+    offs = row + lane  # flat predict indices owned by this request
+    lane_ok = lane < D
+    pred = tl.zeros([DP2], dtype=tl.int64)
+
+    if FROM_PARTIALS:
+        # finalize the split argmax of this request's D target rows into tpred
+        sp = tl.arange(0, NSP2)
+        pm = lane_ok[:, None] & (sp[None, :] < NUM_SPLITS)
+        po = offs[:, None] * NUM_SPLITS + sp[None, :]
+        pv = tl.load(part_val + po, mask=pm, other=-float("inf"))
+        pi = tl.load(part_idx + po, mask=pm, other=0)
+        pn = tl.load(part_nan + po, mask=pm, other=0)
+        nan_split = tl.min(tl.where(pn != 0, sp[None, :], NSP2), axis=1)
+        best_split = tl.argmax(pv, axis=1, tie_break_left=True)
+        pick = tl.where(nan_split < NSP2, nan_split, best_split)
+        tok = tl.sum(tl.where(sp[None, :] == pick[:, None], pi, 0), axis=1)
+        tl.store(tpred_ptr + offs, tok.to(tl.int64), mask=lane_ok)
+        tl.debug_barrier()
+
+    # ---- VerifyTreeGreedy (eagle.cuh), sibling walk bounded by D ----
+    last = tl.load(ri_ptr + row).to(tl.int64)
+    cur = tl.zeros([], dtype=tl.int64)
+    alive = tl.full([], 1, tl.int1)
+    for j in tl.static_range(1, NSPEC):
+        c = tl.load(nt_ptr + row + cur, mask=alive, other=-1).to(tl.int64)
+        found = tl.full([], 0, tl.int1)
+        for s in tl.static_range(D):
+            valid = alive & (c != -1) & (found == 0)
+            di = tl.load(ri_ptr + row + c, mask=valid, other=0).to(tl.int64)
+            dt = tl.load(cand_ptr + row + c, mask=valid, other=0).to(tl.int64)
+            tt = tl.load(tpred_ptr + last, mask=valid, other=0).to(tl.int64)
+            hit = valid & (dt == tt)
+            pred = tl.where(hit & (offs == last), tt, pred)
+            last = tl.where(hit, di, last)
+            found = found | hit
+            miss = valid & (hit == 0)
+            nxt = tl.load(sib_ptr + row + c, mask=miss, other=-1).to(tl.int64)
+            c = tl.where(miss, nxt, c)
+        cur = tl.where(found, c, cur)
+        alive = alive & found
+    tlast = tl.load(tpred_ptr + last).to(tl.int64)
+    pred = tl.where(offs == last, tlast, pred)
+
+    # ---- generate_simulated_accept_index (real-draft-token) ----
+    first = tl.load(ri_ptr + row).to(tl.int64)  # == greedy accept_index[b, 0]
+    k = offs - first
+    dmask = lane_ok & (k >= 0) & (k < SIM_LEN - 1)
+    cv = tl.load(cand_ptr + row + k + 1, mask=dmask, other=0).to(tl.int64)
+    pred = tl.where(dmask, cv, pred)
+    bmask = lane_ok & (k == SIM_LEN - 1)
+    bv = tl.load(tpred_ptr + row + SIM_LEN - 1)
+    pred = tl.where(bmask, bv.to(tl.int64), pred)
+    tl.store(predict_ptr + offs, pred.to(tl.int32), mask=lane_ok)
+
+    sl = tl.arange(0, SP2)
+    acc = tl.where(sl < SIM_LEN, first + sl, -1)
+    tl.store(accept_ptr + b * NSPEC + sl, acc.to(tl.int32), mask=sl < NSPEC)
+    tl.store(accept_lens_ptr + b, (tl.zeros([], dtype=tl.int32) + SIM_LEN).to(tl.int32))
+
+
+def fused_greedy_sim_accept(
+    candidates: torch.Tensor,  # [bs, D]
+    target_predict: torch.Tensor,  # [bs, D] int64
+    retrieve_index: torch.Tensor,
+    retrieve_next_token: torch.Tensor,
+    retrieve_next_sibling: torch.Tensor,
+    num_spec_tokens: int,
+    sim_len: int,
+):
+    """Returns (predict int32 [bs*D], accept_lens int32 [bs], accept_index int32 [bs, NSPEC])."""
+    global _logged
+    bs, d = candidates.shape
+    device = candidates.device
+    predict = torch.empty((bs * d,), dtype=torch.int32, device=device)
+    accept_index = torch.empty((bs, num_spec_tokens), dtype=torch.int32, device=device)
+    accept_lens = torch.empty((bs,), dtype=torch.int32, device=device)
+    if not _logged:
+        logger.info(
+            "fused greedy+simulated accept kernel active "
+            "(SGLANG_INFX_SAMPLE_TAIL=1), D=%d NSPEC=%d",
+            d,
+            num_spec_tokens,
+        )
+        _logged = True
+    if bs == 0:
+        return predict, accept_lens, accept_index
+    _fused_greedy_sim_accept_kernel[(bs,)](
+        predict,
+        accept_index,
+        accept_lens,
+        candidates.contiguous(),
+        target_predict.contiguous(),
+        retrieve_index.contiguous(),
+        retrieve_next_token.contiguous(),
+        retrieve_next_sibling.contiguous(),
+        accept_lens,
+        accept_lens,
+        accept_lens,
+        bs,
+        sim_len,
+        D=d,
+        NSPEC=num_spec_tokens,
+        DP2=triton.next_power_of_2(d),
+        SP2=triton.next_power_of_2(num_spec_tokens),
+        NUM_SPLITS=1,
+        NSP2=1,
+        FROM_PARTIALS=False,
+        num_warps=1,
+    )
+    return predict, accept_lens, accept_index
+
+
+_ARGMAX_BLOCK = 4096
+
+
+def fused_verify_sim_accept_from_logits(
+    logits: torch.Tensor,  # [bs * D, vocab]
+    candidates: torch.Tensor,
+    retrieve_index: torch.Tensor,
+    retrieve_next_token: torch.Tensor,
+    retrieve_next_sibling: torch.Tensor,
+    num_spec_tokens: int,
+    sim_len: int,
+):
+    """argmax(logits) (torch semantics) + greedy chain verify + simulated accept, 2 launches."""
+    global _logged
+    bs, d = candidates.shape
+    device = candidates.device
+    rows, vocab = logits.shape
+    assert rows == bs * d and logits.stride(1) == 1
+    if not _logged:
+        logger.info(
+            "fused greedy+simulated accept kernel active "
+            "(SGLANG_INFX_SAMPLE_TAIL=1), D=%d NSPEC=%d",
+            d,
+            num_spec_tokens,
+        )
+        _logged = True
+    # one int32 allocation: outputs first, then argmax scratch (int64 tpred
+    # starts at an even offset).
+    ns = triton.cdiv(vocab, _ARGMAX_BLOCK)
+    n_pred, n_acc, n_len = bs * d, bs * num_spec_tokens, bs
+    o_part = n_pred + n_acc + n_len
+    o_tp = o_part + 3 * rows * ns
+    o_tp += o_tp & 1
+    buf = torch.empty((o_tp + 2 * rows,), dtype=torch.int32, device=device)
+    predict = buf[:n_pred]
+    accept_index = buf[n_pred : n_pred + n_acc].view(bs, num_spec_tokens)
+    accept_lens = buf[n_pred + n_acc : o_part]
+    if bs == 0:
+        return predict, accept_lens, accept_index
+    part_val = buf[o_part : o_part + rows * ns].view(torch.float32)
+    part_idx = buf[o_part + rows * ns : o_part + 2 * rows * ns]
+    part_nan = buf[o_part + 2 * rows * ns : o_part + 3 * rows * ns]
+    tpred = buf[o_tp : o_tp + 2 * rows].view(torch.int64)
+    _target_argmax_partial_kernel[(rows, ns)](
+        logits, part_val, part_idx, part_nan, logits.stride(0), vocab,
+        NUM_SPLITS=ns, BLOCK=_ARGMAX_BLOCK, num_warps=8,
+    )
+    _fused_greedy_sim_accept_kernel[(bs,)](
+        predict,
+        accept_index,
+        accept_lens,
+        candidates.contiguous(),
+        tpred,
+        retrieve_index.contiguous(),
+        retrieve_next_token.contiguous(),
+        retrieve_next_sibling.contiguous(),
+        part_val,
+        part_idx,
+        part_nan,
+        bs,
+        sim_len,
+        D=d,
+        NSPEC=num_spec_tokens,
+        DP2=triton.next_power_of_2(d),
+        SP2=triton.next_power_of_2(num_spec_tokens),
+        NUM_SPLITS=ns,
+        NSP2=triton.next_power_of_2(ns),
+        FROM_PARTIALS=True,
+        num_warps=1,
+    )
+    return predict, accept_lens, accept_index
