+        def combine_specs(layer, hc, src, rg):
+            """Poll specs of combine_rows' single round (32 T <= THREADS, src a mailbox): residual word + the
+            MIX_KSPLIT combine-gate partials of (t, b); lanes past 32 T re-read the last valid (t, b, p)."""
+            NCT = 32 * NT
+            q = fx.min(tid, NCT - 1)
+            t = q // 32
+            b = (q % 32) // 8
+            p = q % 8
+            row = b * HIDDEN + rg * 16 + p * 2
+            injp = mb(layer, hc + ".injp")
+            return [(src[1], t * (HC_DIM // 2) + row // 2, 1)] + [
+                (injp, (s_ * NT + t) * 4 + b, 1) for s_ in range(LY.MIX_KSPLIT)
+            ]
+
+        def combine_rows(
