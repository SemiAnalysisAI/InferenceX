+                ilog = (nb > 0).select(
+                    mb(layer, "ilog") + fx.Int64(t) * (LY.MAX_BLOCKS * 8),
+                    mb(layer, "qi"),
+                )
+                got = poll([(ilog, fx.min(i, last), 1) for i in item_idx], ITEMS)
