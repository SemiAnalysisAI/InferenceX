+    R, L = nreq, ntok
+    NT = R * L
+    # SGLANG_INFX_MONO_GLUE: pairs per all-to-all partial mailbox entry (LY.MB_SPREAD). 1 = recipe layout and
+    # addressing (the helper below returns its argument unchanged, so the traced IR is the recipe's). A closure
+    # scalar, so it enters the FlyDSL kernel cache key.
