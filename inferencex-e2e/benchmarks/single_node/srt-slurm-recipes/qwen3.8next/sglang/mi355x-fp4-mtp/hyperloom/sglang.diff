+// SGLANG_INFX_TOPK_EXACT (r2-c16 it13): exact radix select over the whole row in global
+// memory (4 MSB-first 8-bit passes of the fp32 key, then one write pass). Used only for a
+// row whose threshold-bin candidates overflowed the SMEM_INPUT_SIZE shared buffer in
+// radix_select_topk (those candidates were dropped, so its selection was not the top-k).
+// Rows that never overflow keep the shared-memory path and its exact selected set.
+template <int kTopK>
+SGL_DEVICE void exact_radix_topk(const float* __restrict__ input, int* __restrict__ index, int row_start, int length) {
+  constexpr int RADIX = 256;
+  constexpr int BLOCK_SIZE = static_cast<int>(kThreadsPerBlock);
+  __shared__ int s_xhist[RADIX];
+  __shared__ int s_xsuf[2][RADIX + 1];
+  __shared__ uint32_t s_xprefix, s_xmask;
+  __shared__ int s_xremain, s_xcnt_gt, s_xcnt_eq;
+  const int tx = threadIdx.x;
+  if (tx == 0) {
+    s_xprefix = 0u;
+    s_xmask = 0u;
+    s_xremain = kTopK;
+    s_xcnt_gt = 0;
+    s_xcnt_eq = 0;
+  }
+  __syncthreads();
+  for (int shift = 24; shift >= 0; shift -= 8) {
+    const uint32_t prefix = s_xprefix;
+    const uint32_t mask = s_xmask;
+    const int remain = s_xremain;
+    if (remain == 0) break;  // block-uniform (read after a barrier)
+    if (tx < RADIX) s_xhist[tx] = 0;
+    __syncthreads();
+    for (int idx = tx; idx < length; idx += BLOCK_SIZE) {
+      const uint32_t key = convert_to_uint32(input[idx + row_start]);
+      if ((key & mask) == prefix) ::atomicAdd(&s_xhist[(key >> shift) & 0xFF], 1);
+    }
+    __syncthreads();
+    if (tx < RADIX) s_xsuf[0][tx] = s_xhist[tx];
+    if (tx == RADIX) {
+      s_xsuf[0][RADIX] = 0;
+      s_xsuf[1][RADIX] = 0;
+    }
+    __syncthreads();
+#pragma unroll
+    for (int i = 0; i < 8; ++i) {  // suffix sums; 8 steps -> result in s_xsuf[0]
+      const int k = i & 1;
+      if (tx < RADIX) {
+        int v = s_xsuf[k][tx];
+        if (tx + (1 << i) < RADIX) v += s_xsuf[k][tx + (1 << i)];
+        s_xsuf[k ^ 1][tx] = v;
+      }
+      __syncthreads();
+    }
+    // candidates with this prefix number > remain, so exactly one bin b has
+    // suffix(b) > remain >= suffix(b + 1)
+    if (tx < RADIX && s_xsuf[0][tx] > remain && s_xsuf[0][tx + 1] <= remain) {
+      s_xprefix = prefix | (static_cast<uint32_t>(tx) << shift);
+      s_xmask = mask | (0xFFu << shift);
+      s_xremain = remain - s_xsuf[0][tx + 1];
+    }
+    __syncthreads();
+  }
+  const uint32_t P = s_xprefix;
+  const uint32_t M = s_xmask;
+  const int R = s_xremain;  // ties at the full key P still to take
+  for (int idx = tx; idx < length; idx += BLOCK_SIZE) {
+    const uint32_t mk = convert_to_uint32(input[idx + row_start]) & M;
+    if (mk > P) {
+      const int pos = ::atomicAdd(&s_xcnt_gt, 1);
+      index[pos] = idx;
+    } else if (R > 0 && mk == P) {
+      const int pos = ::atomicAdd(&s_xcnt_eq, 1);
+      if (pos < R) index[kTopK - R + pos] = idx;
+    }
+  }
+  __syncthreads();
+}
