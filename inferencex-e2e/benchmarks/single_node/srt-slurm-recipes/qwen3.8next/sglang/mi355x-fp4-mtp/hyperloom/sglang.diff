+                task = bid + it * MG
+                t = task // (LY.MERGE_TASKS // 2)
+                h = (task % (LY.MERGE_TASKS // 2)) * 2 + hf
+                part = mb(layer, "part")
+                NC = LY.ATT_CHUNKS
+                tb = t * LY.ATT_TASKS * LY.PART_STRIDE
+                if ht < NC:
+                    pb = tb + ht * LY.PART_STRIDE + 24 * 256
+                    ml = poll([(part, pb + h, 1), (part, pb + 24 + h, 1)])
+                    lds_st(xs, HO + ht, ml[0][0].bitcast(fx.Float32))
+                    lds_st(xs, HO + 64 + ht, ml[1][0].bitcast(fx.Float32))
+                gpu.barrier()
+                d = ht
+                M = lds_ld(xs, HO)
+                for cc in range_constexpr(1, NC):
+                    M = fx.max(M, lds_ld(xs, HO + cc))
+                L = fx.Float32(0.0)
+                O = fx.Float32(0.0)
+                got = poll(
+                    [
+                        (part, tb + cc * LY.PART_STRIDE + h * 256 + d, 1)
+                        for cc in range(NC)
+                    ]
+                    + [(qp, t * (LY.QP_ROWS // 2) + (h * 512 + 256 + d) // 2, 1)],
+                    NC + 1,
+                )
+                for cc in range_constexpr(NC):
+                    mc = lds_ld(xs, HO + cc)
+                    wgt = (mc > NEG_INF * 0.5).select(_exp(mc - M), fx.Float32(0.0))
+                    L = L + wgt * lds_ld(xs, HO + 64 + cc)
+                    O = O + wgt * got[cc][0].bitcast(fx.Float32)
