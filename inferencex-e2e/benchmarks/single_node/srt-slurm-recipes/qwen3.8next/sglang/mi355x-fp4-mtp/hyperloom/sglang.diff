+            gus = ptr(layer, LY.P_GU_S)
+            mid = mb(layer, "mid")
+            gupart = mb(layer, "gupart") if KPG == 2 else None
+            ns = n_slots()
+            TPS = LY.GU_PAIRS  # tasks per slot
+            ntask = ns * TPS
