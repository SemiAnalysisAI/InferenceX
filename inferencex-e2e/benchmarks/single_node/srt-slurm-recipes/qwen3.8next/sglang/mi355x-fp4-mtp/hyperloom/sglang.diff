+                lane = tid % 64
+                wave = tid // 64
+                stamp(f"L{li}.qsa_proj")
+                stage_qsa_prep(li)
+                tid = _opaque_i32(tid0)
+                lane = tid % 64
+                wave = tid // 64
+                stamp(f"L{li}.qsa_prep")
+                stage_qsa_scores(li)
+                tid = _opaque_i32(tid0)
+                lane = tid % 64
+                wave = tid // 64
