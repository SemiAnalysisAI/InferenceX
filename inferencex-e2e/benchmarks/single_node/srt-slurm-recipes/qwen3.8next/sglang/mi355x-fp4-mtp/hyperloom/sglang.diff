+                            base = (
+                                (tc * NPAIR + rk) * MOE_INTER + tile * 16 + rows
+                            ) // 2
+                            put_bf(mid, base, hv[0], hv[1])
+                            put_bf(mid, base + 1, hv[2], hv[3])
+                    else:
