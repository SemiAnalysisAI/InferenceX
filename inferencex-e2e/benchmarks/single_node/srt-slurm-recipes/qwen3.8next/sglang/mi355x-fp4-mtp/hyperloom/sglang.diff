+// SGLANG_INFX_TOPK_EXACT fast fallback: one global pass builds a 4096-bin histogram of the
+// fp32 key's top 12 bits, a second pass writes the rows above the threshold bin and gathers the
+// bin's candidates (index + key) into the 32 KB dynamic buffer, then 8/8/4-bit radix rounds
+// over the candidates in LDS finish the exact selection. A threshold bin above 4096 candidates
+// (never seen on real rows) takes exact_radix_topk.
+template <int kTopK>
+SGL_DEVICE void exact_topk_fallback(const float* __restrict__ input, int* __restrict__ index, int row_start, int length) {
+  constexpr int BLOCK_SIZE = static_cast<int>(kThreadsPerBlock);
+  constexpr int NB = 4096;
+  constexpr int PER = NB / BLOCK_SIZE;
+  constexpr int CAP = static_cast<int>(kSmemBytes / sizeof(int)) - NB;
+  static_assert(CAP >= 4096 && NB % BLOCK_SIZE == 0);
