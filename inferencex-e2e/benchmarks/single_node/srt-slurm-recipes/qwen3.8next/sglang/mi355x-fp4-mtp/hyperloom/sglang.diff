+                        HIDDEN,
+                        bcolq(GU_ACT, S_GU, (u % KTP) * 64),
+                    ),
+                    2 * KTP,
+                    KTP // 2,
+                    acc_of=lambda u: 0 if u < KTP else 1,
+                    nacc=2,
