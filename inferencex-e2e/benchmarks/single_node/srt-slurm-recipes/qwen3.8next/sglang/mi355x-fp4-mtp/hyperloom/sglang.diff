+                sel = mb(layer, "sel") + fx.Int64(t) * (LY.SEL_STRIDE * 8)
+                cs = t * LY.NSEG_MAX + sg
+                if nseg == 1:
+                    radix_topk(
+                        item_keys,
+                        item_ok,
+                        topk,
+                        lambda slot, jj: put_sel(sel, slot, item_idx[jj], item_loc[jj]),
+                    )
+                    if tid == 0:
+                        put(sel, 1024, topk)
+                else:
+                    ck = mb(layer, "cand_k")
+                    cbl = mb(layer, "cand_bl")
+
+                    def emit(slot, jj):
+                        put(ck, cs * 512 + slot, got[jj][0])
