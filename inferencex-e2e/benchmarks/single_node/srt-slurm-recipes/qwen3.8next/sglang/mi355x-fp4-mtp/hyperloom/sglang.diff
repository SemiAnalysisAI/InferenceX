+                    per_group(
+                        [
+                            g_[0] * g_[0]
+                            + g_[1] * g_[1]
+                            + g_[2] * g_[2]
+                            + g_[3] * g_[3]
+                            for g_ in gv
+                        ]
+                    )
+                )
+                rc = [_rsq(tt * (1.0 / HIDDEN) + EPS) for tt in tc]
+                for i in range_constexpr(NQ):
