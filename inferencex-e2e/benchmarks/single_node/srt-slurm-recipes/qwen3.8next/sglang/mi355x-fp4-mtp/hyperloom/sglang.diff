+        r_ptab = _rsrc(ptab)
+
+        # ------------------------------------------------------------ helpers
+        def ptr(layer, slot):
+            pv = fx.Vector(
+                bo.buffer_load(
+                    r_ptab, (layer * LY.N_PTR + slot) * 2, vec_width=2, dtype=T.i32
