+    def _try_flydsl_prefill(
+        self, q, k, v, indices, query_lens, prefix_lens, scale
+    ) -> Optional[torch.Tensor]:
+        """aiter#7556's sparse prefill of the operands the Triton path takes, or None
+        to keep Triton: the op unavailable, an operand rule it names, or a stream
+        capture (the op refuses to plan a new layout while capturing)."""
+        op = _resolve_flydsl_sparse_prefill()
+        if op is None:
+            return None
+        kwargs = dict(
+            query_lens=tuple(query_lens),
+            prefix_lens=tuple(prefix_lens),
+            softmax_scale=scale,
+        )
+        calls = [(q, k, v)]
+        kv_heads = k.shape[1]
+        if _AMD_QSA_FLYDSL_PREFILL == "perhead" and kv_heads > 1:
+            if q.shape[1] % kv_heads:
+                _log_flydsl_prefill_fallback(
+                    "the per-head split needs whole Q head groups per KV head"
+                )
+                return None
+            # Q's head group copied contiguous; K/V as strided one-head views.
+            group = q.shape[1] // kv_heads
+            calls = [
+                (
+                    q[:, h * group : (h + 1) * group].contiguous(),
+                    k[:, h : h + 1],
+                    v[:, h : h + 1],
+                )
+                for h in range(kv_heads)
+            ]
+        for call in calls:
+            problem = op.qsa_sparse_prefill_problem(*call, indices, **kwargs)
+            if problem is not None:
+                _log_flydsl_prefill_fallback(problem)
+                return None
+        if torch.cuda.is_current_stream_capturing():
+            _log_flydsl_prefill_fallback("stream capture")
+            return None
+        outputs = [
+            op.flydsl_qsa_sparse_prefill(*call, indices, **kwargs) for call in calls
+        ]
+        return outputs[0] if len(outputs) == 1 else torch.cat(outputs, dim=1)
+
+    def _warm_flydsl_prefill(self) -> None:
+        """Compile the FlyDSL prefill kernels of each attention geometry of the model
+        once per process, so that no served prefill compiles them."""
+        from sglang.srt.layers.radix_attention import RadixAttention
+
+        op = _resolve_flydsl_sparse_prefill()
+        model = getattr(self.runner, "model", None)
+        if (
+            op is None
+            or model is None
+            or self.qsa_profile is None
+            or self.device is None
+        ):
+            logger.warning(
+                "amd qsa flydsl prefill: no warm-up (op %s, model %s, QSA profile "
+                "%s, device %s); a served prefill compiles each kernel it first uses",
+                op is not None,
+                model is not None,
+                self.qsa_profile is not None,
+                self.device,
+            )
+            return
+        width = self.qsa_profile.budget + self.qsa_profile.compress_ratio - 1
+        geometries = {
+            (m.tp_q_head_num, m.tp_k_head_num, m.qk_head_dim, m.scaling)
+            for m in model.modules()
+            if isinstance(m, RadixAttention)
+        }
+        for heads, kv_heads, head_dim, scale in sorted(geometries):
+            key = (_AMD_QSA_FLYDSL_PREFILL, heads, kv_heads, head_dim, scale, width)
+            if key in _FLYDSL_PREFILL_WARMED:
+                continue
+            _FLYDSL_PREFILL_WARMED.add(key)
+            # The op's warm-up plans for the head counts of one call.
+            split = kv_heads if _AMD_QSA_FLYDSL_PREFILL == "perhead" else 1
+
+            def run(q, indices, query_lens, prefix_lens):
+                q = q.repeat(1, split, 1)
+                k = q.new_zeros(q.shape[0], kv_heads, head_dim)
+                output = self._try_flydsl_prefill(
+                    q, k, torch.zeros_like(k), indices, query_lens, prefix_lens, scale
+                )
+                return output is not None
+
+            warmed = op.qsa_sparse_prefill_warmup(
+                run,
+                num_q_heads=heads // split,
+                num_kv_heads=kv_heads // split,
+                selection_width=width,
+                device=self.device,
+            )
+            logger.info(
+                "amd qsa flydsl prefill %s: warmed q_heads=%d kv_heads=%d "
+                "head_dim=%d scale=%s width=%d layouts=%s",
+                _AMD_QSA_FLYDSL_PREFILL,
+                heads,
+                kv_heads,
+                head_dim,
+                scale,
+                width,
+                warmed,
+            )
+
