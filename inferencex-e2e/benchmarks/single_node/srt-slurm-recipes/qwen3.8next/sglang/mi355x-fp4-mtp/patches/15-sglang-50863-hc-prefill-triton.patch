@@ -0,0 +1,343 @@
+"""Prefill-sized Qwen gated-residual HC site (hc_per_branch_norm) on gfx950.
+
+Rows above the decode fused cap otherwise take GroupedGemmaRMSNorm, the
+torch.compile'd ``_mix_compute`` (two GEMMs and pointwise kernels) and the JIT
+``hc_combine``, which reads the normed residual again only for its HC-wide inject
+projection. Here the normed residual is never materialized:
+
+* ``hcp_mix``: the down and inject projections run on hipBLASLt as one batched GEMM
+  over the HC branches of the raw residual ``h``, against weights with the Gemma
+  norm's ``(1 + w)`` folded in (``HcpWeights``). A finish kernel scales each branch's
+  partial by that branch's ``rstd``, applies SiLU(. / HC) and returns the inject
+  logits. The up kernel rebuilds the gate operand as ``h * rstd_b * (1 + w)`` and
+  runs the up projection, the sigmoid and the branch mean.
+* ``hcp_combine``: elementwise ``h + y * 2 sigmoid(g / HC)`` from the inject logits,
+  the form of ``hc_fused_flydsl.hc_apply_inject``. Like it, it also returns the
+  per-branch partial sums of squares of its output, which the next site's mix takes
+  instead of reading ``h`` one more time; without them the mix computes them itself.
+
+M is a runtime argument that Triton does not specialize: after the first call per
+config a new row count compiles nothing, and every launch is CUDA-graph capturable.
+
+Numerics differ from the unfused path only by rounding points: ``(1 + w)`` is
+rounded into the BF16 down / inject weights, each branch's down partial is rounded
+to BF16 before its rstd scaling, the normed residual is never rounded to BF16, and
+the up projection stays FP32 up to the sigmoid.
+"""
+
+import torch
+import triton
+import triton.language as tl
+from triton.language.extra.hip import libdevice
+
+
+@triton.jit
+def _sigmoid(v):
+    # gfx950: v_exp_f32 + v_rcp_f32; 1 / (1 + tl.exp(-v)) lowers to the IEEE division
+    # sequence (24 VALU instructions instead of 7).
+    return libdevice.fast_dividef(1.0, 1.0 + libdevice.fast_expf(-v))
+
+
+@triton.jit(do_not_specialize=["M"])
+def _hcp_sumsq_kernel(
+    h_ptr,
+    ss_ptr,
+    M,
+    HS: tl.constexpr,
+    HC: tl.constexpr,
+    BM: tl.constexpr,
+    BK: tl.constexpr,
+):
+    """ss[M, HC, 1]: per-branch sums of squares of h[M, HC*HS].
+
+    Grid (cdiv(M, BM), HC)."""
+    K: tl.constexpr = HC * HS
+    b = tl.program_id(1)
+    rows = tl.program_id(0) * BM + tl.arange(0, BM)
+    rmask = rows < M
+    rows64 = rows.to(tl.int64)
+    acc = tl.zeros([BM, BK], tl.float32)
+    for k0 in range(0, HS, BK):
+        x = tl.load(
+            h_ptr + rows64[:, None] * K + b * HS + k0 + tl.arange(0, BK)[None, :],
+            mask=rmask[:, None],
+            other=0.0,
+        ).to(tl.float32)
+        acc += x * x
+    tl.store(ss_ptr + rows64 * HC + b, tl.sum(acc, axis=1), mask=rmask)
+
+
+@triton.jit(do_not_specialize=["M"])
+def _hcp_finish_kernel(
+    p_ptr,
+    ss_ptr,
+    t_ptr,
+    g_ptr,
+    s_ptr,
+    M,
+    eps,
+    HS: tl.constexpr,
+    HC: tl.constexpr,
+    R: tl.constexpr,
+    NI: tl.constexpr,
+    NP: tl.constexpr,
+    NSS: tl.constexpr,
+    BM: tl.constexpr,
+    BC: tl.constexpr,
+):
+    """Per-branch down / inject partials p[HC, M, NP] and partial sums of squares
+    ss[M, HC, NSS] -> t = SiLU(sum_b rstd_b p_b / HC) [M, R] BF16, inject logits
+    g = sum_b rstd_b p_b [M, NI] FP32 and s = rstd [M, HC] FP32.
+    Grid (cdiv(M, BM), cdiv(R + NI, BC))."""
+    rows = tl.program_id(0) * BM + tl.arange(0, BM)
+    rmask = rows < M
+    rows64 = rows.to(tl.int64)
+    cols = tl.program_id(1) * BC + tl.arange(0, BC)
+    acc = tl.zeros([BM, BC], tl.float32)
+    for b in tl.static_range(HC):
+        ss = tl.zeros([BM], tl.float32)
+        for i in tl.static_range(NSS):
+            ss += tl.load(ss_ptr + (rows64 * HC + b) * NSS + i, mask=rmask, other=0.0)
+        rstd = tl.math.rsqrt(ss / HS + eps)
+        if tl.program_id(1) == 0:
+            tl.store(s_ptr + rows64 * HC + b, rstd, mask=rmask)
+        pv = tl.load(
+            p_ptr + b * M.to(tl.int64) * NP + rows64[:, None] * NP + cols[None, :],
+            mask=rmask[:, None] & (cols < R + NI)[None, :],
+            other=0.0,
+        ).to(tl.float32)
+        acc += pv * rstd[:, None]
+    v = acc / HC
+    tl.store(
+        t_ptr + rows64[:, None] * R + cols[None, :],
+        (v * _sigmoid(v)).to(tl.bfloat16),
+        mask=rmask[:, None] & (cols < R)[None, :],
+    )
+    if NI > 0:
+        tl.store(
+            g_ptr + rows64[:, None] * NI + (cols - R)[None, :],
+            acc,
+            mask=rmask[:, None] & ((cols >= R) & (cols < R + NI))[None, :],
+        )
+
+
+@triton.jit(do_not_specialize=["M"])
+def _hcp_up_kernel(
+    t_ptr,
+    wu_ptr,
+    h_ptr,
+    s_ptr,
+    nw_ptr,
+    o_ptr,
+    M,
+    HS: tl.constexpr,
+    HC: tl.constexpr,
+    R: tl.constexpr,
+    BM: tl.constexpr,
+    BJ: tl.constexpr,
+    BR: tl.constexpr,
+):
+    """o[m, j] = mean_b sigmoid(t[m] . up[n]) * h[m, n] * s[m, b] * (1 + w[n]),
+    n = b*HS + j.
+
+    Grid (cdiv(M, BM), HS // BJ). One [BM, HC*BJ] GEMM tile per CTA whose columns are
+    the HC branches' copies of hidden units j; the rank R is the K loop in BR chunks,
+    and the branch mean reduces the tile's HC column groups.
+    """
+    K: tl.constexpr = HC * HS
+    NB: tl.constexpr = HC * BJ
+    rows = tl.program_id(0) * BM + tl.arange(0, BM)
+    rmask = rows < M
+    rows64 = rows.to(tl.int64)
+    pid_j = tl.program_id(1)
+    c = tl.arange(0, NB)
+    branch = c // BJ
+    n = branch * HS + pid_j * BJ + c % BJ
+    acc = tl.zeros([BM, NB], tl.float32)
+    for r0 in range(0, R, BR):
+        rr = r0 + tl.arange(0, BR)
+        tt = tl.load(
+            t_ptr + rows64[:, None] * R + rr[None, :], mask=rmask[:, None], other=0.0
+        )
+        w = tl.load(wu_ptr + n[:, None] * R + rr[None, :])
+        acc = tl.dot(tt, tl.trans(w), acc)
+    x = tl.load(
+        h_ptr + rows64[:, None] * K + n[None, :], mask=rmask[:, None], other=0.0
+    ).to(tl.float32)
+    sc = tl.load(
+        s_ptr + rows64[:, None] * HC + branch[None, :], mask=rmask[:, None], other=0.0
+    )
+    gw = 1.0 + tl.load(nw_ptr + n).to(tl.float32)
+    v = _sigmoid(acc) * x * sc * gw[None, :]
+    out = tl.sum(tl.reshape(v, [BM, HC, BJ]), axis=1) / HC
+    j = pid_j * BJ + tl.arange(0, BJ)
+    tl.store(
+        o_ptr + rows64[:, None] * HS + j[None, :],
+        out.to(tl.bfloat16),
+        mask=rmask[:, None],
+    )
+
+
+@triton.jit(do_not_specialize=["M"])
+def _hcp_combine_kernel(
+    r_ptr,
+    y_ptr,
+    g_ptr,
+    o_ptr,
+    ss_ptr,
+    M,
+    HS: tl.constexpr,
+    HC: tl.constexpr,
+    BM: tl.constexpr,
+    BJ: tl.constexpr,
+):
+    """o[m, b*HS + j] = r[m, b*HS + j] + 2 sigmoid(g[m, b] / HC) * y[m, j], and the
+    partial sums of squares ss[M, HC, HS // BJ] of the BF16 o.
+    Grid (cdiv(M, BM), HS // BJ); each CTA reads its y tile once for all branches."""
+    K: tl.constexpr = HC * HS
+    NSS: tl.constexpr = HS // BJ
+    rows = tl.program_id(0) * BM + tl.arange(0, BM)
+    rmask = rows < M
+    rows64 = rows.to(tl.int64)
+    pj = tl.program_id(1)
+    j = pj * BJ + tl.arange(0, BJ)
+    y = tl.load(
+        y_ptr + rows64[:, None] * HS + j[None, :], mask=rmask[:, None], other=0.0
+    ).to(tl.float32)
+    for b in tl.static_range(HC):
+        gl = tl.load(g_ptr + rows64 * HC + b, mask=rmask, other=0.0)
+        a = 2.0 * _sigmoid(gl / HC)
+        off = rows64[:, None] * K + b * HS + j[None, :]
+        r = tl.load(r_ptr + off, mask=rmask[:, None], other=0.0).to(tl.float32)
+        o = (r + a[:, None] * y).to(tl.bfloat16)
+        tl.store(o_ptr + off, o, mask=rmask[:, None])
+        of = o.to(tl.float32)
+        tl.store(
+            ss_ptr + (rows64 * HC + b) * NSS + pj, tl.sum(of * of, axis=1), mask=rmask
+        )
+
+
+# Launch configs from per-kernel sweeps on MI355X (gfx950), Qwen3.8 shapes
+# (HC 4, HS 2560, R 320).
+def _up_cfg(m):
+    if m <= 1024:
+        return dict(BM=64, BJ=32, BR=64, num_warps=4, num_stages=3)
+    return dict(BM=128, BJ=32, BR=64, num_warps=8, num_stages=2)
+
+
+_MFMA = dict(matrix_instr_nonkdim=16)
+_FINISH = dict(BM=32, BC=64, num_warps=4)
+_SUMSQ = dict(BM=4, BK=512, num_warps=4)
+_COMBINE = dict(BM=4, BJ=512, num_warps=8)
+
+
+class HcpWeights:
+    """One HC site's down and inject weights with the Gemma norm's (1 + w) folded in:
+    dn [NP, HC*HS] BF16, NP = R + NI rounded up to 16 rows.
+
+    Build after weight loading."""
+
+    def __init__(self, down, inject, norm_weight):
+        k = down.shape[1]
+        w1 = 1.0 + norm_weight.float()
+        rows = [down.float() * w1]
+        self.ni = 0
+        if inject is not None:
+            self.ni = inject.shape[0]
+            rows.append(inject.float() * w1)
+        d = torch.cat(rows)
+        pad = -d.shape[0] % 16
+        if pad:
+            d = torch.cat([d, d.new_zeros(pad, k)])
+        self.r = down.shape[0]
+        self.np = d.shape[0]
+        self.dn = d.to(torch.bfloat16)
+
+
+def hcp_supported(h, down, up, norm_weight, inject, hc):
+    """Whether hcp_mix and hcp_combine accept this site and residual."""
+    r, k = down.shape
+    if hc <= 0 or hc & (hc - 1) or k % hc:
+        return False
+    return (
+        h.dtype == torch.bfloat16
+        and h.is_cuda
+        and h.dim() == 2
+        and h.is_contiguous()
+        and h.shape[1] == k
+        and down.dtype == up.dtype == norm_weight.dtype == torch.bfloat16
+        and up.is_contiguous()
+        and norm_weight.is_contiguous()
+        and up.shape == (k, r)
+        and norm_weight.shape == (k,)
+        and r % 64 == 0
+        and (k // hc) % _COMBINE["BJ"] == 0
+        and (k // hc) % _SUMSQ["BK"] == 0
+        and (
+            inject is None
+            or (inject.dtype == torch.bfloat16 and inject.shape == (hc, k))
+        )
+    )
+
+
+def hcp_mix(h, weights: HcpWeights, up, norm_weight, eps, hc=4, sumsq=None):
+    """One HC site's mix on residual h [M, HC*HS] BF16.
+
+    Returns (mixed [M, HS] BF16, inject logits [M, NI] FP32 or None). ``sumsq`` is the
+    [M, HC, n] FP32 partial sums of squares ``hcp_combine`` returned with h; None
+    computes them from h.
+    """
+    m, k = h.shape
+    hs = k // hc
+    r, ni, np_ = weights.r, weights.ni, weights.np
+    dev = h.device
+    if sumsq is None:
+        sumsq = torch.empty((m, hc, 1), device=dev, dtype=torch.float32)
+        c = dict(_SUMSQ)
+        bm = c.pop("BM")
+        _hcp_sumsq_kernel[(triton.cdiv(m, bm), hc)](
+            h, sumsq, m, HS=hs, HC=hc, BM=bm, **c
+        )
+    # Branch-batched over strided views of h and the weights; no copies.
+    p = torch.bmm(
+        h.view(m, hc, hs).transpose(0, 1), weights.dn.view(np_, hc, hs).permute(1, 2, 0)
+    )
+    t = torch.empty((m, r), device=dev, dtype=torch.bfloat16)
+    g = torch.empty((m, max(ni, 1)), device=dev, dtype=torch.float32)
+    s = torch.empty((m, hc), device=dev, dtype=torch.float32)
+    c = dict(_FINISH)
+    bm, bc = c.pop("BM"), c.pop("BC")
+    _hcp_finish_kernel[(triton.cdiv(m, bm), triton.cdiv(r + ni, bc))](
+        p, sumsq, t, g, s, m, float(eps),
+        HS=hs, HC=hc, R=r, NI=ni, NP=np_, NSS=sumsq.shape[2], BM=bm, BC=bc, **c,
+    )  # fmt: skip
+    out = torch.empty((m, hs), device=dev, dtype=torch.bfloat16)
+    c = _up_cfg(m)
+    _hcp_up_kernel[(triton.cdiv(m, c["BM"]), hs // c["BJ"])](
+        t, up, h, s, norm_weight, out, m, HS=hs, HC=hc, R=r, **c, **_MFMA
+    )
+    return out, (g if ni else None)
+
+
+def hcp_combine(h, y, g, hc=4):
+    """h [M, HC*HS] + y [M, HS] * 2 sigmoid(g [M, HC] / HC) per branch.
+
+    Returns (combined [M, HC*HS] BF16, its partial sums of squares [M, HC, HS // 512]
+    FP32 for the next ``hcp_mix``)."""
+    m, k = h.shape
+    hs = k // hc
+    if (
+        y.shape != (m, hs)
+        or y.dtype != h.dtype
+        or g.shape != (m, hc)
+        or g.dtype != torch.float32
+    ):
+        raise ValueError("unsupported HC prefill combine operands")
+    c = dict(_COMBINE)
+    bm, bj = c.pop("BM"), c.pop("BJ")
+    out = torch.empty_like(h)
+    ss = torch.empty((m, hc, hs // bj), device=h.device, dtype=torch.float32)
+    _hcp_combine_kernel[(triton.cdiv(m, bm), hs // bj)](
+        h, y.contiguous(), g, out, ss, m, HS=hs, HC=hc, BM=bm, BJ=bj, **c
+    )
+    return out, ss
