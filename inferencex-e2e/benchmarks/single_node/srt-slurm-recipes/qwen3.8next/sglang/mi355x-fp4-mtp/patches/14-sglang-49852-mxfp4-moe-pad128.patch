 from __future__ import annotations
 
+import functools
 import logging
+import os
 import threading
 from typing import TYPE_CHECKING, Any
 
@@ -144,6 +146,81 @@ def _swizzle_mxfp4(quant_tensor, scale, num_warps):
     return quant_tensor, InFlexData(), scale
 
 
+# Port of sglang#49852 (commit 1 of 2; commit 2 guards the
+# smallm_moe_gfx950 kernel, which serves hidden 4096 only, not Qwen3.8's 2560)
+# behind the default-off gate SGLANG_AMD_MXFP4_PAD128=1. AITER's FlyDSL W4A4 MoE
+# tiles an intermediate width that is not a multiple of 256 columns by 128, so it
+# needs 128 columns (64 packed bytes) of alignment where AITER's generic one is 256
+# (vllm#55104 pads the same way). With the gate unset nothing below is evaluated.
+FLYDSL_MXFP4_PADDING_SIZE = 64
+_AMD_PAD128_LOGGED = False
+
+
+def _amd_pad128_enabled() -> bool:
+    return os.environ.get("SGLANG_AMD_MXFP4_PAD128", "0") == "1"
+
+
+@functools.cache
+def _aiter_refuses_unaligned_cktile_mxfp4() -> bool:
+    """Whether aiter refuses its CK-Tile MXFP4 stage 2 at an intermediate width
+    that is not a multiple of 256 (ROCm/aiter#5232)."""
+    import inspect
+
+    try:
+        import aiter.fused_moe
+
+        source = inspect.getsource(aiter.fused_moe)
+    except (ImportError, OSError, TypeError):
+        return False
+    return "requires inter_dim to be a multiple of 256" in source
+
+
+@functools.cache
+def _aiter_has_flydsl() -> bool:
+    import importlib.util
+
+    return importlib.util.find_spec("flydsl") is not None
+
+
+def _pads_for_flydsl_mxfp4(layer: torch.nn.Module) -> bool:
+    """Whether AITER runs this layer's MoE on its FlyDSL W4A4 kernels (plain Silu,
+    no SwiGLU clamp, AITER_FLYDSL_FORCE "1", no AMD monokernel)."""
+    from sglang.srt.runtime_context import get_exec
+
+    cfg = layer.moe_runner_config
+    return (
+        _is_gfx95
+        and cfg.activation == "silu"
+        and not cfg.swiglu_limit
+        and cfg.gemm1_clamp_limit is None
+        and os.environ.get("AITER_FLYDSL_FORCE", "1") == "1"
+        and not get_exec().kernel.enable_amd_monokernel
+        and _aiter_has_flydsl()
+        and _aiter_refuses_unaligned_cktile_mxfp4()
+    )
+
+
+def _amd_pad128_size(layer, pad_for_aiter: bool, serialized: bool):
+    """FLYDSL_MXFP4_PADDING_SIZE when the gate is set and the layer qualifies, else
+    None (get_moe_weight_sizes' stock AITER_PADDING_SIZE)."""
+    global _AMD_PAD128_LOGGED
+    if not (
+        _amd_pad128_enabled()
+        and pad_for_aiter
+        and serialized
+        and _pads_for_flydsl_mxfp4(layer)
+    ):
+        return None
+    if not _AMD_PAD128_LOGGED:
+        _AMD_PAD128_LOGGED = True
+        logger.warning(
+            "AMD_ACTIVE s2_mxfp4_pad128: MXFP4 MoE intermediate aligned to %d "
+            "packed bytes (128 columns)",
+            FLYDSL_MXFP4_PADDING_SIZE,
+        )
+    return FLYDSL_MXFP4_PADDING_SIZE
+
+
 class QuarkW4A4MXFp4MoE(QuarkMoEScheme):
     def __init__(
         self,
@@ -286,6 +363,9 @@ class QuarkW4A4MXFp4MoE(QuarkMoEScheme):
             is_aiter_moe=pad_for_aiter,
             is_concat=True,
             is_packed=True,
+            aiter_padding_size=_amd_pad128_size(
+                layer, pad_for_aiter, self.is_checkpoint_mxfp4_serialized
+            ),
         )
         layer.hidden_pad = 0
         layer.intermediate_pad = w13_up_dim // 2 - intermediate_size_per_partition
