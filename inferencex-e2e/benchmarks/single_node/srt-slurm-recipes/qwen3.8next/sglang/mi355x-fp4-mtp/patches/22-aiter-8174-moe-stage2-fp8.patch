+def _stage2_fp8_kernel_name(kernel_name2):
+    """The stage 2 that ``fused_moe(stage2_fp8=True)`` runs after an MXMOE stage 1,
+    or None when the flag leaves this stage 2 as it is.
+
+    A ``reduce`` kernel keeps its name. A ``scatter`` kernel with MXFP4
+    activations and bf16 output becomes the plain ``reduce`` kernel of the same
+    tile and sort block, as the FP8 route output is a ``reduce`` epilogue.
+    """
+    cfg = parse_flydsl_v2_gemm2_kernel(kernel_name2)
+    if cfg is None:
+        return None
+    if cfg["epilog"] == "reduce":
+        return kernel_name2
+    if cfg["epilog"] != "scatter" or (cfg["a_dtype"], cfg["out_dtype"]) != (
+        "fp4",
+        "bf16",
+    ):
+        return None
+    return _get_flydsl_moe_kernels().build_flydslv2_gemm2_name(
+        cfg["a_dtype"],
+        cfg["b_dtype"],
+        cfg["out_dtype"],
+        tm=cfg["tile_m"],
+        tn=cfg["tile_n"],
+        tk=cfg["tile_k"],
+        epilog="reduce",
+        persist=False,
+        use_nt=False,
+        sbm=cfg["sort_block_m"],
+    )
