# [AMD] GDN chunked prefill as parallel prep kernels plus a serial state kernel, SGLANG_AMD_GDN_PREFILL
# Upstream: ROCm/aiter#8329 (draft, head ea2c480b73) ports these kernels into AITER's gdn_fused_prefill behind
# AITER_GDN_SPLIT_PREFILL. This file is the SGLang-side form the validation windows ran: the kernels under
# sglang/kernels/ops/attention/linear and the route in gdn_aiter_prefill.py.
# Generated against the 20261117 image's SGLang checkout (c67db7c762) with patches 01-07, 09, 11, 13-16, 21, 24, 23,
# 26 and 27 applied; source files only (its test dropped).
# SGLANG_AMD_GDN_PREFILL=1 (with SGLANG_AITER_GDN_PREFILL_H=fused): the fused FlyDSL chunked prefill of a batch of
# 1,024 tokens or more runs as prep kernels in parallel over the chunks, then a serial kernel that carries the state;
# outputs and tracked states are bit for bit the fused kernel's. Unset or 0 keeps the fused kernel.
# Apply in /sgl-workspace/sglang with git apply.

diff --git a/python/sglang/kernels/ops/attention/linear/gdn_split_prefill.py b/python/sglang/kernels/ops/attention/linear/gdn_split_prefill.py
new file mode 100644
index 0000000..135540c
--- /dev/null
+++ b/python/sglang/kernels/ops/attention/linear/gdn_split_prefill.py
@@ -0,0 +1,198 @@
+# SPDX-License-Identifier: Apache-2.0
+"""GDN chunked prefill on gfx950 as a parallel prep kernel plus a serial state
+kernel (``gdn_split_prefill_kernels``).
+
+Same contract and operands as AITER's ``gdn_fused_prefill_fwd``, whose results
+(o, the pool state, the track snapshot) it reproduces bit for bit: the prep
+kernel runs the fused kernel's state-independent work for every chunk at once,
+and the serial kernel keeps only the state chain. ``AiterGDNPrefill`` uses it
+with ``SGLANG_AMD_GDN_PREFILL=1``.
+
+The hand-off costs 16 KiB of bf16 fragments plus 1.25 KiB of fp32 factors per
+(64-token chunk, value head), allocated per call: 218 MB at 16,384 tokens and
+48 heads.
+"""
+
+from __future__ import annotations
+
+import torch
+from aiter.ops.flydsl.gdn_fused_prefill import (
+    _KD,
+    _VD,
+    _flat,
+    _pick_bv,
+    gdn_fused_prefill_supported,
+)
+from aiter.ops.flydsl.kernels.tensor_shim import _run_compiled
+
+from sglang.kernels.ops.attention.linear.gdn_split_prefill_kernels import (
+    FAC_HEAD,
+    NUM_XCD,
+    PK_HEAD,
+    compile_gdn_split_prep,
+    compile_gdn_split_serial,
+)
+
+_BT = 64
+# The hand-off is addressed through 32-bit buffer byte offsets.
+_HANDOFF_MAX_BYTES = 2**32
+
+
+def _num_slots(T: int, N: int) -> int:
+    """Prep slots s = bos // 64 + chunk + seq span [0, (T - 1) // 64 + N); one
+    more is the dummy slot idle prep workgroups write."""
+    return (T - 1) // _BT + N + 1
+
+
+def gdn_split_prefill_supported(q, k, v, g, beta, ssm_states, n_seqs: int) -> bool:
+    """The fused kernel's operand rules, plus the hand-off within 32-bit offsets."""
+    if n_seqs < 1 or not gdn_fused_prefill_supported(q, k, v, g, beta, ssm_states):
+        return False
+    handoff_bytes = _num_slots(q.shape[1], n_seqs) * v.shape[2] * PK_HEAD * 2
+    return handoff_bytes < _HANDOFF_MAX_BYTES
+
+
+def gdn_split_prefill_fwd(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    g: torch.Tensor,
+    beta: torch.Tensor,
+    *,
+    ssm_states: torch.Tensor,
+    cache_indices: torch.Tensor,
+    cu_seqlens: torch.Tensor,
+    track_state: torch.Tensor | None = None,
+    track_chunk_idx: torch.Tensor | None = None,
+    has_initial_state: torch.Tensor | None = None,
+    scale: float | None = None,
+    stream=None,
+) -> torch.Tensor:
+    """See ``aiter.ops.flydsl.gdn_fused_prefill.gdn_fused_prefill_fwd``."""
+    N = cu_seqlens.numel() - 1
+    if not gdn_split_prefill_supported(q, k, v, g, beta, ssm_states, N):
+        raise ValueError(
+            "gdn_split_prefill_fwd: unsupported operands "
+            f"q={tuple(q.shape)} {q.dtype}, v={tuple(v.shape)} {v.dtype}, "
+            f"g={g.dtype}, beta={beta.dtype}, ssm_states={tuple(ssm_states.shape)} "
+            f"{ssm_states.dtype}, {N} sequences; gate on gdn_split_prefill_supported."
+        )
+    T, Hg = q.shape[1], q.shape[2]
+    H = v.shape[2]
+    if cache_indices.numel() < N:
+        raise ValueError(
+            f"cache_indices has {cache_indices.numel()} entries for {N} sequences"
+        )
+    for name, tensor in (
+        ("cu_seqlens", cu_seqlens),
+        ("cache_indices", cache_indices),
+        ("track_state", track_state),
+        ("track_chunk_idx", track_chunk_idx if track_state is not None else None),
+        ("has_initial_state", has_initial_state),
+    ):
+        if tensor is not None and tensor.device != q.device:
+            raise ValueError(f"{name} must be on {q.device}, got {tensor.device}")
+    cu = cu_seqlens.to(torch.int32).contiguous()
+    idx = cache_indices[:N].to(torch.int32).contiguous()
+
+    has_track = track_state is not None
+    if has_track:
+        if track_chunk_idx is None:
+            raise ValueError("track_state needs track_chunk_idx")
+        if (
+            track_state.dtype is not torch.float32
+            or not track_state.is_contiguous()
+            or track_state.shape[0] < N
+            or tuple(track_state.shape[1:]) != (H, _VD, _KD)
+        ):
+            raise ValueError(
+                "track_state must be contiguous fp32 [>= N, H, 128, 128], got "
+                f"{tuple(track_state.shape)} {track_state.dtype}"
+            )
+        if track_chunk_idx.dim() != 1 or track_chunk_idx.numel() < N:
+            raise ValueError(f"track_chunk_idx must be 1-D with at least {N} entries")
+        trs = track_state.view(-1)
+        tri = track_chunk_idx[:N].to(torch.int32).contiguous()
+    else:
+        # Not dereferenced when HAS_TRACK is off.
+        trs = ssm_states.view(-1)
+        tri = idx
+
+    has_init_flag = has_initial_state is not None
+    if has_init_flag:
+        if has_initial_state.dim() != 1 or has_initial_state.numel() < N:
+            raise ValueError(f"has_initial_state must be 1-D with at least {N} entries")
+        init = has_initial_state[:N].to(torch.int32).contiguous()
+    else:
+        # Not dereferenced when HAS_INIT_FLAG is off.
+        init = idx
+
+    o = q.new_empty(1, T, H, _VD)
+    if stream is None:
+        stream = torch.cuda.current_stream()
+    scale = _KD**-0.5 if scale is None else float(scale)
+
+    slots = _num_slots(T, N)
+    pk = torch.empty(slots * H * PK_HEAD, dtype=torch.bfloat16, device=q.device)
+    fac = torch.empty(slots * H * FAC_HEAD, dtype=torch.float32, device=q.device)
+    qf, kf = _flat(q, _KD), _flat(k, _KD)
+
+    prep = compile_gdn_split_prep(
+        H=H,
+        Hg=Hg,
+        LOGN=(N - 1).bit_length(),
+        scale=scale,
+        XCD=(slots - 1) * Hg % NUM_XCD == 0,
+    )
+    _run_compiled(
+        prep,
+        qf,
+        kf,
+        _flat(g, 1),
+        _flat(beta, 1),
+        cu,
+        idx,
+        pk,
+        fac,
+        q.stride(1),
+        k.stride(1),
+        g.stride(1),
+        beta.stride(1),
+        N,
+        T,
+        slots - 1,
+        stream,
+    )
+    serial = compile_gdn_split_serial(
+        H=H,
+        Hg=Hg,
+        BV=_pick_bv(N, H, q.device),
+        HAS_TRACK=has_track,
+        HAS_INIT_FLAG=has_init_flag,
+        XCD=N * Hg % NUM_XCD == 0,
+    )
+    _run_compiled(
+        serial,
+        qf,
+        kf,
+        _flat(v, _VD),
+        cu,
+        idx,
+        ssm_states.view(-1),
+        o.view(-1),
+        trs,
+        tri,
+        init,
+        pk,
+        fac,
+        q.stride(1),
+        k.stride(1),
+        v.stride(1),
+        T,
+        N * H,
+        stream,
+    )
+    return o
+
+
+__all__ = ["gdn_split_prefill_fwd", "gdn_split_prefill_supported"]
