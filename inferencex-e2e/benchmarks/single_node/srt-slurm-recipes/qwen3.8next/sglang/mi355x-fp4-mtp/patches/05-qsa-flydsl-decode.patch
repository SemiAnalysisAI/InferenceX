+
+from .qsa_sparse_decode import (
+    can_use_flydsl_qsa_sparse_decode,
+    flydsl_qsa_sparse_decode,
+    recommended_num_splits,
+    workspace_partials,
+)
+
+__all__ = [
+    "can_use_flydsl_qsa_sparse_decode",
+    "flydsl_qsa_sparse_decode",
+    "recommended_num_splits",
