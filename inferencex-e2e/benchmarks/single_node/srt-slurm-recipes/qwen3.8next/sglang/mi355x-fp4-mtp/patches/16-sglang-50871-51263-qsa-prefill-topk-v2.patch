+@functools.lru_cache(maxsize=None)
+def amd_prefill_topk_v2_enabled() -> bool:
+    """SGLANG_AMD_QSA_PREFILL_TOPK_V2: 0 (default) or 1, read once per process (the QSA
+    indexer's construction reads it first, so another value fails at startup).
+
+    1 serves the QSA indexer's request-relative prefill selection as
+    sgl-project/sglang#50871 does on gfx95 (topk_v2 on unscaled scores) and scores those
+    rows with one pipeline stage (_prefill_relative_num_stages); 0 keeps today's path."""
+    value = os.environ.get("SGLANG_AMD_QSA_PREFILL_TOPK_V2", "0")
+    if value not in ("0", "1"):
+        raise ValueError(
+            f"SGLANG_AMD_QSA_PREFILL_TOPK_V2 must be 0 or 1, got {value!r}"
+        )
+    return value == "1"
+
+
+def _prefill_relative_num_stages() -> int:
+    """K-tile pipeline stages of the relative prefill kernel. On gfx95 one stage keeps a
+    CTA's shared memory at 48 KB (bf16) instead of 80 KB, so three CTAs fit a CU's
+    160 KB instead of two; the scores are the same. AMD: one stage only with
+    SGLANG_AMD_QSA_PREFILL_TOPK_V2=1."""
+    return 1 if amd_prefill_topk_v2_enabled() and is_gfx95_supported() else 3
+
