From 0d43c1e0259e93602f937ceeb1aae3023e410b95 Mon Sep 17 00:00:00 2001
From: Christian Gilli <272772515+amd-cgilli@users.noreply.github.com>
Date: Tue, 3 Nov 2026 16:52:59 +0000
Subject: [PATCH] [Perf] [AMD] QSA: pad decode index Q to the ROCm MFMA width
 and use 256 threads

On ROCm the tilelang decode MQA kernel needs query heads in multiples of 16,
but the indexer's fused Q prep padded to 8, so every decode/verify call paid
a torch.cat 8->16 in the wrapper. Pad to the kernel's alignment in the prep
instead, and launch the decode kernel with 256 threads on ROCm.

MI355X, 4 index heads, d128 bf16, compressed page 16, graph table 4096,
cold L2: rows 96 ctx16k 56.6 -> 34.0 us, rows 320 ctx16k 132.4 -> 83.8 us,
rows 320 ctx80k 558.3 -> 358.2 us. Logits bit-exact (also fp8 indexer).
---
 python/sglang/srt/layers/attention/qsa/mqa.py         | 11 ++++++++---
 python/sglang/srt/layers/attention/qsa/qsa_indexer.py |  6 ++++--
 2 files changed, 12 insertions(+), 5 deletions(-)

diff --git a/python/sglang/srt/layers/attention/qsa/mqa.py b/python/sglang/srt/layers/attention/qsa/mqa.py
index 101f9ba37f..4b25048d9c 100644
--- a/python/sglang/srt/layers/attention/qsa/mqa.py
+++ b/python/sglang/srt/layers/attention/qsa/mqa.py
@@ -539,6 +539,11 @@ def tilelang_qsa_mqa_prefill_relative(
 # CTAs per decode row: few enough levels to bound the TileLang specializations, and
 # a grid of about four waves (at least one CTA per row).
 _DECODE_CTAS_PER_ROW_LEVELS = (1, 16, 256)
+# CUDA MMA accepts an eight-wide N dimension, while ROCm MFMA requires sixteen;
+# the indexer pads Q to this in its fused prep so the wrapper need not copy it.
+QSA_DECODE_HEAD_ALIGNMENT = 16 if is_hip() else 8
+# Four wavefronts per CTA on ROCm: about 1.5x faster than 128 threads on MI355X.
+_DECODE_THREADS = 256 if is_hip() else 128
 
 
 @functools.lru_cache(maxsize=None)
@@ -593,10 +598,9 @@ def tilelang_qsa_mqa_decode(
         )
     if not q.shape[0] or not max_model_len:
         return logits
-    # CUDA MMA accepts an eight-wide N dimension, while ROCm MFMA requires
-    # sixteen. Zero-padding preserves the weight-free head sum on both paths.
+    # Zero-padding preserves the weight-free head sum.
     query_heads, head_dim = q.shape[1:]
-    head_alignment = 16 if is_hip() else 8
+    head_alignment = QSA_DECODE_HEAD_ALIGNMENT
     kernel_heads = max(
         head_alignment,
         ((query_heads + head_alignment - 1) // head_alignment) * head_alignment,
@@ -617,6 +621,7 @@ def tilelang_qsa_mqa_decode(
         page_size=page_size,
         ctas_per_row=_decode_ctas_per_row(q.shape[0], q.device),
         min_scored_len=min_scored_len,
+        threads=_DECODE_THREADS,
         dtype=_TILELANG_DTYPES[scoring_dtype],
     )(
         q_kernel.unsqueeze(1).contiguous(),
diff --git a/python/sglang/srt/layers/attention/qsa/qsa_indexer.py b/python/sglang/srt/layers/attention/qsa/qsa_indexer.py
index a550ff7d70..4638230313 100644
--- a/python/sglang/srt/layers/attention/qsa/qsa_indexer.py
+++ b/python/sglang/srt/layers/attention/qsa/qsa_indexer.py
@@ -19,6 +19,7 @@ from sglang.srt.layers.attention.qsa.metadata import (
 )
 from sglang.srt.layers.attention.qsa.mqa import (
     HAS_TILELANG,
+    QSA_DECODE_HEAD_ALIGNMENT,
     qsa_mqa_decode,
     qsa_mqa_prefill,
     qsa_mqa_prefill_relative,
@@ -758,8 +759,9 @@ class QSAIndexer(MultiPlatformOp):
             pool=indexer_metadata.token_to_kv_pool,
             cache_loc=state_slots,
             q_heads_padded=(
-                # The tilelang decode MQA kernel needs query heads in multiples of 8.
-                ((self.index_n_heads + 7) // 8) * 8
+                # Pad to the tilelang decode MQA kernel's head alignment.
+                -(-self.index_n_heads // QSA_DECODE_HEAD_ALIGNMENT)
+                * QSA_DECODE_HEAD_ALIGNMENT
                 if (forward_mode.is_decode() or is_target_verify or is_draft_extend)
                 else None
             ),
-- 
