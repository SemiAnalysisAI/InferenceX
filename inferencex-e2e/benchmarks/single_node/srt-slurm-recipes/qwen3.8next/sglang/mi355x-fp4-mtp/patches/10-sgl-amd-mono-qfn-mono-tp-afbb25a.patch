+    assert all(0 <= (tail + t) % BLOCKS < ch0 for t in range(T)), (R, L, tp)
+    return QsaHoist(ch0=ch0, pidx=pidx, sbase=sbase, k0=g.QP_K_OFF // 16, nti=nti, tail=tail)
+
+
+def _check_qsa_hoist():
+    for tp in TP_SIZES:
+        g = geom(tp)
+        for R in range(1, 9):
+            for L in range(1, 32 // R + 1):
+                h = qsa_hoist(R, L, tp)
+                if h is None:
+                    continue
