+def sfresh64(v):
+    """Pass a wave-uniform i64 through an opaque scalar move: LLVM cannot merge it with another use or hoist it."""
+    return fx.Int64(
+        llvm.inline_asm(
+            T.i64,
+            [fx.Int64(v).ir_value()],
+            "s_mov_b64 $0, $1",
+            "=s,s",
+            has_side_effects=True,
+        )
+    )
