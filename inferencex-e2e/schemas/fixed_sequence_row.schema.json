      "properties": {
        "result_schema_version": {
          "const": 1,
          "maximum": 1,
          "minimum": 1,
          "title": "Result Schema Version",
          "type": "integer"
        },
        "hw": {
          "minLength": 1,
          "title": "Hw",
          "type": "string"
        },
        "conc": {
          "exclusiveMinimum": 0,
          "title": "Conc",
          "type": "integer"
        },
        "image": {
          "minLength": 1,
          "title": "Image",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "infmax_model_prefix": {
          "minLength": 1,
          "title": "Infmax Model Prefix",
          "type": "string"
        },
        "framework": {
          "minLength": 1,
          "title": "Framework",
          "type": "string"
        },
        "precision": {
          "minLength": 1,
          "title": "Precision",
          "type": "string"
        },
        "spec_decoding": {
          "minLength": 1,
          "title": "Spec Decoding",
          "type": "string"
        },
        "disagg": {
          "title": "Disagg",
          "type": "boolean"
        },
        "recipe_fingerprint": {
          "description": "Empty when the dispatched config has none.",
          "pattern": "^(?:[0-9a-f]{64})?$",
          "title": "Recipe Fingerprint",
          "type": "string"
        },
        "isl": {
          "exclusiveMinimum": 0,
          "title": "Isl",
          "type": "integer"
