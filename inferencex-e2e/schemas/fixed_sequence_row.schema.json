        "kv_p2p_transfer": {
          "default": null,
          "minLength": 1,
          "title": "Kv P2P Transfer",
          "type": "string"
        },
        "tput_per_gpu": {
          "title": "Tput Per Gpu",
          "type": "number"
        },
        "output_tput_per_gpu": {
          "title": "Output Tput Per Gpu",
          "type": "number"
        },
        "input_tput_per_gpu": {
          "title": "Input Tput Per Gpu",
          "type": "number"
        },
        "power_metric_schema_version": {
          "const": 2,
          "default": null,
          "maximum": 2,
          "minimum": 2,
          "title": "Power Metric Schema Version",
          "type": "integer"
        },
        "power_valid": {
          "default": null,
          "maximum": 1,
          "minimum": 0,
          "title": "Power Valid",
          "type": "integer"
        },
        "power_invalid_reasons": {
          "default": null,
          "items": {
            "type": "string"
          },
          "title": "Power Invalid Reasons",
          "type": "array"
        },
        "power_audit": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "default": null,
          "title": "Power Audit",
          "type": "object"
        },
        "is_multinode": {
          "const": false,
          "title": "Is Multinode",
          "type": "boolean"
        },
        "tp": {
          "exclusiveMinimum": 0,
          "title": "Tp",
          "type": "integer"
        },
        "pp": {
          "exclusiveMinimum": 0,
          "title": "Pp",
          "type": "integer"
        },
        "dcp_size": {
          "exclusiveMinimum": 0,
          "title": "Dcp Size",
          "type": "integer"
        },
        "pcp_size": {
          "exclusiveMinimum": 0,
          "title": "Pcp Size",
          "type": "integer"
        },
        "ep": {
          "exclusiveMinimum": 0,
          "title": "Ep",
          "type": "integer"
        },
        "dp_attention": {
          "description": "Workflow flag copied as a string, not a JSON boolean.",
