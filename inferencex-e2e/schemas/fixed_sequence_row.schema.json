          ],
          "title": "Dp Attention",
          "type": "string"
        }
      },
      "required": [
        "result_schema_version",
        "hw",
        "conc",
        "image",
        "model",
        "infmax_model_prefix",
        "framework",
        "precision",
        "spec_decoding",
        "disagg",
        "recipe_fingerprint",
        "isl",
        "osl",
        "tput_per_gpu",
        "output_tput_per_gpu",
