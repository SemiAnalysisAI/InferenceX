        "^(?:avg_power_w|p75_power_w|p75_total_gpu_power_w|p90_power_w|p90_total_gpu_power_w|avg_total_gpu_power_w|total_gpu_energy_j|joules_per_successful_query|joules_per_input_token|joules_per_output_token|joules_per_total_token|prefill_gpu_energy_j|decode_gpu_energy_j|prefill_avg_power_w|decode_avg_power_w|prefill_joules_per_input_token|decode_joules_per_output_token)$": {
          "type": "number"
        }
      },
      "properties": {
        "result_schema_version": {
          "const": 1,
          "maximum": 1,
          "minimum": 1,
          "title": "Result Schema Version",
          "type": "integer"
        },
        "hw": {
          "minLength": 1,
          "title": "Hw",
          "type": "string"
        },
        "conc": {
          "exclusiveMinimum": 0,
          "title": "Conc",
          "type": "integer"
        },
        "image": {
          "minLength": 1,
          "title": "Image",
          "type": "string"
        },
        "recipe_fingerprint": {
          "description": "Empty when the dispatched config has none.",
          "pattern": "^(?:[0-9a-f]{64})?$",
          "title": "Recipe Fingerprint",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "infmax_model_prefix": {
          "minLength": 1,
          "title": "Infmax Model Prefix",
          "type": "string"
        },
        "framework": {
          "minLength": 1,
          "title": "Framework",
          "type": "string"
        },
        "precision": {
          "minLength": 1,
          "title": "Precision",
          "type": "string"
        },
        "spec_decoding": {
          "minLength": 1,
          "title": "Spec Decoding",
          "type": "string"
        },
        "disagg": {
          "title": "Disagg",
          "type": "boolean"
        },
        "scenario_type": {
          "const": "agentic-coding",
          "title": "Scenario Type",
          "type": "string"
        },
        "num_gpus": {
          "exclusiveMinimum": 0,
          "title": "Num Gpus",
          "type": "integer"
        },
        "tp": {
          "exclusiveMinimum": 0,
          "title": "Tp",
          "type": "integer"
        },
        "ep": {
          "exclusiveMinimum": 0,
          "title": "Ep",
          "type": "integer"
        },
        "dp_attention": {
          "description": "Workflow flag copied as a string, not a JSON boolean.",
          "enum": [
            "true",
            "false"
          ],
          "title": "Dp Attention",
          "type": "string"
        },
        "kv_offloading": {
          "minLength": 1,
          "title": "Kv Offloading",
          "type": "string"
        },
        "kv_offload_backend": {
          "anyOf": [
            {
              "$ref": "#/$defs/OffloadBackend"
            },
            {
              "type": "null"
            }
          ]
        },
        "allocated_cpu_dram_gb": {
          "minimum": 0,
          "title": "Allocated Cpu Dram Gb",
          "type": "integer"
        },
        "num_requests_total": {
          "minimum": 0,
          "title": "Num Requests Total",
          "type": "integer"
        },
        "num_requests_successful": {
          "minimum": 0,
          "title": "Num Requests Successful",
          "type": "integer"
        },
        "request_accounting": {
          "$ref": "#/$defs/RequestAccounting"
        },
        "router": {
          "$ref": "#/$defs/ComponentMetadata",
          "default": null
