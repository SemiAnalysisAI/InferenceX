        "decode_num_workers": {
          "minimum": 0,
          "title": "Decode Num Workers",
          "type": "integer"
        },
        "decode_tp": {
          "minimum": 0,
          "title": "Decode Tp",
          "type": "integer"
        },
        "decode_pp": {
          "exclusiveMinimum": 0,
          "title": "Decode Pp",
          "type": "integer"
        },
        "decode_dcp_size": {
          "exclusiveMinimum": 0,
          "title": "Decode Dcp Size",
          "type": "integer"
